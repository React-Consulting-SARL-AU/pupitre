generator client {
  provider = "prisma-client"
  runtime  = "bun"
  output   = "../src/generated/prisma"
}

generator cloudflareClient {
  provider = "prisma-client"
  runtime  = "cloudflare"
  output   = "../src/generated/prisma-cloudflare"
}

datasource db {
  provider = "postgresql"
}

enum ServerStatus {
  enrolling
  active
  grace
  suspended
  revoked
}

enum ReleaseChannel {
  stable
  beta
}

enum DesktopOs {
  macos
  windows
  linux
}

enum BillingInterval {
  month
  year
}

enum AlertKind {
  server_unreachable
  disk_high
  agent_outdated
  entitlement_grace
}

// user…twoFactor come from `@better-auth/cli generate` (magicLink, organization, deviceAuthorization, bearer, admin, passkey, twoFactor): regenerate, do not hand-edit.

model User {
  id               String    @id
  name             String
  email            String
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  role             String?
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?  @default(false)
  locale           String    @default("fr")

  sessions        Session[]
  accounts        Account[]
  members         Member[]
  invitations     Invitation[]
  devices         Device[]
  assignedServers Server[]     @relation("ServerAssignedUser")
  events          Event[]      @relation("EventActor")
  passkeys        Passkey[]
  twoFactors      TwoFactor[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id        String   @id
  name      String
  slug      String
  logo      String?
  createdAt DateTime
  metadata  String?

  members       Member[]
  invitations   Invitation[]
  servers       Server[]
  subscriptions Subscription[]
  billing       OrganizationBilling?
  events        Event[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model DeviceCode {
  id              String    @id
  deviceCode      String
  userCode        String
  userId          String?
  expiresAt       DateTime
  status          String
  lastPolledAt    DateTime?
  pollingInterval Int?
  clientId        String?
  scope           String?

  @@index([deviceCode])
  @@index([userCode])
  @@map("deviceCode")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Device {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  publicKey   String
  fingerprint String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  enrolledServers   Server[]              @relation("ServerEnrollingDevice")
  serverRevocations ServerRevokedDevice[]

  @@index([userId])
}

model Server {
  id                     String                @id @default(cuid())
  organizationId         String
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  host                   String?
  port                   Int                   @default(22)
  sshUser                String                @default("dev")
  hostFingerprint        String?
  arch                   String
  agentVersion           String?
  targetVersion          String?
  serverTokenHash        String?               @unique
  enrollmentTokenHash    String?               @unique
  enrollmentKey          String?               @unique
  enrollmentExpiresAt    DateTime?
  entitlementValidUntil  DateTime?
  decommissionAt         DateTime?
  status                 ServerStatus          @default(enrolling)
  channel                ReleaseChannel        @default(stable)
  deviceId               String?
  device                 Device?               @relation("ServerEnrollingDevice", fields: [deviceId], references: [id], onDelete: SetNull)
  assignedUserId         String?
  assignedUser           User?                 @relation("ServerAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  pendingAssignmentEmail String?
  revokedDevices         ServerRevokedDevice[]
  alerts                 Alert[]
  lastHeartbeatAt        DateTime?
  metrics                Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([organizationId])
  @@index([assignedUserId])
  @@index([deviceId])
  @@index([status])
  @@index([decommissionAt])
  @@index([pendingAssignmentEmail])
}

model Alert {
  id          String    @id @default(cuid())
  serverId    String
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  kind        AlertKind
  firstSeenAt DateTime  @default(now())
  notifiedAt  DateTime?
  resolvedAt  DateTime?

  @@index([serverId, kind])
  @@index([resolvedAt])
}

model ServerRevokedDevice {
  serverId        String
  server          Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  deviceId        String
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  revokedByUserId String?
  revokedAt       DateTime @default(now())

  @@id([serverId, deviceId])
  @@index([deviceId])
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String       @unique
  product              String
  quantity             Int
  status               String
  currentPeriodEnd     DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId])
}

model OrganizationBilling {
  organizationId   String          @id
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeCustomerId String          @unique
  defaultInterval  BillingInterval @default(month)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Release {
  version     String
  arch        String
  sha256      String
  signature   String
  r2Key       String
  channel     ReleaseChannel @default(beta)
  publishedAt DateTime       @default(now())

  @@id([version, arch])
  @@index([channel, publishedAt])
}

model AppRelease {
  version     String
  os          DesktopOs
  arch        String
  format      String
  url         String
  bytes       Int
  sha256      String
  signature   String?
  notes       String
  channel     ReleaseChannel @default(beta)
  publishedAt DateTime       @default(now())

  @@id([version, os, arch])
  @@index([channel, publishedAt])
}

model Event {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actorUser      User?         @relation("EventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  targetType     String
  targetId       String
  payload        Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([targetType, targetId])
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
