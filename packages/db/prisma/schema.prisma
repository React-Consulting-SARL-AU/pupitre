generator client {
  provider = "prisma-client"
  runtime  = "bun"
  output   = "../src/generated/prisma"
}

generator cloudflareClient {
  provider = "prisma-client"
  runtime  = "cloudflare"
  output   = "../src/generated/prisma-cloudflare"
}

datasource db {
  provider = "sqlite"
}

enum ServerStatus {
  enrolling
  active
  grace
  suspended
  revoked
}

enum SuspensionReason {
  billing
  admin
}

enum ReleaseChannel {
  stable
  beta
}

enum DesktopOs {
  macos
  windows
  linux
}

enum BillingInterval {
  month
  year
}

enum AlertKind {
  server_unreachable
  disk_high
  agent_outdated
  license_grace
  backup_failed
  backup_stale
}

enum BackupTrigger {
  schedule
  manual
}

enum StripeEventStatus {
  processing
  processed
  failed
}

// User through TwoFactor are generated by `@better-auth/cli generate`: regenerate, do not hand-edit.

model User {
  id               String    @id
  name             String
  email            String
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  role             String?
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?  @default(false)
  locale           String    @default("fr")

  deactivatedAt       DateTime?
  deactivatedReason   String?
  deactivatedByUserId String?
  deletionAt          DateTime?
  deletionReason      String?
  deletionByUserId    String?

  sessions        Session[]
  accounts        Account[]
  members         Member[]
  invitations     Invitation[]
  devices         Device[]
  assignedServers Server[]     @relation("ServerAssignedUser")
  events          Event[]      @relation("EventActor")
  passkeys        Passkey[]
  twoFactors      TwoFactor[]
  keyApprovals    KeyApproval[] @relation("KeyApprovalApprover")

  @@unique([email])
  @@index([deletionAt])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id        String   @id
  name      String
  slug      String
  logo      String?
  createdAt DateTime
  metadata  String?

  suspendedAt       DateTime?
  suspendedReason   String?
  suspendedByUserId String?
  closedAt          DateTime?
  closedReason      String?
  closedByUserId    String?
  deletionAt        DateTime?
  deletionReason    String?
  deletionByUserId  String?

  members       Member[]
  invitations   Invitation[]
  servers       Server[]
  subscriptions Subscription[]
  billing       OrganizationBilling?
  events        Event[]
  referral      Referral?
  mailThreads   MailThread[]
  backups       Backup[]

  @@unique([slug])
  @@index([deletionAt])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model DeviceCode {
  id              String    @id
  deviceCode      String
  userCode        String
  userId          String?
  expiresAt       DateTime
  status          String
  lastPolledAt    DateTime?
  pollingInterval Int?
  clientId        String?
  scope           String?

  @@index([deviceCode])
  @@index([userCode])
  @@map("deviceCode")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Device {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  publicKey   String
  fingerprint String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  enrolledServers   Server[]              @relation("ServerEnrollingDevice")
  serverRevocations ServerRevokedDevice[]
  keyApprovals      KeyApproval[]

  @@index([userId])
}

model Server {
  id                     String                @id @default(cuid())
  organizationId         String
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  host                   String?
  port                   Int                   @default(22)
  sshUser                String                @default("dev")
  hostFingerprint        String?
  arch                   String
  agentVersion           String?
  targetVersion          String?
  serverTokenHash        String?               @unique
  enrollmentTokenHash    String?               @unique
  enrollmentKey          String?               @unique
  enrollmentExpiresAt    DateTime?
  licenseValidUntil      DateTime?
  decommissionAt         DateTime?
  status                 ServerStatus          @default(enrolling)
  suspendedReason        SuspensionReason?
  /// Reopening the organization only lifts suspensions it caused, not ones laid on this server alone.
  suspendedByOrganization Boolean              @default(false)
  channel                ReleaseChannel        @default(stable)
  deviceId               String?
  device                 Device?               @relation("ServerEnrollingDevice", fields: [deviceId], references: [id], onDelete: SetNull)
  assignedUserId         String?
  assignedUser           User?                 @relation("ServerAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  pendingAssignmentEmail String?
  revokedDevices         ServerRevokedDevice[]
  alerts                 Alert[]
  lastHeartbeatAt        DateTime?
  /// One row per heartbeat, pruned past seven days.
  metricSamples          ServerMetric[]
  lastUsage              Json?
  /// Last `BackupBeat`; a heartbeat without one keeps it.
  backup                 Json?
  backups                Backup[]
  /// Last `KeysBeat` as `{ signers, pending, reported_at }`; a heartbeat without one keeps it.
  keyReport              Json?
  keyApprovals           KeyApproval[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([organizationId])
  @@index([assignedUserId])
  @@index([deviceId])
  @@index([status])
  @@index([decommissionAt])
  @@index([pendingAssignmentEmail])
  @@index([lastHeartbeatAt])
}

model ServerMetric {
  id       String   @id @default(cuid())
  serverId String
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  at       DateTime
  sample   Json

  @@index([serverId, at])
  @@index([at])
}

model Alert {
  id          String    @id @default(cuid())
  serverId    String
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  kind        AlertKind
  firstSeenAt DateTime  @default(now())
  notifiedAt  DateTime?
  resolvedAt  DateTime?

  @@index([serverId, kind])
  @@index([resolvedAt])
}

/// Where a backup lies in the client's own bucket and its size, never its content.
model Backup {
  id             String        @id @default(cuid())
  backupId       String
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serverId       String?
  server         Server?       @relation(fields: [serverId], references: [id], onDelete: SetNull)
  serverName     String
  createdAt      DateTime
  declaredAt     DateTime      @default(now())
  trigger        BackupTrigger
  name           String?
  bytes          BigInt
  counts         Json
  configRevision Int
  agentVersion   String
  recipient      String
  kdfSalt        String
  endpoint       String
  region         String
  bucket         String
  key            String
  pathStyle      Boolean
  manifestSha256 String
  forgottenAt    DateTime?

  @@unique([organizationId, backupId])
  @@index([organizationId, createdAt])
  @@index([serverId])
}

model ServerRevokedDevice {
  serverId        String
  server          Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  deviceId        String
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  revokedByUserId String?
  revokedAt       DateTime @default(now())

  @@id([serverId, deviceId])
  @@index([deviceId])
}

model KeyApproval {
  id               String   @id @default(cuid())
  serverId         String
  server           Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  deviceId         String
  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId           String
  signer           String
  /// A string to keep the exact signed spelling (decision 0014).
  issuedAt         String
  signature        String
  approvedByUserId String?
  approvedBy       User?    @relation("KeyApprovalApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@unique([serverId, deviceId, signer])
  @@index([deviceId])
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String       @unique
  product              String
  quantity             Int
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean      @default(false)
  note                 String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId])
}

model OrganizationBilling {
  organizationId   String          @id
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeCustomerId String          @unique
  defaultInterval  BillingInterval @default(month)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model AffiliateLink {
  id           String              @id @default(cuid())
  code         String              @unique
  name         String
  partnerName  String?
  partnerEmail String?
  notes        String?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt
  disabledAt   DateTime?
  referrals    Referral[]
  clickDays    AffiliateClickDay[]
}

model AffiliateClickDay {
  id     String        @id @default(cuid())
  linkId String
  link   AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  day    String
  count  Int           @default(0)

  @@unique([linkId, day])
  @@index([day])
}

model Referral {
  organizationId String        @id
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linkId         String
  link           AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([linkId])
}

enum MailDirection {
  inbound
  outbound
}

enum MailThreadStatus {
  open
  closed
}

enum MailDelivery {
  received
  sent
  failed
}

enum MailActivityAction {
  received
  read
  unread
  replied
  reply_failed
  composed
  assigned
  unassigned
  closed
  reopened
  linked
  unlinked
  note_added
  note_deleted
}

model MailMailbox {
  id          String   @id @default(cuid())
  address     String   @unique
  displayName String
  signature   String?
  /// Every read of a sensitive mailbox is journaled.
  sensitive   Boolean  @default(false)
  canReply    Boolean  @default(true)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  threads   MailThread[]
  templates MailTemplate[]

  @@index([sortOrder])
}

model MailThread {
  id                     String           @id @default(cuid())
  /// The envelope address; the declared mailbox may be missing.
  address                String
  mailboxId              String?
  mailbox                MailMailbox?     @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  subject                String
  normalizedSubject      String
  status                 MailThreadStatus @default(open)
  unread                 Boolean          @default(true)
  assignedUserId         String?
  contactUserId          String?
  linkedOrganizationId   String?
  linkedOrganization     Organization?    @relation(fields: [linkedOrganizationId], references: [id], onDelete: SetNull)
  lastInboundAt          DateTime?
  /// Denormalized because no `some`/`none` filter can target the last inbound mail.
  lastInboundAutomated   Boolean          @default(false)
  lastOutboundAt         DateTime?
  /// Last inbound sender, or the recipient of a thread we started.
  senderEmail            String?
  senderName             String?
  /// Passed DMARC, or an aligned DKIM or SPF check, at the receiving MX.
  senderAuthenticated    Boolean          @default(false)
  /// Copied from the last message so the list never reads messages.
  snippet                String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  messages   MailMessage[]
  notes      MailNote[]
  draft      MailDraft?
  activities MailActivity[]

  @@index([status, updatedAt])
  @@index([unread, updatedAt])
  @@index([address, normalizedSubject])
  @@index([assignedUserId])
  @@index([contactUserId])
  @@index([mailboxId])
  @@index([linkedOrganizationId])
}

model MailNote {
  id              String     @id @default(cuid())
  threadId        String
  thread          MailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  body            String
  createdByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt

  @@index([threadId, createdAt])
}

model MailDraft {
  id              String     @id @default(cuid())
  threadId        String     @unique
  thread          MailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  body            String
  to              Json?
  cc              Json?
  attachments     Json?
  updatedByUserId String
  updatedAt       DateTime   @default(now()) @updatedAt
}

model MailActivity {
  id          String             @id @default(cuid())
  threadId    String
  thread      MailThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  action      MailActivityAction
  actorUserId String?
  metadata    Json?
  createdAt   DateTime           @default(now())

  @@index([threadId, createdAt])
}

model MailTemplate {
  id              String       @id @default(cuid())
  mailboxId       String?
  mailbox         MailMailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  name            String
  body            String
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  @@index([mailboxId])
}

model MailMessage {
  id            String        @id @default(cuid())
  threadId      String
  thread        MailThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction     MailDirection
  fromEmail     String
  fromName      String?
  toEmails      Json
  ccEmails      Json
  subject       String?
  text          String?
  snippet       String?
  htmlKey       String?
  rawKey        String?
  rawHash       String?       @unique
  messageId     String?
  /// One mail sent to two of our addresses is stored as two rows.
  address       String?
  inReplyTo     String?
  references    String?
  sentByUserId  String?
  /// Bounce, list blast or auto-reply: filed but never answered.
  automated     Boolean       @default(false)
  /// `From` passed DMARC, or an aligned DKIM or SPF check, at the receiving MX.
  authenticated Boolean       @default(false)
  delivery      MailDelivery  @default(received)
  error         String?
  receivedAt    DateTime      @default(now())
  sentAt        DateTime?
  createdAt     DateTime      @default(now())

  attachments MailAttachment[]

  @@unique([messageId, address])
  @@index([threadId, createdAt])
}

model MailAttachment {
  id        String      @id @default(cuid())
  messageId String
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  key       String
  filename  String
  mimeType  String
  size      Int
  contentId String?
  createdAt DateTime    @default(now())

  @@index([messageId])
}

model Release {
  version     String
  arch        String
  sha256      String
  signature   String
  r2Key       String
  channel     ReleaseChannel @default(beta)
  publishedAt DateTime       @default(now())

  @@id([version, arch])
  @@index([channel, publishedAt])
}

model AppRelease {
  version     String
  os          DesktopOs
  arch        String
  format      String
  /// Key in the downloads bucket; the platform builds the URL, so a release never names a host.
  r2Key       String
  bytes       Int
  sha256      String
  signature   String?
  notes       String
  channel     ReleaseChannel @default(beta)
  publishedAt DateTime       @default(now())

  @@id([version, os, arch, format])
  @@index([channel, publishedAt])
}

model Event {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actorUser      User?         @relation("EventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  targetType     String
  targetId       String
  payload        Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([targetType, targetId])
}

model StripeEvent {
  id             String            @id
  type           String
  status         StripeEventStatus @default(processing)
  subscriptionId String?
  receivedAt     DateTime          @default(now())
  processedAt    DateTime?

  @@index([subscriptionId])
}
