{
  "name": "@pupitre/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/generated/prisma/client.ts",
    "./enums": "./src/generated/prisma/enums.ts",
    "./models": "./src/generated/prisma/models.ts",
    "./browser": "./src/generated/prisma/browser.ts",
    "./cloudflare/client": "./src/generated/prisma-cloudflare/client.ts",
    "./cloudflare/enums": "./src/generated/prisma-cloudflare/enums.ts",
    "./cloudflare/models": "./src/generated/prisma-cloudflare/models.ts",
    "./latest-migration": "./src/latest-migration.ts",
    "./neon": "./src/neon.ts"
  },
  "scripts": {
    "build": "bun run db:generate",
    "db:generate": "prisma generate",
    "db:migrate": "sh -c 'bun scripts/guard-migration-target.ts && prisma migrate dev \"$@\"' --",
    "db:migrate:deploy": "sh -c 'bun scripts/require-migrate-database-url.ts && prisma migrate deploy'",
    "db:migrate:reset": "sh -c 'bun scripts/guard-migration-target.ts && prisma migrate reset \"$@\"' --",
    "db:studio": "prisma studio",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "check:types": "tsgo --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2",
    "ultracite": "7.11.0"
  }
}
