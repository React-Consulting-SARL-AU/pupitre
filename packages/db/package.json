  "dependencies": {
    "@prisma/adapter-d1": "^7.9.1",
    "@prisma/client": "^7.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260908.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2",
    "ultracite": "7.11.1"
  }
