# Variables locales du monorepo. Copie : cp .env.example .env.local
# `.env.local` est ignoré par Git et symlinké dans apps/web/. Jamais de vraie valeur ici.
# Seules les variables VITE_* atteignent le bundle client : jamais un secret en VITE_*.

# Pas de base ici : la console locale lit la D1 que miniflare tient sous
# apps/web/.wrangler/state, migrée par `bun run dev:prepare`.

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facturation : `off` ne vend rien et n'appelle jamais Stripe (au-delà des
# serveurs gratuits, seule l'équipe accorde une licence), `stripe` passe par
# Checkout. La valeur vient de `vars` de wrangler.jsonc.
BILLING_MODE=""

# Stripe Managed Payments (produit « Pupitre Server », deux prix en dollars).
# Inutiles en BILLING_MODE=off.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SERVER_MONTH=""
STRIPE_PRICE_SERVER_YEAR=""

# R2 via l'API S3 : le seau privé des binaires de l'agent, et celui des mails,
# dont la console lit et dépose les pièces jointes par adresse signée. La même
# clé ouvre les deux. Le bucket public des artefacts de l'app n'est pas ici : la
# plateforme n'y écrit jamais, seule la CI y dépose, et elle lit ses propres
# variables. Sans les trois premières, la plateforme rend des adresses locales.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ppt-agent"
R2_MAIL_BUCKET_NAME="ppt-mail"

# Le seau public des artefacts de l'app. La plateforme n'y écrit jamais : elle
# s'en sert pour composer l'adresse d'une version à partir de sa clé.
PUPITRE_DOWNLOADS_URL="https://dl.pupitre.studio"

# Ce que la CI présente pour déclarer une version. Le préfixe compte : c'est à
# lui que la plateforme reconnaît un jeton de publication d'une session.
#   echo "pupitre_pub_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
# Tiré une fois, posé ici, sur le Worker et dans GitHub Actions. La variante
# _PREVIOUS n'existe que le temps d'une rotation.
PUPITRE_PUBLISH_TOKEN=""

# Cloudflare Email
EMAIL_FROM=""

# Web
VITE_APP_URL=""

# Tunnel de développement : le jeton du tunnel géré depuis le tableau de bord
# Cloudflare, et le nom d'hôte qu'il publie (défaut dans scripts/dev-tunnel.ts :
# dev.pupitre.studio, à ne remplir que pour en viser un autre). Le chemin
# servi et l'origine se règlent dans le tableau de bord, pas ici.
# PUPITRE_AGENT_PLATFORM_URL ne change que ce que l'app desktop donne à
# l'agent, pas la plateforme qu'elle appelle elle-même.
PUPITRE_TUNNEL_TOKEN=""
PUPITRE_TUNNEL_HOSTNAME=""
PUPITRE_AGENT_PLATFORM_URL=""

# App desktop en développement : ce qu'elle prérémplit pour ne pas retaper la
# même machine dix fois par jour. Lu par le processus principal, jamais par un
# build empaqueté. Le mot de passe est celui de la machine jetable de
# apps/agent/test/vps, pas un secret ; l'identité git est celle des commits.
PUPITRE_DEV_SERVER_NAME=""
PUPITRE_DEV_SERVER_HOST=""
PUPITRE_DEV_SERVER_PORT=""
PUPITRE_DEV_SERVER_USER=""
PUPITRE_DEV_SERVER_PASSWORD=""
PUPITRE_DEV_GIT_NAME=""
PUPITRE_DEV_GIT_EMAIL=""

# Environnement (`production` dans les vars de wrangler.jsonc ; vide en local)
PUPITRE_ENVIRONMENT=""

# Site (build de apps/site, posées par build:production et Cloudflare Builds en production)
PUBLIC_RELEASES_URL=""
PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST=""
