# Variables locales du monorepo. Copie : cp .env.example .env.local
# `.env.local` est ignoré par Git et symlinké dans apps/web/. Jamais de vraie valeur ici.
# Seules les variables VITE_* atteignent le bundle client : jamais un secret en VITE_*.

# Pas de base ici : la console locale lit la D1 que miniflare tient sous
# apps/web/.wrangler/state, migrée par `bun run dev:prepare`.

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe Managed Payments (produit « Pupitre Server », deux prix en dollars)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SERVER_MONTH=""
STRIPE_PRICE_SERVER_YEAR=""

# R2, bucket privé des binaires de l'agent, via l'API S3. Le bucket public des
# artefacts de l'app n'est pas ici : la plateforme n'y écrit jamais, seule la CI
# y dépose, et elle lit ses propres variables.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ppt-agent"

# Le seau public des artefacts de l'app. La plateforme n'y écrit jamais : elle
# s'en sert pour composer l'adresse d'une version à partir de sa clé.
PUPITRE_DOWNLOADS_URL="https://dl.pupitre.studio"

# Ce que la CI présente pour déclarer une version. Le préfixe compte : c'est à
# lui que la plateforme reconnaît un jeton de publication d'une session.
#   echo "pupitre_pub_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
# Tiré une fois, posé ici, sur le Worker et dans GitHub Actions. La variante
# _PREVIOUS n'existe que le temps d'une rotation.
PUPITRE_PUBLISH_TOKEN=""

# Cloudflare Email
EMAIL_FROM=""

# Web
VITE_APP_URL=""

# Tunnel de développement (défauts dans scripts/dev-tunnel.ts : pupitre-dev,
# dev-app.pupitre.studio, http://localhost:3000). À ne remplir que pour en viser
# un autre. PUPITRE_AGENT_PLATFORM_URL ne change que ce que l'app desktop donne
# à l'agent, pas la plateforme qu'elle appelle elle-même.
PUPITRE_TUNNEL_NAME=""
PUPITRE_TUNNEL_HOSTNAME=""
PUPITRE_TUNNEL_SERVICE=""
PUPITRE_AGENT_PLATFORM_URL=""

# App desktop en développement : ce qu'elle prérémplit pour ne pas retaper la
# même machine dix fois par jour. Lu par le processus principal, jamais par un
# build empaqueté. Le mot de passe est celui de la machine jetable de
# apps/agent/test/vps, pas un secret ; l'identité git est celle des commits.
PUPITRE_DEV_SERVER_NAME=""
PUPITRE_DEV_SERVER_HOST=""
PUPITRE_DEV_SERVER_PORT=""
PUPITRE_DEV_SERVER_USER=""
PUPITRE_DEV_SERVER_PASSWORD=""
PUPITRE_DEV_GIT_NAME=""
PUPITRE_DEV_GIT_EMAIL=""

# Observabilité (facultatif en local : sans DSN, rien n'est envoyé)
PUPITRE_ENVIRONMENT=""
SENTRY_DSN=""

# Site (build de apps/site, posées dans Cloudflare Pages en production)
PUBLIC_RELEASES_URL=""
PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST=""
