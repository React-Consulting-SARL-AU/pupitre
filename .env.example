# Variables locales du monorepo. Copie : cp .env.example .env.local
# `.env.local` est ignoré par Git et symlinké dans apps/web/. Jamais de vraie valeur ici.
# Seules les variables VITE_* atteignent le bundle client : jamais un secret en VITE_*.

# Neon (endpoint poolé pour l'app, direct pour les migrations)
DATABASE_URL=""
MIGRATE_DATABASE_URL=""

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe Managed Payments (produit « Serveur », un prix par devise et par période)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SERVER_EUR_MONTH=""
STRIPE_PRICE_SERVER_EUR_YEAR=""
STRIPE_PRICE_SERVER_USD_MONTH=""
STRIPE_PRICE_SERVER_USD_YEAR=""

# R2 (binaires signés), via l'API S3
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Cloudflare Email
EMAIL_FROM=""

# Web
VITE_APP_URL=""
