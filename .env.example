# Local monorepo variables. Copy: cp .env.example .env.local
# `.env.local` is ignored by Git and symlinked into apps/web/. Never a real value here.
# Only VITE_* variables reach the client bundle: never a secret in VITE_*.

# No database here: the local console reads the D1 that miniflare keeps under
# apps/web/.wrangler/state, migrated by `bun run dev:prepare`.

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Billing: `off` sells nothing and never calls Stripe (beyond the free
# servers, only the team grants a licence), `stripe` goes through Checkout.
# The value comes from the `vars` of wrangler.jsonc.
BILLING_MODE=""

# Stripe Managed Payments ("Pupitre Server" product, two prices in dollars).
# Unused in BILLING_MODE=off.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SERVER_MONTH=""
STRIPE_PRICE_SERVER_YEAR=""

# R2 through the S3 API: the private bucket of agent binaries, and the mail
# one, whose attachments the console reads and drops through signed URLs. The
# same key opens both. The app artifacts' public bucket is not here: the
# platform never writes to it, only CI does, and it reads its own variables.
# Without the first three, the platform returns local URLs.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ppt-agent"
R2_MAIL_BUCKET_NAME="ppt-mail"

# The app artifacts' public bucket. The platform never writes to it: it uses
# it to compose a version's URL from its key.
PUPITRE_DOWNLOADS_URL="https://dl.pupitre.studio"

# What CI presents to declare a version. The prefix matters: it is how the
# platform tells a publish token from a session's.
#   echo "pupitre_pub_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
# Drawn once, set here, on the Worker and in GitHub Actions. The _PREVIOUS
# variant only exists for the duration of a rotation.
PUPITRE_PUBLISH_TOKEN=""

# Cloudflare Email
EMAIL_FROM=""

# Web
VITE_APP_URL=""

# Development tunnel: the token of the tunnel managed from the Cloudflare
# dashboard, and the hostname it publishes (default in scripts/dev-tunnel.ts:
# dev.pupitre.studio, to fill in only to target another one). The served path
# and the origin are set in the dashboard, not here.
# PUPITRE_AGENT_PLATFORM_URL only changes what the desktop app gives to the
# agent, not the platform it calls itself.
PUPITRE_TUNNEL_TOKEN=""
PUPITRE_TUNNEL_HOSTNAME=""
PUPITRE_AGENT_PLATFORM_URL=""

# Desktop app in development: what it prefills so you don't retype the same
# machine ten times a day. Read by the main process, never by a packaged
# build. The password is that of the throwaway machine in
# apps/agent/test/vps, not a secret; the git identity is the one for commits.
PUPITRE_DEV_SERVER_NAME=""
PUPITRE_DEV_SERVER_HOST=""
PUPITRE_DEV_SERVER_PORT=""
PUPITRE_DEV_SERVER_USER=""
PUPITRE_DEV_SERVER_PASSWORD=""
PUPITRE_DEV_GIT_NAME=""
PUPITRE_DEV_GIT_EMAIL=""

# Environment (`production` in the vars of wrangler.jsonc; empty locally)
PUPITRE_ENVIRONMENT=""

# Site (apps/site build, set by build:production and Cloudflare Builds in production)
PUBLIC_RELEASES_URL=""
PUBLIC_CF_WEB_ANALYTICS_TOKEN=""
