{
  "name": "pupitre-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@cloudflare/workers-types": "5.20260708.1",
    "@happy-dom/global-registrator": "^20.14.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "lucide-react": "^1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "satori": "^0.33.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "ultracite": "7.8.3",
    "wrangler": "^4.131.1",
    "zod": "^4.4.3"
  },
  "scripts": {
    "dev:prepare": "bun scripts/bootstrap-local.ts",
    "env": "bun scripts/env-run.ts",
    "secrets:draw": "bun scripts/draw-secrets.ts",
    "dev": "bun run dev:prepare && turbo run dev dev:stripe dev:tunnel --filter=@pupitre/site --filter=@pupitre/web",
    "dev:site": "bun run dev:prepare && turbo run dev --filter=@pupitre/site",
    "dev:web": "bun run dev:prepare && turbo run dev dev:stripe dev:tunnel --filter=@pupitre/web",
    "dev:desktop": "turbo run dev --filter=@pupitre/desktop",
    "dev:desktop:prod": "PUPITRE_PLATFORM_URL=https://app.pupitre.studio turbo run dev --filter=@pupitre/desktop",
    "dev:email": "bun --cwd=packages/api run dev:email",
    "build": "turbo run build",
    "build:agent": "turbo run build --filter=@pupitre/agent",
    "lint": "bun scripts/assert-package-boundaries.ts && bun scripts/check-prisma-client-freshness.ts && bun run contracts:check && bun run lint:root && turbo run lint",
    "lint:root": "ultracite check scripts biome.jsonc commitlint.config.js package.json tsconfig.base.json tsconfig.json turbo.json",
    "lint:fix": "bun run lint:fix:root && turbo run lint:fix",
    "lint:fix:root": "ultracite fix scripts biome.jsonc commitlint.config.js package.json tsconfig.base.json tsconfig.json turbo.json",
    "check:types": "bun run check:types:root && turbo run check:types",
    "check:types:root": "tsgo -p tsconfig.json --pretty false",
    "check:prisma-client": "bun scripts/check-prisma-client-freshness.ts",
    "check:secrets": "bun scripts/check-worker-secrets.ts",
    "workflows:run": "bun scripts/run-workflow.ts",
    "release": "bun scripts/release/index.ts",
    "test": "bun run test:root && turbo run test",
    "test:root": "bun test scripts",
    "test:affected": "turbo run test --affected",
    "contracts:export": "bun --cwd=packages/shared run contracts:export",
    "contracts:check": "bun --cwd=packages/shared run contracts:check",
    "db:generate": "turbo run db:generate --filter=@pupitre/db",
    "db:migrate": "bun --cwd=packages/db run db:migrate",
    "db:migrate:new": "bun --cwd=packages/db run db:migrate:new",
    "db:reset": "bun --cwd=packages/db run db:reset",
    "db:seed": "bun --cwd=packages/db run db:seed",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "dev:stripe": "bun run dev:prepare && turbo run dev:stripe --filter=@pupitre/web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "husky": "^9.1.7",
    "turbo": "^2.10.11",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "wrangler": "catalog:"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "electron",
    "electron-builder",
    "esbuild",
    "node-pty"
  ]
}
