{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--cwd=apps/site", "run", "dev"],
      "port": 4321
    },
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--cwd=apps/web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "desktop",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--cwd=apps/desktop", "run", "dev"],
      "port": 5173
    },
    {
      "name": "email",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EMAIL_PREVIEW_PORT=4322",
        "bun",
        "--cwd=packages/api",
        "run",
        "dev:email"
      ],
      "port": 4322
    }
  ]
}
