#!/usr/bin/env zsh
# =============================================================================
#  dev — day-to-day driver of the development server.
#
#  What the machine runs — a database, a tunnel, a secret manager, or none of
#  those — is read from its profile, never from here: the matching commands
#  politely say they have no object rather than failing on a missing service.
#
#  One project = one tmux window in the "dev" session. Windows survive SSH
#  disconnection: you close your laptop, you come back the next day, everything
#  is still running. Each project's output is also written to a log file, which
#  lets an agent read the errors without attaching to tmux (`dev logs <project>`).
#
#      dev tui                   full-screen DASHBOARD (all keyboard)
#      dev up [project|all]      start
#      dev down [project|all]    stop
#      dev restart <project>
#      dev status [--json]       overview (what runs, ports, services)
#      dev snapshot              machine + services + projects, in one JSON
#      dev attach [project]      attach to the tmux session (Ctrl-b d to leave)
#      dev logs <project> [-f]   last lines / follow
#      dev sync [project|all]    git pull + reinstall dependencies
#      dev install [project|all] reinstall dependencies only
#      dev url [project]         public URLs
#      dev secrets <project>     resynchronise the project's secrets
#      dev secrets --json        state of the keys in /etc/dev-stack.env
#      dev secrets set <KEY>     replace a key (value read from standard input)
#      dev env [project|all]     (re)generate the project's .env.local
#                                FORCE=1 dev env <project>  to overwrite
#      dev db <shell|dump|import|url>   (if the machine has a local database)
#      dev shots <list|url|clean>   gallery of images produced by agents
#      dev claude <project>      opens Claude Code in the project folder
#      dev codex <project>
#      dev branch                each repository's branch
#      dev branch <project>      the available branches
#      dev branch <project> <name>  switch to it, create it if missing
#      dev branches <project>    its branches, as JSON (repo:false if unversioned)
#      dev projects              the whole registry, as JSON
#      dev project add           registers a project (registry row on stdin)
#      dev project remove <name> removes it (the folder stays)
#      dev tunnel <status|sync|restart> (if the machine has a tunnel)
#      dev debug <project>       restart with the JVM debug agent
#      dev sessions [clean]      the agent sessions still hanging around
#      dev kill <pid> [--force]  stops a process
#      dev reboot                reboots the server (frees RAM)
#      dev doctor                quick diagnosis
#      dev diag                  full report, to paste when something breaks
#      dev completions           dev's grammar, as JSON (Pupitre autocompletion)
# =============================================================================

emulate -L zsh
set -o pipefail

CONF=${DEV_STACK_CONF:-/etc/dev-stack.projects.conf}
STACK=/opt/dev-stack
SESSION=dev
LOGDIR=$HOME/.dev-stack/logs
PROJECTS_DIR=${PROJECTS_DIR:-$HOME/projects}
# The secrets file is only readable by root; the "public" version contains only
# paths, host names and the machine profile, and serves both.
#
# The public file is read LAST, and that is deliberate: it carries the profile as
# the provisioning resolved it, whereas the secrets file only carries the wish.
# Without this, `dev` run as root — which reads both — would describe the machine
# differently from `dev` run by the user.
[[ -r /etc/dev-stack.env ]] && source /etc/dev-stack.env 2>/dev/null
[[ -r /etc/dev-stack.public.env ]] && source /etc/dev-stack.public.env
DEV_DOMAIN=${DEV_DOMAIN:-}
# The name the machine goes by — in `dev status` and in the tmux bar. A VPS
# hostname is often a string of digits nobody recognises: STACK_NAME lets you
# call it what you actually call it.
STACK_NAME=${STACK_NAME:-$(hostname -s 2>/dev/null || print server)}

# --- what this particular machine runs ---------------------------------------
#
# The profile is written by bootstrap.sh into the public file. Until it is there
# — a stack installed before these settings existed — we observe the machine
# rather than assume: the systemd unit is there, or it is not. Nothing is guessed
# from the secrets, which this command cannot read anyway when it is not running
# as root.
_unit_exists() {
  systemctl list-unit-files "$1.service" 2>/dev/null | grep -q "^$1.service"
}

if [[ -z ${STACK_TUNNEL:-} ]]; then
  _unit_exists cloudflared && STACK_TUNNEL=cloudflare || STACK_TUNNEL=none
fi
if [[ -z ${STACK_DATABASE:-} ]]; then
  if   _unit_exists mysql;   then STACK_DATABASE=mysql
  elif _unit_exists mariadb; then STACK_DATABASE=mariadb
  else STACK_DATABASE=none; fi
fi
if [[ -z ${STACK_SECRETS:-} ]]; then
  command -v op >/dev/null 2>&1 && STACK_SECRETS=1password || STACK_SECRETS=none
fi
if [[ -z ${STACK_GIT:-} ]]; then
  command -v gh >/dev/null 2>&1 && STACK_GIT=github || STACK_GIT=git
fi
# Empty and undefined do not mean the same thing: a machine may announce no
# service at all, and that is not the same situation as a profile never written.
if [[ -z ${STACK_SERVICES+x} ]]; then
  STACK_SERVICES=""
  [[ $STACK_TUNNEL != none ]] && STACK_SERVICES="tunnel:Tunnel:cloudflared"
  case $STACK_DATABASE in
    mysql)   STACK_SERVICES="${STACK_SERVICES:+$STACK_SERVICES }database:Database:mysql" ;;
    mariadb) STACK_SERVICES="${STACK_SERVICES:+$STACK_SERVICES }database:Database:mariadb" ;;
  esac
fi

# What `dev db` needs to know without being root: who connects, and to what. The
# public file carries it; the secrets file, when it is readable, has the last
# word.
: ${MYSQL_REMOTE_USER:=${STACK_DB_USER:-}}
: ${MYSQL_DATABASES:=${STACK_DB_NAMES:-}}

_with_tunnel()   { [[ $STACK_TUNNEL   != none ]] }
_with_database() { [[ $STACK_DATABASE != none ]] }
_with_secrets()  { [[ $STACK_SECRETS  != none ]] }

# The systemd unit of a declared service, by its key. Empty if not declared.
_unit_of() {
  local d
  for d in ${=STACK_SERVICES}; do
    [[ ${d%%:*} == $1 ]] && { print -n ${d##*:}; return }
  done
}

# A project's public address — empty when there is none.
#
# A project only has a public URL if the machine has a tunnel, a domain, and the
# registry row gives it a subdomain. All three are often missing, and printing
# "https://…" in that case would be an address that does not answer.
_public_url() {
  _with_tunnel || return 1
  [[ -n $DEV_DOMAIN ]] || return 1
  [[ ${P_SUB[$1]} != "-" && -n ${P_SUB[$1]} ]] || return 1
  print -n "https://${P_SUB[$1]}.${DEV_DOMAIN}"
}

# The local address, always true.
_local_url() { print -n "http://${P_HOST[$1]}:${P_PORT[$1]}" }

# The one we show: the public one if it exists, the local one otherwise.
_url() { _public_url $1 || _local_url $1 }

mkdir -p $LOGDIR

autoload -U colors && colors
c_ok="%F{green}"; c_no="%F{red}"; c_dim="%F{242}"; c_hi="%F{cyan}"; c_w="%F{yellow}"; c_r="%f"
say()  { print -P "$@" }
err()  { print -P "${c_no}✗${c_r} $@" >&2 }

# --- reading the registry ----------------------------------------------------
# Two files, in this order: the one `deploy.sh` lays down from the repository,
# and the one Pupitre and the agents write here. The second wins on equal names —
# that is what allows adding or fixing a project without the next deployment
# erasing it.
CONF_LOCAL=${DEV_STACK_CONF_LOCAL:-/etc/dev-stack.projects.local.conf}

_registry() {
  cat $CONF $CONF_LOCAL 2>/dev/null | awk -F'|' '
    /^[[:space:]]*(#|$)/ { next }
    NF < 8 { next }
    { if (!($1 in seen)) { seen[$1] = 1; order[++n] = $1 } row[$1] = $0 }
    END { for (i = 1; i <= n; i++) print row[order[i]] }'
}

# Fills the P_* associative arrays, indexed by project name.
typeset -A P_DIR P_REPO P_PKG P_HOST P_PORT P_SUB P_CMD P_INSTALL P_ORIGIN
typeset -a P_ORDER
_load() {
  [[ -r $CONF ]] || { err "registry not found: $CONF"; exit 1 }
  local -A locals
  local name
  if [[ -r $CONF_LOCAL ]]; then
    while IFS='|' read -r name _; do
      [[ -z $name || $name == \#* ]] && continue
      locals[$name]=1
    done < $CONF_LOCAL
  fi

  local n dir repo pkg host port sub cmd install
  while IFS='|' read -r n dir repo pkg host port sub cmd install; do
    # The port may carry a scheme ("https:5180"): here we only want the number.
    port="${port##*:}"
    [[ -z $n || $n == \#* ]] && continue
    P_ORDER+=($n)
    P_DIR[$n]=$dir; P_REPO[$n]=$repo; P_PKG[$n]=$pkg
    P_HOST[$n]=$host; P_PORT[$n]=$port; P_SUB[$n]=$sub; P_CMD[$n]=$cmd
    # Column 9 is optional: a row of eight fields leaves it empty, and the
    # install command is then derived from the package manager.
    P_INSTALL[$n]=${install}
    P_ORIGIN[$n]=${locals[$n]:+local}
    : ${P_ORIGIN[$n]:=stack}
  done < <(_registry)
}
_load

_known() { [[ -n ${P_DIR[$1]:-} ]] }
# "service" entries (the screenshot gallery) are managed by systemd: they appear
# in `dev status` but never in `dev up all`.
_is_service() { [[ ${P_PKG[$1]} == service ]] }
_targets() {  # "all" or empty → every project; otherwise the given list
  if [[ -z $1 || $1 == all ]]; then
    for n in $P_ORDER; do _is_service $n || print $n; done
  else
    for n in "$@"; do
      _known $n || { err "unknown project: $n  (dev status for the list)"; return 1 }
      print $n
    done
  fi
}
_wd() { print $PROJECTS_DIR/${P_DIR[$1]} }
# The repository a project belongs to.
#
# Several processes often share one repository: an app and its mail preview, an
# API and its client. The first segment of `dir` already carries that
# information — no need for an extra registry column to repeat it.
_group() {
  local root=${${P_DIR[$1]}%%/*}
  [[ $root == . || -z $root ]] && root=$1
  print $root
}

# How a project's dependencies get installed.
#
# Column 9 of the registry, when it is filled in, and nothing else: it is then
# the whole answer, whatever the package manager says. Left empty, we derive it
# from the package manager — but we still SAY what we derived, because "it
# installed the dependencies somehow" is exactly the thing you cannot debug.
_install_cmd() {
  local explicit=${P_INSTALL[$1]:-}
  if [[ -n $explicit && $explicit != "-" ]]; then
    print -r -- "$explicit"
    return
  fi
  case ${P_PKG[$1]} in
    bun)    print -r -- "bun install" ;;
    pnpm)   print -r -- "pnpm install" ;;
    npm)    print -r -- "npm install" ;;
    yarn)   print -r -- "yarn install" ;;
    # `--version` downloads the distribution the wrapper pins, which is the
    # install step. Compiling is the project's business — put a build in
    # column 9 of the registry if that is what you want here.
    gradle) print -r -- "./gradlew --version" ;;
    *)      print -r -- "" ;;
  esac
}

_running() { tmux list-windows -t $SESSION -F '#W' 2>/dev/null | grep -qx "$1" }

# ---------------------------------------------------------------------------
#  Batched collection
#
#  The naive version queried the system ONCE PER PROJECT: a `git` for the
#  branch, a `tmux` and a `ps` for the age, a `tail | grep` for the failure.
#  Eleven projects therefore meant 90 processes and 800 ms from the client —
#  the whole budget of an interface refreshing every second.
#
#  Here we query the system once for all of them, and each project becomes just
#  an array lookup.
# ---------------------------------------------------------------------------
typeset -A COL_AGE COL_BRANCH COL_PORTPID
COL_LISTEN=""
COL_WINDOWS=""

_collect() {
  # Listening ports, one single read for all. WITHOUT `-p`: asking ss for the
  # socket→process mapping makes it walk /proc and doubles its cost, while those
  # PIDs are only needed for the rare services started outside `dev`. We look
  # them up on demand, in _c_age.
  local line local_addr port
  COL_LISTEN=" "
  COL_PORTPID=()
  while read -r line; do
    local_addr=${${(z)line}[4]}
    port=${local_addr##*:}
    [[ $port == <-> ]] || continue
    COL_LISTEN+="$port "
  done < <(ss -lntH 2>/dev/null)

  # tmux windows and the age of their shell — two calls, not two per project.
  COL_WINDOWS=" "
  COL_AGE=()
  local -A pane_pid
  local name p
  while read -r name p; do
    [[ -n $name && $p == <-> ]] || continue
    COL_WINDOWS+="$name "
    pane_pid[$name]=$p
  done < <(tmux list-panes -a -F '#{window_name} #{pane_pid}' 2>/dev/null)

  local -A age_of
  local pids=(${(v)pane_pid})
  if (( $#pids )); then
    while read -r p line; do
      [[ $p == <-> ]] && age_of[$p]=$line
    done < <(ps -o pid=,etimes= -p ${(j:,:)pids} 2>/dev/null)
  fi
  for name in ${(k)pane_pid}; do
    [[ -n ${age_of[${pane_pid[$name]}]:-} ]] && COL_AGE[$name]=${age_of[${pane_pid[$name]}]}
  done
  typeset -gA COL_AGE_BY_PID
  COL_AGE_BY_PID=()
  for p in ${(k)age_of}; do COL_AGE_BY_PID[$p]=${age_of[$p]}; done

  # Memory per project. A dev environment grows silently — a Gradle daemon, a
  # Vite watcher — and it is always when the machine saturates that you go
  # looking for which one. So we sum each window's process tree.
  typeset -gA COL_RSS
  COL_RSS=()
  if (( ${#pane_pid} )); then
    local -A kids rss_of
    local pid ppid rss
    while read -r pid ppid rss; do
      [[ $pid == <-> ]] || continue
      rss_of[$pid]=$rss
      kids[$ppid]="${kids[$ppid]:-} $pid"
    done < <(ps -eo pid=,ppid=,rss= 2>/dev/null)

    local wname total queue cur
    for wname in ${(k)pane_pid}; do
      total=0
      queue=(${pane_pid[$wname]})
      while (( $#queue )); do
        cur=${queue[1]}; shift queue
        (( total += ${rss_of[$cur]:-0} ))
        queue+=(${=kids[$cur]:-})
      done
      COL_RSS[$wname]=$(( total / 1024 ))
    done
  fi

  # A service whose port answers with no tmux window was started elsewhere: it
  # alone needs the socket→process mapping, which doubles the cost of ss.
  local n
  for n in $P_ORDER; do
    if _c_port_up $n && ! _c_running $n; then _collect_portpid; break; fi
  done

  # Branches: read from .git/HEAD, without launching git. That is the clearest
  # win — git takes ten milliseconds just to start.
  COL_BRANCH=()
  local root head
  for n in $P_ORDER; do
    root=$(_repo_root $n)
    [[ -n ${COL_BRANCH[$root]:-} ]] && continue
    [[ -r $root/.git/HEAD ]] || { COL_BRANCH[$root]=""; continue }
    head=$(<$root/.git/HEAD)
    if [[ $head == ref:\ refs/heads/* ]]; then
      # We strip the prefix, not everything up to the last "/": a branch named
      # feat/local-planning keeps its full path, exactly as `git rev-parse
      # --abbrev-ref` would return it.
      COL_BRANCH[$root]=${head#ref: refs/heads/}
    elif [[ $head == ref:* ]]; then
      COL_BRANCH[$root]=${head##*/}
    else
      COL_BRANCH[$root]=${head[1,7]}
    fi
  done
}

_c_port_up() { [[ $COL_LISTEN == *" ${P_PORT[$1]} "* ]] }
_c_running() { [[ $COL_WINDOWS == *" $1 "* ]] }
_c_branch()  { print -r -- ${COL_BRANCH[$(_repo_root $1)]:-} }

# The PIDs holding ports. Called ONCE by _collect, and only if a project needs
# it: `_c_age` runs inside a command substitution, therefore in a subshell,
# where no "already read" flag would propagate back — every project would have
# restarted the read.
_collect_portpid() {
  local line local_addr port pid pids=()
  while read -r line; do
    [[ $line == *pid=* ]] || continue
    local_addr=${${(z)line}[4]}
    port=${local_addr##*:}
    [[ $port == <-> ]] || continue
    pid=${${line#*pid=}%%,*}
    [[ -z ${COL_PORTPID[$port]:-} ]] && { COL_PORTPID[$port]=$pid; pids+=$pid }
  done < <(ss -lntpH 2>/dev/null)
  (( $#pids )) || return
  local p rest
  while read -r p rest; do
    [[ $p == <-> ]] && COL_AGE_BY_PID[$p]=$rest
  done < <(ps -o pid=,etimes= -p ${(j:,:)pids} 2>/dev/null)
}

_duration() {
  local secs=$1
  if   (( secs < 60 ));    then print "${secs} s"
  elif (( secs < 3600 ));  then print "$((secs / 60)) min"
  elif (( secs < 86400 )); then printf '%d h %02d\n' $((secs / 3600)) $(((secs % 3600) / 60))
  else                          printf '%d d %d h\n' $((secs / 86400)) $(((secs % 86400) / 3600))
  fi
}

_c_age() {
  local secs=${COL_AGE[$1]:-}
  if [[ -z $secs ]]; then
    local pid=${COL_PORTPID[${P_PORT[$1]}]:-}
    [[ -n $pid ]] && secs=${COL_AGE_BY_PID[$pid]:-}
  fi
  [[ -n $secs ]] || return 1
  _duration $secs
}

# zsh has no /dev/tcp like bash: we test the port with the zsh/net/tcp module.
zmodload -F zsh/net/tcp b:ztcp 2>/dev/null
_port_up() {
  local h=${P_HOST[$1]} p=${P_PORT[$1]}
  if (( $+builtins[ztcp] )); then
    ztcp $h $p 2>/dev/null || return 1
    ztcp -c $REPLY 2>/dev/null
    return 0
  fi
  command nc -z -w 1 $h $p &>/dev/null
}

# What, in a log, says a startup has FAILED — not that it is grinding along.
# Nothing generic: a healthy Grails spews ERROR lines continuously, and reading
# those as a failure would show "failed" on a perfectly alive service. Only
# terminal conditions, therefore.
_log_failed() {
  local f=$LOGDIR/$1.log
  [[ -f $f ]] || return 1
  tail -c 200000 $f 2>/dev/null \
    | awk '/^=== dev up /{buf=""; next} {buf = buf $0 "\n"} END{printf "%s", buf}' \
    | grep -qiE \
      'EADDRINUSE|address already in use|BUILD FAILED|FAILURE: Build failed|Web server failed to start|command not found|Cannot find module|exited with code'
}

_ensure_session() {
  tmux has-session -t $SESSION 2>/dev/null && return
  tmux new-session -d -s $SESSION -n scratch -c $PROJECTS_DIR
  tmux set-option -t $SESSION status-left "#[fg=#54c9b6,bold] ${STACK_NAME} #[default]" >/dev/null
}

# =============================================================================
cmd_up() {
  _ensure_session
  local n
  for n in $(_targets "$@") ; do
    if _running $n; then say "${c_dim}· $n already started${c_r}"; continue; fi
    local wd=$(_wd $n)
    [[ -d $wd ]] || { err "$n: folder missing ($wd) — run this first: dev sync $n"; continue }
    # A repository's bootstrap script rewrites its .env.local with LOCAL URLs —
    # correct on a laptop, wrong here, where the browser arrives through the
    # tunnel. Vite freezes those values into the bundle at startup: they have to
    # be fixed BEFORE, not after. dev-env regenerates nothing when the file
    # exists, it merely corrects the URLs.
    if [[ -x /usr/local/bin/dev-env ]]; then
      DEV_STACK_CONF=$CONF DEV_DOMAIN=$DEV_DOMAIN \
        /usr/local/bin/dev-env $wd $PROJECTS_DIR/${${P_DIR[$n]}%%/*} $n >/dev/null 2>&1 || true
    fi

    tmux new-window -d -t $SESSION -n $n -c $wd
    # The output goes both to the tmux window (for the eye) and to a file (for
    # `dev logs`, and so agents can read it).
    tmux pipe-pane -o -t $SESSION:$n "cat >> $LOGDIR/$n.log"
    # A marker in the log. Without it, the previous shutdown — which ends with
    # "exited with code 130" — would make the next startup look like a failure
    # for as long as the port is not yet open.
    # The leading newline is essential: the previous output does not necessarily
    # end with one, and the marker would stick to the end of a line — invisible
    # to a pattern anchored at the start of a line.
    printf '\n=== dev up %s ===\n' "$(date '+%F %T')" >> $LOGDIR/$n.log
    tmux send-keys -t $SESSION:$n "clear; print -P '${c_dim}$n — ${P_CMD[$n]}${c_r}'; ${P_CMD[$n]}" C-m
    say "${c_ok}▸${c_r} $n started ${c_dim}→ $(_url $n)${c_r}"
  done
}

cmd_down() {
  local n
  for n in $(_targets "$@") ; do
    if _running $n; then
      # A trace of who stops what. Projects have gone down several times with
      # nothing to say why: the log only showed an anonymous ^C, and one could
      # only guess. The symmetry with the `dev up` marker means a project's log
      # now tells its whole story.
      printf '\n=== dev down %s (%s from %s) ===\n' \
        "$(date '+%F %T')" "${USER:-?}" "$(tty 2>/dev/null || print 'no terminal')" \
        >> $LOGDIR/$n.log
      tmux send-keys -t $SESSION:$n C-c 2>/dev/null
      sleep 0.4
      tmux kill-window -t $SESSION:$n 2>/dev/null
      say "${c_ok}▪${c_r} $n stopped"
    else
      say "${c_dim}· $n was not started${c_r}"
    fi
  done
}

cmd_restart() { cmd_down "$@"; sleep 1; cmd_up "$@" }

# The state, as JSON. A GUI, a script or an agent should never parse a table
# meant for the eye: the slightest added column would break it. The contract is
# here; `dev status` is only its human rendering.
cmd_status_json() {
  _collect
  local n first=1
  print "["
  for n in $P_ORDER; do
    # `local state` with no value would make zsh PRINT the variable from the
    # second iteration on, the previous one having defined it — and the JSON
    # would be corrupted by that stray line.
    local state="" port_up=false running=false
    _c_port_up $n && port_up=true
    _c_running $n && running=true

    if _is_service $n; then
      [[ $port_up == true ]] && state=service || state=down
    elif [[ $running == false ]]; then
      [[ $port_up == true ]] && state=external || state=stopped
    elif [[ $port_up == true ]]; then
      state=online
    elif _log_failed $n; then
      state=failed
    else
      state=starting
    fi

    local url=""
    url="$(_public_url $n)"

    (( first )) || print ","
    first=0
    printf '  {"name":"%s","group":"%s","state":"%s","host":"%s","port":%s,"url":"%s","branch":"%s","uptime":"%s","dir":"%s","ram_mb":%s}' \
      "$n" "$(_group $n)" "$state" "${P_HOST[$n]}" "${P_PORT[$n]:-0}" "$url" \
      "$(_c_branch $n)" "$(_c_age $n)" "${P_DIR[$n]}" "${COL_RSS[$n]:-0}"
  done
  print ""
  print "]"
}

# The processes that weigh, attributed to their project when possible.
#
# "The machine is slow" cannot be fixed without knowing WHAT is slow. So we walk
# up from each process to the tmux window that launched it, which gives the name
# of the project responsible rather than an anonymous "java".
cmd_top() {
  _collect
  local pid pcpu rss cmd root

  local -A parent
  while read -r pid rss; do
    [[ $pid == <-> ]] && parent[$pid]=$rss
  done < <(ps -eo pid=,ppid= 2>/dev/null)

  local -A pane_of
  local wname
  while read -r wname pid; do
    [[ -n $wname && $pid == <-> ]] && pane_of[$pid]=$wname
  done < <(tmux list-panes -a -F '#{window_name} #{pane_pid}' 2>/dev/null)

  print "["
  local first=1
  while read -r pid pcpu rss cmd; do
    [[ $pid == <-> ]] || continue
    # We climb the ancestry until we find a known pane, or the root.
    root=""
    local cur=$pid n=0
    while [[ -n $cur && $cur != 1 && $n -lt 40 ]]; do
      if [[ -n ${pane_of[$cur]:-} ]]; then root=${pane_of[$cur]}; break; fi
      cur=${parent[$cur]:-}
      (( n++ ))
    done
    (( first )) || print ","
    first=0
    printf '  {"pid":%s,"cpu":%s,"ram_mb":%s,"command":"%s","project":"%s"}' \
      "$pid" "$pcpu" "$(( rss / 1024 ))" "${${cmd//\\/}//\"/}" "$root"
  done < <(ps -eo pid=,pcpu=,rss=,comm= --sort=-pcpu 2>/dev/null | head -12)
  print ""
  print "]"
}

# The sessions that outlive whatever launched them.
#
# An agent — Claude, Codex — and a remote IDE backend keep living when their
# terminal disappears: app closed, ssh cut, IntelliJ window shut. They then hold
# their memory for nobody. A JetBrains backend weighs several gigabytes on its
# own.
_raw_sessions() {
  ps -eo pid=,etimes=,rss=,args= 2>/dev/null \
    | grep -E '\.claude/remote|ccd-cli|/claude$|/codex$|RemoteDev|remote-dev-server' \
    | grep -v grep
}

_session_kind() {
  case $1 in
    *RemoteDev*|*remote-dev-server*) print "ide" ;;
    *codex*)                          print "codex" ;;
    *)                                print "claude" ;;
  esac
}

cmd_sessions() {
  local sub=${1:-list}

  if [[ $sub == --json ]]; then
    print "["
    local first=1 pid age rss rest l
    while IFS= read -r l; do
      [[ -n $l ]] || continue
      pid=${${(z)l}[1]}; age=${${(z)l}[2]}; rss=${${(z)l}[3]}
      rest=${l#*$rss }
      (( first )) || print ","
      first=0
      printf '  {"pid":%s,"seconds":%s,"ram_mb":%s,"kind":"%s","command":"%s"}' \
        "$pid" "$age" "$(( rss / 1024 ))" "$(_session_kind $rest)" "${${rest:t}//\"/}"
    done < <(_raw_sessions)
    print ""
    print "]"
    return 0
  fi

  # Stopping one specific process, and only if it is one of the sessions: an
  # interface must never be able to kill any PID on the server.
  if [[ $sub == kill ]]; then
    local wanted=$2
    [[ $wanted == <-> ]] || { err "invalid PID"; return 1 }
    if ! _raw_sessions | awk '{print $1}' | grep -qx "$wanted"; then
      err "$wanted is not an agent or IDE session"
      return 1
    fi
    kill -TERM $wanted 2>/dev/null && say "${c_ok}▪${c_r} session $wanted stopped"
    return 0
  fi

  if [[ $sub == clean ]]; then
    local threshold=${2:-120} pid age killed=0 l
    while IFS= read -r l; do
      [[ -n $l ]] || continue
      pid=${${(z)l}[1]}; age=${${(z)l}[2]}
      (( age > threshold * 60 )) || continue
      kill -TERM $pid 2>/dev/null && (( killed++ ))
    done < <(_raw_sessions)
    say "${c_ok}▪${c_r} $killed session(s) older than ${threshold} min stopped"
    return 0
  fi

  say ""
  printf '  %-8s %-8s %-10s %-9s %s\n' PID KIND UPTIME MEMORY COMMAND
  local total=0 count=0 pid age rss rest l
  while IFS= read -r l; do
    [[ -n $l ]] || continue
    pid=${${(z)l}[1]}; age=${${(z)l}[2]}; rss=${${(z)l}[3]}
    rest=${l#*$rss }
    (( total += rss )); (( count++ ))
    printf '  %-8s %-8s %-10s %-9s %.40s\n' \
      "$pid" "$(_session_kind $rest)" "$(( age / 60 )) min" \
      "$(( rss / 1024 )) MB" "${rest:t}"
  done < <(_raw_sessions)
  say ""
  say "  ${c_dim}$count session(s), $(( total / 1048576 )) GB${c_r}"
  say "  ${c_dim}dev sessions clean [minutes] · dev sessions kill <pid>${c_r}"
  say ""
}

# The package managers `dev up` and `dev sync` know how to run.
#
# Pupitre offers this list in its form rather than one written on its own side:
# here, and nowhere else, is where we know what the server can do.
PACKAGE_MANAGERS=(bun pnpm npm gradle service none)

# The state of the declared services, in a single call to systemctl.
#
# A service whose unit is not loaded is not "inactive": it does not exist on this
# machine, and it has no business in the list. That is what lets the same stack
# run with a tunnel and a database, with one of the two, or with neither.
typeset -gA _SERVICE_STATES
typeset -g _SERVICES_READ=0

_read_services() {
  (( _SERVICES_READ )) && return
  _SERVICES_READ=1
  local -a declared=(${=STACK_SERVICES})
  (( $#declared )) || return
  local -a units
  local d
  for d in $declared; do units+=(${d##*:}) done

  local line id="" load="" active=""
  while IFS= read -r line; do
    case $line in
      Id=*)          id=${line#Id=} ;;
      LoadState=*)   load=${line#LoadState=} ;;
      ActiveState=*) active=${line#ActiveState=} ;;
      "")            [[ $load == loaded && -n $id ]] && _SERVICE_STATES[${id%.service}]=$active
                     id=""; load=""; active="" ;;
    esac
  done < <(systemctl show --property=Id --property=LoadState --property=ActiveState $units 2>/dev/null)
  # The last block is not followed by an empty line.
  [[ $load == loaded && -n $id ]] && _SERVICE_STATES[${id%.service}]=$active
}

# A service's state by its key — nothing, and a failure code, if it does not
# exist.
_service_state() {
  _read_services
  local d unit
  for d in ${=STACK_SERVICES}; do
    [[ ${d%%:*} == $1 ]] || continue
    unit=${d##*:}
    [[ -n ${_SERVICE_STATES[$unit]:-} ]] || return 1
    print -n ${_SERVICE_STATES[$unit]}
    return 0
  done
  return 1
}

_services_json() {
  _read_services
  local d key label unit state first=1 out="["
  for d in ${=STACK_SERVICES}; do
    key=${d%%:*}; label=${${d#*:}%%:*}; unit=${d##*:}
    state=${_SERVICE_STATES[$unit]:-}
    [[ -n $state ]] || continue
    (( first )) || out+=","
    first=0
    out+="$(printf '{"key":"%s","label":"%s","state":"%s","ok":%s}' \
      "$(_json_text $key)" "$(_json_text $label)" "$(_json_text $state)" \
      "$([[ $state == active ]] && print true || print false)")"
  done
  print -n "$out]"
}

# Everything an interface needs, in ONE round trip: the machine, the services and
# the projects. Two calls per second over SSH would cost twice one, for the same
# information.
cmd_snapshot() {
  # Everything is read from /proc and /sys rather than by running free, nproc and
  # uptime: those three alone cost more than collecting eleven projects.
  local -A mi
  local k v
  while read -r k v _; do mi[${k%:}]=$v; done < /proc/meminfo
  # The braces are essential: inside a $(( )), zsh evaluates the index as an
  # expression, so `mi[MemTotal]` would look for a variable named MemTotal.
  local mem_total=$(( ${mi[MemTotal]:-0} / 1024 ))
  local mem_avail=$(( ${mi[MemAvailable]:-0} / 1024 ))
  local mem_used=$(( mem_total - mem_avail ))
  local swap_used=$(( (${mi[SwapTotal]:-0} - ${mi[SwapFree]:-0}) / 1024 ))

  local load="$(cut -d' ' -f1-3 /proc/loadavg)"
  # /proc/uptime carries two numbers; we take the first by word splitting, since
  # nested suffix removal does not apply the way one would expect.
  local up_raw="$(</proc/uptime)"
  local up_s=${${(z)up_raw}[1]}
  local up_h=$(( ${up_s%.*} / 3600 ))

  local cores=0
  for k in /sys/devices/system/cpu/cpu<->(N); do (( cores++ )); done

  local disk="$(df -Pm / | awk 'NR==2{print $2, $4}')"

  # The raw CPU counters, not a percentage: the latter comes from the delta
  # between two readings, and the caller already polls in a loop. Computing it
  # here would mean sleeping for a second on every call.
  local cpu_line cpu_total=0 cpu_idle=0 field
  read -r cpu_line < /proc/stat
  local -a fields=(${=cpu_line})
  for field in ${fields[2,-1]}; do (( cpu_total += field )); done
  (( cpu_idle = ${fields[5]:-0} + ${fields[6]:-0} ))

  # A single call to systemctl for all the services: querying it costs some
  # twenty milliseconds, and Pupitre polls every second and a half. The reading
  # therefore happens here, in this shell, so that the substitutions that follow
  # find it already done.
  _read_services
  local services="$(_services_json)"

  print "{"
  printf '  "machine": {"ram_total_mb":%s,"ram_used_mb":%s,"ram_free_mb":%s,"swap_mb":%s,"load":"%s","disk_total_mb":%s,"disk_free_mb":%s,"cores":%s,"uptime_hours":%s,"cpu_total":%s,"cpu_idle":%s},\n' \
    "$mem_total" "$mem_used" "$mem_avail" "$swap_used" "$load" \
    "${disk%% *}" "${disk##* }" "$cores" "$up_h" "$cpu_total" "$cpu_idle"
  # The projects root comes from here, never from a constant on the client side:
  # a console has to be able to drive a server that keeps its projects elsewhere.
  printf '  "root": "%s",\n' "$PROJECTS_DIR"
  # What this machine runs, named by it. Pupitre displays it as is: it does not
  # have to know about Cloudflare, MySQL, or whatever replaces them.
  printf '  "services": %s,\n' "$services"
  printf '  "package_managers": %s,\n' "$(_json_list $PACKAGE_MANAGERS)"
  print '  "projects":'
  cmd_status_json | sed 's/^/  /'
  print "}"
}

cmd_status() {
  _collect
  say ""
  say " ${c_hi}${STACK_NAME}${c_r}  ${c_dim}$(uptime -p 2>/dev/null | sed 's/^up //')  ·  load$(cut -d' ' -f1-3 /proc/loadavg | sed 's/^/ /')  ·  RAM $(free -g | awk '/^Mem:/{print $3"/"$2" GB"}')${c_r}"
  # This machine's services, whatever they are — and nothing at all when it
  # declares none.
  _read_services
  local d line="" key label unit
  for d in ${=STACK_SERVICES}; do
    key=${d%%:*}; label=${${d#*:}%%:*}; unit=${d##*:}
    [[ -n ${_SERVICE_STATES[$unit]:-} ]] || continue
    line+="${line:+  ·  }${label:l} ${_SERVICE_STATES[$unit]}"
  done
  [[ -n $line ]] && say " ${c_dim}${line}${c_r}"
  say ""
  printf '  %-18s %-8s %-9s %-22s %s\n' PROJECT STATE UPTIME LOCAL PUBLIC
  local n st
  for n in $P_ORDER; do
    if _is_service $n; then
      _c_port_up $n && st="${c_ok}service${c_r}" || st="${c_no}service down${c_r}"
    elif _c_running $n && _c_port_up $n;  then st="${c_ok}online${c_r}"
    elif _c_running $n && _log_failed $n; then st="${c_no}failed${c_r}"
    elif _c_running $n;                 then st="${c_w}starting${c_r}"
    # The port answers with no tmux window: someone started the service another
    # way — an IntelliJ run configuration, typically. So it really is running,
    # and calling it "stopped" would be false; but `dev down` has no grip on it,
    # hence a distinct state rather than a misleading "online".
    elif _c_port_up $n;               then st="${c_ok}external${c_r}"
    else                                   st="${c_dim}stopped${c_r}"
    fi
    local url="${c_dim}—${c_r}" public=""
    public="$(_public_url $n)" && url="$public"
    local since="$(_c_age $n)"
    [[ -n $since ]] || since="—"
    print -P "  $(printf '%-18s' $n) $(printf '%-17s' $st) ${c_dim}$(printf '%-9s' $since)${c_r} $(printf '%-22s' ${P_HOST[$n]}:${P_PORT[$n]}) ${c_dim}$url${c_r}"
  done
  say ""
}

cmd_attach() {
  _need_tty attach "dev-attach" || return 1
  _ensure_session
  if [[ -n $1 ]]; then
    _known $1 || { err "unknown project: $1"; return 1 }
    _running $1 || { err "$1 is not started (dev up $1)"; return 1 }
    exec tmux attach -t $SESSION \; select-window -t $SESSION:$1
  fi
  exec tmux attach -t $SESSION
}

cmd_logs() {
  local n=$1; shift
  [[ -n $n ]] || { err "usage: dev logs <project> [-f]"; return 1 }
  _known $n || { err "unknown project: $n"; return 1 }
  local f=$LOGDIR/$n.log
  [[ -f $f ]] || { err "no log for $n (never started?)"; return 1 }
  if [[ $1 == -f ]]; then tail -f $f; else tail -n ${1:-120} $f; fi
}

cmd_sync() {
  local n
  for n in $(_targets "$@") ; do
    local wd=$(_wd $n) root=$PROJECTS_DIR/${${P_DIR[$n]}%%/*}
    if [[ ! -d $root/.git ]]; then
      [[ ${P_REPO[$n]} == "-" ]] && continue
      say "${c_dim}cloning $n…${c_r}"
      git clone --recurse-submodules ${P_REPO[$n]} $root || { err "$n: cannot clone"; continue }
    else
      say "${c_dim}$n: git pull${c_r}"
      git -C $root pull --rebase --autostash || err "$n: pull conflict — resolve it by hand"
    fi
    _install_one $n
    say "${c_ok}✓${c_r} $n up to date"
  done
}

# Installs a project's dependencies, and says with which command.
#
# The command is printed before it runs: that is the whole point — you should
# never have to guess how a project's dependencies were installed.
_install_one() {
  local n=$1 wd=$(_wd $n)
  local cmd="$(_install_cmd $n)"
  if [[ -z $cmd ]]; then
    say "${c_dim}· $n: nothing to install (${P_PKG[$n]})${c_r}"
    return 0
  fi
  say "${c_dim}$n: $cmd${c_r}"
  (cd $wd && eval "$cmd")
}

cmd_install() {
  local n
  for n in $(_targets "$@") ; do
    local wd=$(_wd $n)
    [[ -d $wd ]] || { err "$n: folder missing ($wd) — dev sync $n first"; continue }
    _install_one $n && say "${c_ok}✓${c_r} $n installed"
  done
}

cmd_url() {
  local n
  for n in $(_targets "$@") ; do
    printf '%-18s %s\n' $n "$(_url $n)"
  done
}

# (Re)generates a project's .env.local. Delegates to dev-env, the same
# implementation the provisioning uses.
cmd_env() {
  local n=${1:-all}
  local -a targets
  if [[ $n == all ]]; then targets=(${(f)"$(_targets all)"}); else targets=($n); fi
  [[ -f $HOME/.config/dev-stack.env ]] && source $HOME/.config/dev-stack.env
  local p
  for p in $targets; do
    _known $p || { err "unknown project: $p"; continue }
    _is_service $p && continue
    local wd=$(_wd $p) root=$PROJECTS_DIR/${${P_DIR[$p]}%%/*}
    [[ -d $wd ]] || { err "$p: folder missing"; continue }
    FORCE=${FORCE:-0} dev-env $wd $root $p
  done
}

# JSON string escaping, used everywhere below.
_json_text() {
  local t=${1//\\/\\\\}
  t=${t//\"/\\\"}
  print -rn -- ${t//$'\n'/ }
}

_json_list() {
  local first=1 e
  print -n "["
  for e in "$@"; do
    (( first )) || print -n ","
    first=0
    printf '"%s"' "$(_json_text $e)"
  done
  print -n "]"
}

# The keys THIS machine expects, and only those.
#
# Listing CLOUDFLARE_API_TOKEN as "missing" on a machine with no tunnel would be
# a reproach with no object: Pupitre would show a permanent fault for a service
# nobody asked for. Each group of keys therefore follows the service that reads
# them, and STACK_SECRETS_KEYS adds those of a machine that does something else.
EXPECTED_SECRETS=(SSH_PUBLIC_KEY)
[[ $STACK_GIT == github ]] && EXPECTED_SECRETS+=(GITHUB_TOKEN)
[[ $STACK_TUNNEL == cloudflare ]] && EXPECTED_SECRETS+=(
  CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_ZONE_ID)
[[ $STACK_SECRETS == 1password ]] && EXPECTED_SECRETS+=(
  OP_SERVICE_ACCOUNT_TOKEN OP_VAULT)
[[ -n ${NEON_API_KEY:-} || ${STACK_NEON:-} == yes ]] && EXPECTED_SECRETS+=(NEON_API_KEY)
EXPECTED_SECRETS+=(CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY OPENAI_API_KEY)
_with_database && EXPECTED_SECRETS+=(
  MYSQL_APP_PASSWORD MYSQL_REMOTE_USER MYSQL_REMOTE_PASSWORD)
EXPECTED_SECRETS+=(${=STACK_SECRETS_KEYS:-})

# The keys whose value must never leave the server, not even truncated.
SENSITIVE_SECRETS=(
  GITHUB_TOKEN CLOUDFLARE_API_TOKEN OP_SERVICE_ACCOUNT_TOKEN NEON_API_KEY
  CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY OPENAI_API_KEY
  MYSQL_APP_PASSWORD MYSQL_REMOTE_PASSWORD
)

# The state of the secrets, never their value.
#
# We say whether a key is set, and its length — enough to spot a truncated value
# or one pasted wrong — but never its content. A token that gets displayed is a
# token that ends up in a screenshot, a log or a clipboard.
cmd_secrets_state() {
  local file=/etc/dev-stack.env
  local -a expected=($EXPECTED_SECRETS) sensitive=($SENSITIVE_SECRETS)

  # The file belongs to root with mode 600: that is deliberate, and that is why
  # reading goes through sudo. The values do not leave this function.
  local -A value
  local l key v
  while IFS= read -r l; do
    [[ $l == [A-Z_]*=* ]] || continue
    key=${l%%=*}; v=${l#*=}
    if [[ $v == \"* ]]; then
      v=${${v#\"}%%\"*}
    else
      v=${v%%[[:space:]]#*}
    fi
    value[$key]=$v
  done < <(sudo cat $file 2>/dev/null)

  print "["
  local first=1 k is_sensitive is_set preview
  for k in $expected; do
    is_sensitive=false
    (( ${sensitive[(I)$k]} )) && is_sensitive=true
    is_set=false
    [[ -n ${value[$k]:-} ]] && is_set=true

    preview=""
    if [[ $is_sensitive == false ]]; then
      preview=${value[$k]:-}
      (( ${#preview} > 44 )) && preview="${preview[1,44]}…"
    fi

    (( first )) || print ","
    first=0
    printf '  {"key":"%s","set":%s,"length":%s,"sensitive":%s,"preview":"%s"}' \
      "$k" "$is_set" "${#value[$k]}" "$is_sensitive" "$(_json_text $preview)"
  done
  print ""
  print "]"
}

# Replaces a secret. The value arrives on STANDARD INPUT, never as an argument:
# an argument is readable in `ps` by any user on the machine.
cmd_secrets_set() {
  local key=$1
  # The file is read as root by the services: only stack keys go into it.
  (( ${EXPECTED_SECRETS[(I)$key]} )) || { err "unknown key: $key"; return 1 }
  local value; IFS= read -r value
  [[ -n $value ]] || { err "empty value"; return 1 }

  local file=/etc/dev-stack.env tmp=$(mktemp)
  sudo cat $file > $tmp 2>/dev/null || : >$tmp
  grep -v "^${key}=" $tmp > ${tmp}.2 2>/dev/null || : > ${tmp}.2
  printf '%s="%s"\n' "$key" "$value" >> ${tmp}.2
  sudo install -m 600 -o root -g root ${tmp}.2 $file
  rm -f $tmp ${tmp}.2

  say "${c_ok}✓${c_r} $key saved"
  say "${c_dim}  to apply:  sudo /opt/dev-stack/bootstrap.sh --only=user${c_r}"
}

cmd_secrets() {
  [[ $1 == --json ]] && { cmd_secrets_state; return }
  [[ $1 == set ]] && { shift; cmd_secrets_set "$@"; return }
  local n=${1:?usage: dev secrets <project> | --json | set <KEY>}
  _known $n || { err "unknown project: $n"; return 1 }
  local root=$PROJECTS_DIR/${${P_DIR[$n]}%%/*}

  case $STACK_SECRETS in
    1password)
      [[ -f $HOME/.config/op.env ]] && source $HOME/.config/op.env
      op whoami >/dev/null 2>&1 \
        || { err "1Password not authenticated — check OP_SERVICE_ACCOUNT_TOKEN"; return 1 }
      if [[ -f $root/op.config.json ]]; then
        (cd $root && bun run op:sync 2>/dev/null || bun scripts/op-sync.ts) \
          && say "${c_ok}✓${c_r} secrets for $n resynchronised from 1Password"
      else
        err "$n has no op.config.json — nothing to synchronise"
      fi
      ;;
    none|"")
      err "this machine has no secret manager"
      say "${c_dim}  the .env.local in $root has to be filled in by hand,${c_r}"
      say "${c_dim}  or declare SECRETS_PROVIDER in /etc/dev-stack.env${c_r}"
      return 1
      ;;
    *)
      err "unknown secret manager: $STACK_SECRETS"
      return 1
      ;;
  esac
}

# Every command goes through `sudo mysql`: root@localhost has stayed on socket
# authentication, so there is no password to know nor to pass on a command line
# (where it would be visible in `ps`).
cmd_db() {
  local sub=${1:-shell}; shift 2>/dev/null

  if ! _with_database; then
    err "this machine has no local database"
    say "${c_dim}  DATABASE_ENGINE in /etc/dev-stack.env, then  sudo $STACK/bootstrap.sh --only=database${c_r}"
    return 1
  fi

  # The first declared database is the default: that is the one you land on by
  # typing "dev db" with no argument, and no name is written here.
  local default=${${=MYSQL_DATABASES:-}[1]:-}
  if [[ -z $default && $sub != url ]]; then
    err "no database declared — set MYSQL_DATABASES, or name it: dev db shell <name>"
    return 1
  fi

  case $sub in
    shell)  sudo mysql ${1:-$default} ;;
    url)    print "mysql://${MYSQL_REMOTE_USER:-$USER}@127.0.0.1:3306/${1:-$default}"
            say "${c_dim}From your machine, through the LocalForward: mysql -h 127.0.0.1 -P 3307 -u ${MYSQL_REMOTE_USER:-$USER} -p ${1:-$default}${c_r}" ;;
    dump)   local out=${1:-$HOME/dumps/${default}_$(date +%Y%m%d-%H%M).sql}
            mkdir -p ${out:h}
            sudo mysqldump --single-transaction --routines --events \
              --default-character-set=utf8mb4 ${2:-$default} > $out \
              && say "${c_ok}✓${c_r} dump of ${2:-$default} written: $out ($(du -h $out | cut -f1))" ;;
    import) local f=${1:?usage: dev db import <file.sql> [database]}
            [[ -f $f ]] || { err "file not found: $f"; return 1 }
            say "${c_dim}importing (this can take several minutes)…${c_r}"
            sudo mysql ${2:-$default} < $f \
              && say "${c_ok}✓${c_r} database ${2:-$default} restored from $f" ;;
    *)      err "dev db <shell|url|dump|import>" ; return 1 ;;
  esac
}

cmd_agent() {  # dev claude <project>  /  dev codex <project>
  local bin=$1 n=$2
  [[ -n $n ]] || { err "usage: dev $bin <project>"; return 1 }
  _need_tty "$bin $n" "dev-$bin $n" || return 1
  _known $n || { err "unknown project: $n"; return 1 }
  [[ -f $HOME/.config/op.env ]] && source $HOME/.config/op.env
  _ensure_session
  local win="${bin}:${n}"
  if ! tmux list-windows -t $SESSION -F '#W' | grep -qx "$win"; then
    tmux new-window -d -t $SESSION -n $win -c $(_wd $n)
    tmux send-keys -t $SESSION:$win "$bin" C-m
  fi
  exec tmux attach -t $SESSION \; select-window -t $SESSION:$win
}

# These commands take over the screen: with no terminal attached, tmux can do
# nothing. The case arises as soon as they are run through `ssh server "cmd"`
# instead of `ssh -t`.
_need_tty() {
  [[ -t 1 ]] && return 0
  err "\"dev $1\" needs a terminal."
  err "  From your machine:  ssh -t <host> 'dev $1'   (or the alias: $2)"
  return 1
}

cmd_tui() {
  _need_tty tui "dev-tui" || return 1
  command -v dev-tui >/dev/null || { err "dev-tui missing — rerun bootstrap.sh --only=tooling"; return 1 }
  # Directly, in this terminal. The dashboard's actions (shell, agent, logs) also
  # run in the foreground and hand control back on exit: nothing to know about
  # tmux, impossible to get stuck anywhere.
  exec dev-tui
}

# The gallery's base URL, which depends on what the machine has: the public
# address when there is a tunnel and a domain, its local port otherwise.
_shots_base() {
  if _with_tunnel && [[ -n $DEV_DOMAIN ]]; then
    print -n "https://shots.${DEV_DOMAIN}"
  else
    print -n "http://127.0.0.1:${SHOTS_PORT:-8099}"
  fi
}

cmd_shots() {
  local base="$(_shots_base)"
  case ${1:-list} in
    list|ls)
      local root=${SHOTS_DIR:-$HOME/shots}
      shot --list 2>/dev/null | while read -r f; do
        printf '%-46s %s\n' "${f:t}" "$base/${f#$root/}"
      done ;;
    url)     print $base ;;
    add)     shift; shot "$@" ;;
    clean)   local days=${2:-14} root=${SHOTS_DIR:-$HOME/shots}
             find $root -type f -mtime +$days -delete 2>/dev/null
             find $root -mindepth 1 -type d -empty -delete 2>/dev/null
             say "${c_ok}✓${c_r} shots older than $days days deleted" ;;
    restart) sudo systemctl restart dev-shots && say "${c_ok}✓${c_r} gallery restarted" ;;
    *)       err "dev shots <list|url|add|clean|restart>" ;;
  esac
}

# The root of a project's repository. Several projects sometimes share the same
# repository: it is the FIRST segment of `dir` that holds the .git, never the
# whole path.
_repo_root() { print $PROJECTS_DIR/${${P_DIR[$1]}%%/*} }

_branch() { git -C $(_repo_root $1) rev-parse --abbrev-ref HEAD 2>/dev/null }

_dirty() { [[ -n $(git -C $(_repo_root $1) status --porcelain 2>/dev/null) ]] }

# Stops a specifically named process.
#
# Pupitre can target any row of `dev top`, including a Gradle daemon or a watcher
# gone mad. Three guardrails: the process must belong to us, must not be what
# carries the session (tmux, sshd, a pane's shell — those stop through
# `dev down`), and must not be an ancestor of this command, otherwise we would
# cut the channel the order arrived through.
cmd_kill() {
  local pid=${1:?usage: dev kill <pid> [--force]}
  [[ $pid == <-> ]] && (( pid > 1 )) || { err "invalid PID: $pid"; return 1 }

  local owner comm
  read -r owner comm < <(ps -o user=,comm= -p $pid 2>/dev/null)
  [[ -n $comm ]] || { err "no process $pid"; return 1 }
  [[ $owner == $(id -un) ]] || { err "$pid belongs to $owner"; return 1 }

  case ${comm:t} in
    tmux*|sshd|systemd|init|zsh|bash|sh|login)
      err "refused: $comm carries the session — use dev down"; return 1 ;;
  esac

  local cur=$$ n=0
  while [[ -n $cur && $cur != 1 && $n -lt 40 ]]; do
    [[ $cur == $pid ]] && { err "refused: $pid is a parent of this command"; return 1 }
    cur=$(ps -o ppid= -p $cur 2>/dev/null | tr -d ' ')
    (( n++ ))
  done

  kill -TERM $pid 2>/dev/null || { err "could not stop $pid"; return 1 }
  say "${c_ok}▪${c_r} $comm ($pid) stopped"

  if [[ $2 == --force ]]; then
    sleep 2
    if kill -0 $pid 2>/dev/null; then
      kill -KILL $pid 2>/dev/null
      say "${c_dim}  did not answer the signal: killed${c_r}"
    fi
  fi
}

cmd_branches() {
  local n=${1:?usage: dev branches <project>}
  _known $n || { err "unknown project: $n"; return 1 }
  local root=$(_repo_root $n)

  if [[ ! -d $root/.git ]]; then
    print '{"repo":false,"root":"","current":"","dirty":false,"local":[],"remote":[]}'
    return
  fi

  local current=$(git -C $root rev-parse --abbrev-ref HEAD 2>/dev/null)
  local dirty=false
  [[ -n $(git -C $root status --porcelain 2>/dev/null) ]] && dirty=true

  local -a locals remotes
  locals=(${(f)"$(git -C $root for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
  remotes=(${(f)"$(git -C $root for-each-ref --format='%(refname:short)' refs/remotes/origin 2>/dev/null)"})
  remotes=(${remotes#origin/})
  # refs/remotes/origin/HEAD shortens to "origin": that is not a branch.
  remotes=(${remotes:#origin})
  remotes=(${remotes:#HEAD})
  remotes=(${remotes:#})

  printf '{"repo":true,"root":"%s","current":"%s","dirty":%s,"local":%s,"remote":%s}\n' \
    "$(_json_text ${root#$PROJECTS_DIR/})" "$(_json_text $current)" "$dirty" \
    "$(_json_list $locals)" "$(_json_list $remotes)"
}

# The registry as it stands, so Pupitre can show it and edit it.
cmd_projects() {
  print "["
  local first=1 n root has_repo
  for n in $P_ORDER; do
    root=$(_repo_root $n)
    has_repo=false
    [[ -d $root/.git ]] && has_repo=true
    (( first )) || print ","
    first=0
    # A local row may shadow one from the repository: removing it then does not
    # delete the project, it restores it to its original version. The interface
    # has to be able to say so rather than offering a deletion that is not one.
    printf '  {"name":"%s","dir":"%s","repo_url":"%s","package_manager":"%s","host":"%s","port":%s,"subdomain":"%s","command":"%s","install":"%s","install_effective":"%s","origin":"%s","overrides":%s,"repo":%s,"present":%s}' \
      "$(_json_text $n)" "$(_json_text ${P_DIR[$n]})" "$(_json_text ${P_REPO[$n]})" \
      "$(_json_text ${P_PKG[$n]})" "$(_json_text ${P_HOST[$n]})" "${P_PORT[$n]}" \
      "$(_json_text ${P_SUB[$n]})" "$(_json_text ${P_CMD[$n]})" \
      "$(_json_text ${P_INSTALL[$n]:-})" "$(_json_text "$(_install_cmd $n)")" "${P_ORIGIN[$n]}" \
      "$(grep -q "^${n}|" $CONF 2>/dev/null && print true || print false)" \
      "$has_repo" \
      "$([[ -d $PROJECTS_DIR/${P_DIR[$n]} ]] && print true || print false)"
  done
  print ""
  print "]"
}

# Adds or fixes a project. The row arrives on standard input, in the exact
# registry format — the same one documented in projects.conf, so that an agent
# can write it without learning a second syntax.
_project_write() {
  local row
  IFS= read -r row || { err "no row on standard input"; return 1 }
  row=${row%%$'\r'}

  local -a fields
  fields=("${(@s:|:)row}")
  # Nine fields with the install command, eight without: the column was added
  # later, and a row written before it exists is still a valid row.
  (( ${#fields} == 8 || ${#fields} == 9 )) \
    || { err "8 or 9 fields expected, ${#fields} received"; return 1 }

  local name=${fields[1]} dir=${fields[2]} repo=${fields[3]} pkg=${fields[4]}
  local host=${fields[5]} port=${fields[6]##*:} sub=${fields[7]} cmd=${fields[8]}

  [[ $name == [a-z0-9]* && $name != *[^a-z0-9._-]* ]] \
    || { err "invalid name: lowercase letters, digits, dot, dash and underscore"; return 1 }
  [[ $dir != /* && $dir != *..* ]] \
    || { err "invalid folder: a path relative to $PROJECTS_DIR, without .."; return 1 }
  [[ $port == <-> ]] && (( port >= 1024 && port <= 65535 )) \
    || { err "invalid port: $port"; return 1 }

  local n
  for n in $P_ORDER; do
    [[ $n == $name ]] && continue
    [[ ${P_PORT[$n]} == $port ]] && { err "port $port already taken by $n"; return 1 }
    [[ $sub != - && ${P_SUB[$n]} == $sub ]] && { err "subdomain $sub already taken by $n"; return 1 }
  done

  local tmp=$(mktemp)
  sudo cat $CONF_LOCAL 2>/dev/null | grep -v "^${name}|" > $tmp
  if [[ ! -s $tmp ]]; then
    print "# Projects added from Pupitre or by an agent." > $tmp
    print "# This file survives deployments: deploy.sh never touches it." >> $tmp
    sudo cat $CONF_LOCAL 2>/dev/null | grep -v "^#" | grep -v "^${name}|" | grep . >> $tmp
  fi
  print -r -- "$row" >> $tmp
  sudo install -m 644 -o root -g root $tmp $CONF_LOCAL
  rm -f $tmp

  say "${c_ok}✓${c_r} $name registered in $CONF_LOCAL"

  local root=$PROJECTS_DIR/${dir%%/*}
  if [[ ! -d $root ]]; then
    if [[ $repo == - || -z $repo ]]; then
      mkdir -p $root && say "${c_ok}✓${c_r} folder created: $root"
    else
      say "${c_dim}  cloning $repo…${c_r}"
      git clone --quiet "$repo" $root \
        && say "${c_ok}✓${c_r} repository cloned into $root" \
        || { err "the clone failed — check the URL and your access"; return 1 }
    fi
  fi
  [[ -d $PROJECTS_DIR/$dir ]] || mkdir -p $PROJECTS_DIR/$dir

  if [[ $sub != - && -n $sub ]] && _with_tunnel; then
    say "${c_dim}  updating the tunnel…${c_r}"
    sudo $STACK/bootstrap.sh --only=tunnel >/dev/null 2>&1 \
      && say "${c_ok}✓${c_r} https://${sub}.${DEV_DOMAIN} routed" \
      || err "the tunnel could not be regenerated — dev tunnel sync"
  elif [[ $sub != - && -n $sub ]]; then
    say "${c_dim}  subdomain ignored: this machine has no tunnel${c_r}"
  fi
  say "${c_dim}  local address: http://${host}:${port}${c_r}"

  say "${c_dim}  dependencies:  dev sync $name${c_r}"
}

_project_remove() {
  local name=${1:?usage: dev project remove <name>}
  _known $name || { err "unknown project: $name"; return 1 }
  if [[ ${P_ORIGIN[$name]} != local ]]; then
    err "$name comes from the stack repository — remove its row from projects.conf, then ./deploy.sh projects"
    return 1
  fi

  _running $name && cmd_down $name

  local tmp=$(mktemp)
  sudo cat $CONF_LOCAL 2>/dev/null | grep -v "^${name}|" > $tmp
  sudo install -m 644 -o root -g root $tmp $CONF_LOCAL
  rm -f $tmp

  say "${c_ok}✓${c_r} $name removed from the registry"
  say "${c_dim}  the folder $PROJECTS_DIR/${P_DIR[$name]} is untouched${c_r}"
  [[ ${P_SUB[$name]} != - ]] && _with_tunnel \
    && sudo $STACK/bootstrap.sh --only=tunnel >/dev/null 2>&1
  return 0
}

cmd_project() {
  case ${1:-} in
    add|set)  shift; _project_write "$@" ;;
    remove|rm) shift; _project_remove "$@" ;;
    --json)   cmd_projects ;;
    *) err "dev project <add|remove <name>|--json>"; return 1 ;;
  esac
}

cmd_branch() {
  local n=$1 target=$2

  # No argument: each repository's branch, one line per repository.
  if [[ -z $n ]]; then
    local -A seen
    say ""
    printf '  %-16s %-28s %s\n' REPOSITORY BRANCH STATE
    for n in $P_ORDER; do
      # The screenshot gallery is a stack service, not a cloned repository.
      _is_service $n && continue
      local root=$(_repo_root $n) repo=${${P_DIR[$n]}%%/*}
      [[ -n ${seen[$repo]:-} ]] && continue
      seen[$repo]=1
      [[ -d $root/.git ]] || { print -P "  ${(r:16:)repo} ${c_dim}not a git repository${c_r}"; continue }
      # `local st` with no value would make zsh PRINT the variable from the
      # second iteration on, the previous one having already defined it.
      local b=$(_branch $n) st=""
      _dirty $n && st="${c_w}dirty${c_r}" || st="${c_dim}clean${c_r}"
      print -P "  ${(r:16:)repo} ${c_hi}${(r:28:)b}${c_r} $st"
    done
    say ""
    say "  ${c_dim}dev branch <project>          the available branches${c_r}"
    say "  ${c_dim}dev branch <project> <name>   switch to it (created if missing)${c_r}"
    return 0
  fi

  _known $n || { err "unknown project: $n"; return 1 }
  local root=$(_repo_root $n)
  [[ -d $root/.git ]] || { err "$n: $root is not a git repository"; return 1 }

  # One argument: we show, we touch nothing.
  if [[ -z $target ]]; then
    say ""
    say "  ${c_hi}${${P_DIR[$n]}%%/*}${c_r} ${c_dim}·${c_r} branch ${c_ok}$(_branch $n)${c_r}"
    _dirty $n && say "  ${c_w}uncommitted changes${c_r}"
    say ""
    git -C $root branch --format='  %(if)%(HEAD)%(then)* %(else)  %(end)%(refname:short)' | head -30
    say ""
    say "  ${c_dim}dev branch $n <name>   to switch${c_r}"
    return 0
  fi

  # Two arguments: we switch. A dirty repository is never forced — git would
  # refuse on its own, so we may as well say it first and clearly.
  if _dirty $n; then
    err "$root has uncommitted changes — commit, stash, or sort them out first"
    git -C $root status --short | head -10
    return 1
  fi

  git -C $root fetch --quiet origin 2>/dev/null

  if git -C $root show-ref --verify --quiet "refs/heads/$target"; then
    git -C $root checkout --quiet "$target" || return 1
    say "${c_ok}▸${c_r} $(basename $root) on ${c_hi}$target${c_r}"
  elif git -C $root show-ref --verify --quiet "refs/remotes/origin/$target"; then
    git -C $root checkout --quiet -b "$target" --track "origin/$target" || return 1
    say "${c_ok}▸${c_r} $(basename $root) now tracks ${c_hi}origin/$target${c_r}"
  else
    git -C $root checkout --quiet -b "$target" || return 1
    say "${c_ok}▸${c_r} $(basename $root): branch ${c_hi}$target${c_r} created"
  fi

  # Running projects are still serving the old code.
  local other running=()
  for other in $P_ORDER; do
    [[ $(_repo_root $other) == $root ]] || continue
    _running $other && running+=$other
  done
  (( $#running )) && say "  ${c_w}to restart:${c_r} dev restart ${running}"
  say "  ${c_dim}dependencies: dev sync $n${c_r}"
}

# The JVM debug port of each debuggable project, declared in
# /etc/dev-stack.env as DEBUG_PORTS="project:port project:port".
#
# Nothing is hard-coded: which projects run on a JVM, and on which port, is a
# property of the machine's registry — not of this script.
typeset -A DEBUG_PORT
_load_debug_ports() {
  local entry
  for entry in ${=DEBUG_PORTS:-}; do
    [[ $entry == *:* ]] || continue
    DEBUG_PORT[${entry%%:*}]=${entry##*:}
  done
}
_load_debug_ports

# Restarts a project with the JVM debug agent, then says how to attach to it. The
# port only listens on the loopback: it comes back through the SSH tunnel, like
# the database — nothing new to open on the firewall.
cmd_debug() {
  local n=$1
  if [[ -z $n ]]; then
    say ""
    if (( ${#DEBUG_PORT} == 0 )); then
      say " ${c_dim}No debuggable project declared.${c_r}"
      say " ${c_dim}Add DEBUG_PORTS=\"my-api:5005\" to /etc/dev-stack.env,${c_r}"
      say " ${c_dim}then:  sudo $STACK/bootstrap.sh --only=tooling${c_r}"
      say ""
      return 0
    fi
    say " ${c_hi}Debuggable projects${c_r}"
    local k
    for k in ${(k)DEBUG_PORT}; do
      printf '   %-14s port %s\n' "$k" "${DEBUG_PORT[$k]}"
    done
    say ""
    say "  ${c_dim}dev debug <project>      restart with the debug agent${c_r}"
    say "  ${c_dim}dev debug <project> off  back to a normal start${c_r}"
    return 0
  fi

  _known $n || { err "unknown project: $n"; return 1 }
  local port=${DEBUG_PORT[$n]:-}
  [[ -n $port ]] || {
    err "$n exposes no JVM debug port"
    say "${c_dim}  declare it:  DEBUG_PORTS=\"$n:5005\" in /etc/dev-stack.env${c_r}"
    return 1
  }

  if [[ $2 == off ]]; then
    cmd_down $n >/dev/null
    cmd_up $n
    say "  ${c_dim}$n restarted without the debug agent${c_r}"
    return 0
  fi

  cmd_down $n >/dev/null 2>&1
  _ensure_session
  local wd=$(_wd $n)
  tmux new-window -d -t $SESSION -n $n -c $wd
  tmux pipe-pane -o -t $SESSION:$n "cat >> $LOGDIR/$n.log"
  printf '\n=== dev debug %s (port %s) ===\n' "$(date '+%F %T')" "$port" >> $LOGDIR/$n.log
  tmux send-keys -t $SESSION:$n \
    "clear; print -P '${c_dim}$n — debugging on $port${c_r}'; ${P_CMD[$n]} -PdebugPort=$port" C-m

  say ""
  say "${c_ok}▸${c_r} $n restarted, debug agent on ${c_hi}$port${c_r}"
  say ""
  say " ${c_hi}In your IDE, on your own machine${c_r}"
  say "   A remote JVM debug configuration:"
  printf '   %-14s %s\n' "Host" "127.0.0.1"
  printf '   %-14s %s\n' "Port" "$port"
  printf '   %-14s %s\n' "Module" "$n"
  say ""
  say "  ${c_dim}The port arrives through the SSH tunnel — keep a session open.${c_r}"
  say "  ${c_dim}The app does not freeze at startup: attach whenever you like.${c_r}"
  say ""
}

# Reboots the machine. The use case is simple: after a few days, the JVMs, the
# Vite watchers and the page cache have eaten the RAM, and nothing gives it back.
# A reboot frees it in a minute.
#
# Nothing important lives here: the code is in git, the SaaS databases at their
# host, the secrets in the secret manager. Only the local database and the caches
# are local, and the database is stopped cleanly by the system.
cmd_reboot() {
  local mem_total mem_used mem_avail
  read -r mem_total mem_used mem_avail <<<"$(free -m | awk '/^Mem:/{print $2, $3, $7}')"
  local swap_used=$(free -m | awk '/^Swap:/{print $3}')

  say ""
  say " ${c_hi}Memory${c_r}"
  printf '   %-12s %s\n' "used" "$((mem_used / 1024)) GB / $((mem_total / 1024)) GB"
  printf '   %-12s %s\n' "available" "$((mem_avail / 1024)) GB"
  printf '   %-12s %s\n' "swap" "${swap_used} MB"
  say ""

  # What is running will go down: better say so first, and know what to restart.
  local n running=()
  for n in $P_ORDER; do
    _is_service $n || { _running $n && running+=$n }
  done
  if (( $#running )); then
    say " ${c_w}will be stopped:${c_r} ${running}"
    say " ${c_dim}after the reboot:  dev up ${running}${c_r}"
  else
    say " ${c_dim}no project is running${c_r}"
  fi
  say ""

  if [[ $1 != --yes ]]; then
    print -n "Reboot the server now? [y/N] "
    read -q reply || true
    print ""
    [[ $reply == [yY] ]] || { say "${c_dim}cancelled${c_r}"; return 0 }
  fi

  say "${c_ok}▸${c_r} rebooting — the server comes back in about a minute"
  say "${c_dim}  your SSH session will drop, that is expected.${c_r}"
  sudo systemctl reboot
}

cmd_tunnel() {
  local unit="$(_unit_of tunnel)"
  if ! _with_tunnel || [[ -z $unit ]]; then
    err "this machine has no tunnel"
    say "${c_dim}  projects are reached on their port, through ssh -L${c_r}"
    say "${c_dim}  TUNNEL_PROVIDER in /etc/dev-stack.env to set one up${c_r}"
    return 1
  fi
  case ${1:-status} in
    status)  systemctl status $unit --no-pager -n 15 ;;
    restart) sudo systemctl restart $unit && say "${c_ok}✓${c_r} tunnel restarted" ;;
    sync)    sudo $STACK/bootstrap.sh --only=tunnel ;;
    *)       err "dev tunnel <status|restart|sync>" ;;
  esac
}

cmd_doctor() {
  say ""
  local n bad=0
  chk() { if eval "$2" &>/dev/null; then print -P "  ${c_ok}✓${c_r} $1"; else print -P "  ${c_no}✗${c_r} $1"; ((bad++)); fi }
  say " ${c_hi}Tools${c_r}"
  chk "node $(node -v 2>/dev/null)"  "node -v"
  chk "bun $(bun -v 2>/dev/null)"    "bun -v"
  chk "pnpm $(pnpm -v 2>/dev/null)"  "pnpm -v"
  chk "java $(java -version 2>&1 | head -1 | cut -d'\"' -f2)" "java -version"
  [[ $STACK_GIT == github ]] && chk "gh authenticated" "gh auth status"
  _with_secrets && chk "1Password (op)" "source $HOME/.config/op.env 2>/dev/null; op whoami"
  [[ -n ${NEON_API_KEY:-} ]] && chk "neonctl" "command -v neonctl"
  chk "claude code"                  "command -v claude"
  chk "codex"                        "command -v codex"
  say ""
  say " ${c_hi}Services${c_r}"
  # Those the machine declares, under the name it gives them.
  _read_services
  local d label unit
  for d in ${=STACK_SERVICES}; do
    label=${${d#*:}%%:*}; unit=${d##*:}
    [[ -n ${_SERVICE_STATES[$unit]:-} ]] || continue
    chk "$label ($unit)" "systemctl is-active --quiet $unit"
  done
  chk "tmux session \"$SESSION\""    "tmux has-session -t $SESSION"
  say ""
  say " ${c_hi}Projects${c_r}"
  for n in $P_ORDER; do
    if [[ -d $(_wd $n) ]]; then print -P "  ${c_ok}✓${c_r} $n"; else print -P "  ${c_no}✗${c_r} $n (folder missing — dev sync $n)"; ((bad++)); fi
  done
  # The trap that costs the most: the ingress says https, the origin speaks
  # cleartext (or the other way round). Cloudflare answers 502 and the dev server
  # writes nothing, since it never saw the request. Nothing else reports it.
  local ingress=/etc/cloudflared/config.yml
  if _with_tunnel && [[ -r $ingress ]]; then
    local mismatched=()
    for n in $P_ORDER; do
      [[ ${P_SUB[$n]} == "-" || -z ${P_SUB[$n]} ]] && continue
      _port_up $n || continue
      local declared=$(awk -v h="${P_SUB[$n]}.${DEV_DOMAIN}" \
        '$1 == "-" && $2 == "hostname:" && $3 == h {found=1; next}
         found && $1 == "service:" {print $2; exit}' $ingress)
      [[ -n $declared ]] || continue
      local real=http
      curl -s -o /dev/null --max-time 3 "http://${P_HOST[$n]}:${P_PORT[$n]}/" 2>/dev/null \
        || { curl -sk -o /dev/null --max-time 3 "https://${P_HOST[$n]}:${P_PORT[$n]}/" 2>/dev/null && real=https }
      [[ $declared == ${real}://* ]] || mismatched+=$n
    done
    if (( $#mismatched )); then
      say ""
      say " ${c_hi}Tunnel${c_r}"
      print -P "  ${c_no}✗${c_r} origin scheme mismatch: ${mismatched}"
      print -P "    ${c_dim}the tunnel calls them with the wrong protocol → silent 502${c_r}"
      print -P "    ${c_dim}fix:  dev tunnel sync${c_r}"
      ((bad++))
    fi
  fi

  say ""
  (( bad == 0 )) && say " ${c_ok}Everything is in order.${c_r}" || say " ${c_w}$bad point(s) to fix.${c_r}"
  say ""
}

# This command's grammar, for Pupitre's autocompletion.
#
# This is where it lives, and nowhere else: a list copied into the app would go
# stale at the first subcommand added. Each argument position enumerates its
# values; "$project" expands, on the Pupitre side, to the projects the snapshot
# has already given it.
cmd_completions() {
  local -a grammar=(
    'up|start a project|$project all'
    'down|stop a project|$project all'
    'restart|restart a project|$project'
    'tui|full-screen dashboard|'
    'status|what runs, ports, services|--json'
    'snapshot|machine + services + projects, as JSON|'
    'top|the processes that weigh|'
    'sessions|the agent sessions hanging around|clean --json kill'
    'branches|a project'"'"'s branches, as JSON|$project'
    'projects|the registry, as JSON|'
    'kill|stop a process|'
    'project|register or remove a project|add remove'
    'attach|attach to the tmux session|$project'
    'logs|last lines of the log|$project;-f'
    'sync|git pull + dependencies|$project all'
    'install|reinstall the dependencies|$project all'
    'url|public addresses|$project'
    'secrets|a project'"'"'s secrets, or the stack'"'"'s|$project --json set'
    'env|(re)generate the .env.local|$project all'
    'db|local database|shell dump import url'
    'shots|screenshot gallery|list url clean restart'
    'claude|Claude Code in the project|$project'
    'codex|Codex in the project|$project'
    'branch|each repository'"'"'s branch, or switch|$project'
    'reboot|reboot the server|--yes'
    'debug|restart with the JVM debug agent|$project;off'
    'tunnel|the tunnel|status sync restart'
    'doctor|quick diagnosis|'
    'diag|full report|'
    'ls|the project names|'
    'completions|this grammar, as JSON|'
    'help|the help|'
  )
  local row name help args p first=1 first_position
  print '{'
  printf '  "command": "%s",\n' "$(_json_text ${ZSH_ARGZERO:t})"
  print '  "sub": ['
  for row in $grammar; do
    name=${row%%|*}; row=${row#*|}
    help=${row%%|*}; args=${row#*|}
    (( first )) || print ","
    first=0
    printf '    {"name":"%s","help":"%s","args":[' "$(_json_text $name)" "$(_json_text $help)"
    first_position=1
    for p in ${(s:;:)args}; do
      (( first_position )) || printf ','
      first_position=0
      printf '%s' "$(_json_list ${=p})"
    done
    printf ']}'
  done
  print ""
  print '  ]'
  print '}'
}

# =============================================================================
case ${1:-status} in
  up)       shift; cmd_up "$@" ;;
  down)     shift; cmd_down "$@" ;;
  restart)  shift; cmd_restart "$@" ;;
  tui|ui)   cmd_tui ;;
  status|s) shift; [[ ${1:-} == --json ]] && cmd_status_json || cmd_status ;;
  snapshot) cmd_snapshot ;;
  top)      cmd_top ;;
  sessions) shift; cmd_sessions "$@" ;;
  branches) shift; cmd_branches "$@" ;;
  projects) shift; cmd_projects "$@" ;;
  kill)     shift; cmd_kill "$@" ;;
  project)  shift; cmd_project "$@" ;;
  attach|a) shift; cmd_attach "$@" ;;
  logs|l)   shift; cmd_logs "$@" ;;
  sync)     shift; cmd_sync "$@" ;;
  install)  shift; cmd_install "$@" ;;
  url)      shift; cmd_url "$@" ;;
  secrets)  shift; cmd_secrets "$@" ;;
  env)      shift; cmd_env "$@" ;;
  db)       shift; cmd_db "$@" ;;
  shots)    shift; cmd_shots "$@" ;;
  claude)   shift; cmd_agent claude "$@" ;;
  codex)    shift; cmd_agent codex "$@" ;;
  branch|br) shift; cmd_branch "$@" ;;
  reboot)   shift; cmd_reboot "$@" ;;
  debug)    shift; cmd_debug "$@" ;;
  tunnel)   shift; cmd_tunnel "$@" ;;
  doctor)   cmd_doctor ;;
  diag)     exec dev-diag ;;
  ls)       print -l $P_ORDER ;;
  completions) cmd_completions ;;
  # Up to the closing rule, not up to a line number: adding a command must not
  # silently push another one out of the help.
  -h|--help|help) awk 'NR>2 && /^# ={5,}/{exit} NR>2' ${0:A} | sed 's/^# \{0,1\}//' ;;
  *)        err "unknown command: $1"; sed -n '13,30p' ${0:A} | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
