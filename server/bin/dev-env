#!/usr/bin/env bash
# =============================================================================
#  dev-env — produces a project's .env.local.
#
#      dev-env <project-folder> [<repository-root>] [<name>]
#
#  Called by bootstrap.sh at provisioning time AND by `dev env` on demand: a
#  single implementation, therefore a single behaviour.
#
#  Two paths, tried in order:
#
#   1. The repository's own script (`bootstrap:local` / `dev:prepare`). That is
#      the most complete — it also handles remote database branches and
#      generated secrets. But it often starts from a .env.example the repository
#      does not version. That file MUST therefore be versioned: the script stops
#      dead and tells you how to produce it if it is missing.
#   2. As a last resort, direct injection of the template by `op inject`, after
#      substituting the {{OP_VAULT}} / {{OP_ITEM}} placeholders.
#
#  No secret value is written or displayed by this script: they come from the
#  secret manager at run time, and exist nowhere else. A machine that has none
#  falls back on the repository's .env.example.
# =============================================================================
set -uo pipefail

WD="${1:?usage: dev-env <project-folder> [root] [name]}"
ROOT="${2:-$WD}"
NAME="${3:-$(basename "$WD")}"
# Where the environment files live.
#
# In a monorepo they sit at the ROOT and the workspaces point back at them with
# symlinks — so a monorepo has a single .env.local, at the root, that apps/web
# references. Looking only in the project folder made generation fail on a
# repository that was perfectly well configured.
#
# So we look at the project folder first, the root next, and we write the
# .env.local where we found the template: that is the place the repository chose,
# and the only one its symlinks point to.
ENV_HOME="$WD"
if [[ ! -f "$WD/.env.1password.tpl" && ! -f "$WD/.env.example" ]] \
   && [[ -f "$ROOT/.env.1password.tpl" || -f "$ROOT/.env.example" ]]; then
  ENV_HOME="$ROOT"
fi

TARGET="$ENV_HOME/.env.local"
TPL="$ENV_HOME/.env.1password.tpl"
EXAMPLE="$ENV_HOME/.env.example"

if [[ -t 1 ]]; then G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; D=$'\033[2m'; N=$'\033[0m'
else G=""; Y=""; R=""; D=""; N=""; fi
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$1"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$1"; }
bad()  { printf '  %s✗%s %s\n' "$R" "$N" "$1"; }
dim()  { printf '  %s%s%s\n' "$D" "$1" "$N"; }

# --- Adapting the URLs to the server -----------------------------------------
# Repository bootstrap scripts write LOCAL URLs (http://my-app.localhost:3000):
# correct on a laptop, wrong here. The browser arrives through the tunnel's
# public URL, and the app refuses it — auth libraries answer "Invalid origin",
# assets point nowhere.
#
# So we rewrite, inside the .env.local, every http:// URL designating THIS
# project's local host to its public URL. Connection strings (postgres://,
# mysql://) are left alone.
apply_public_url() {
  local target="$1" name="$2"
  local conf="${DEV_STACK_CONF:-/etc/dev-stack.projects.conf}"
  [[ -f "$target" && -r "$conf" ]] || return 0
  # No domain means no public URL: there is nothing to rewrite to.
  [[ -n "${DEV_DOMAIN:-}" ]] || return 0

  local n d r pm host port sub cmd
  while IFS='|' read -r n d r pm host port sub cmd; do
    # The port may carry a scheme ("https:5180"): here we only want the number.
    port="${port##*:}"
    [[ "$n" == "$name" ]] || continue
    [[ -z "$sub" || "$sub" == "-" ]] && return 0
    local public="https://${sub}.${DEV_DOMAIN}"

    # The possible forms, most specific first.
    sed -i -e "s|http://${host}:${port}|${public}|g" \
           -e "s|http://${host}\b|${public}|g" \
           -e "s|http://localhost:${port}|${public}|g" \
           -e "s|http://127\.0\.0\.1:${port}|${public}|g" "$target"

    # Auth libraries refuse any origin they do not know. Repositories read
    # AUTH_TRUSTED_ORIGINS (a comma-separated list): we add the project's public
    # URL to it. Without it: "Invalid origin".
    if grep -qE '^AUTH_TRUSTED_ORIGINS=' "$target"; then
      # Appended without overwriting what is already there, and without
      # duplicates.
      if ! grep -qE "^AUTH_TRUSTED_ORIGINS=.*${sub}\\." "$target"; then
        local current
        current="$(grep -E '^AUTH_TRUSTED_ORIGINS=' "$target" | head -1 | cut -d= -f2- | tr -d '"')"
        if [[ -n "$current" ]]; then
          sed -i "s|^AUTH_TRUSTED_ORIGINS=.*|AUTH_TRUSTED_ORIGINS=\"${current},${public}\"|" "$target"
        else
          sed -i "s|^AUTH_TRUSTED_ORIGINS=.*|AUTH_TRUSTED_ORIGINS=\"${public}\"|" "$target"
        fi
      fi
    elif grep -qE '^(BETTER_AUTH_|AUTH_)' "$target"; then
      printf '\nAUTH_TRUSTED_ORIGINS="%s"\n' "$public" >>"$target"
    fi

    # And its base URL, when the project uses it without declaring it.
    if grep -q '^BETTER_AUTH_' "$target" && ! grep -q '^BETTER_AUTH_URL=' "$target"; then
      printf 'BETTER_AUTH_URL="%s"\n' "$public" >>"$target"
    fi
    dim "$name: URLs adapted to $public"
    return 0
  done < "$conf"
}


[[ -d "$WD" ]] || { bad "$NAME: $WD does not exist"; exit 1; }

if [[ -f "$TARGET" && "${FORCE:-0}" != 1 ]]; then
  # Even on an existing file we run the URL adaptation again: it is idempotent
  # (it only recognises the http://local-host:port forms) and that is what lets
  # `dev env all` fix, in one go, .env.local files generated before this step
  # existed.
  apply_public_url "$TARGET" "$NAME"
  ok "$NAME: .env.local already present ($(wc -l <"$TARGET") lines)"
  exit 0
fi

# The package manager the repository declares. We do NOT try the other one:
# corepack refuses a packageManager it does not know (bun), and the resulting
# error message has nothing to do with the real problem.
pm=""
if [[ -f "$WD/bun.lock" || -f "$WD/bun.lockb" ]]; then pm=bun
elif [[ -f "$WD/pnpm-lock.yaml" ]]; then pm=pnpm
elif [[ -f "$WD/package-lock.json" ]]; then pm=npm
fi

script=""
if [[ -f "$WD/package.json" ]] && command -v jq >/dev/null 2>&1; then
  for s in bootstrap:local dev:prepare; do
    jq -e --arg s "$s" '.scripts[$s] // empty' "$WD/package.json" >/dev/null 2>&1 && { script="$s"; break; }
  done
fi

# --- The .env.example must come from the repository --------------------------
# We do NOT build it from the 1Password template: that one only lists the secret
# keys (3 out of 30 for a typical app), not the application configuration. An
# incomplete .env.example is worse than a missing one — it produces a .env.local
# that starts and then breaks on a missing variable, far from the cause.
if [[ -n "$script" && ! -f "$EXAMPLE" ]]; then
  bad "$NAME: .env.example missing from the repository — the bootstrap script cannot start"
  dim "this file must be versioned. On your own machine, inside the repository:"
  dim "    grep -oE '^[A-Z0-9_]+=' .env.local | sed 's/=\$/=/' > .env.example"
  dim "    # fill in the NON-secret values, then:"
  dim "    git add -f .env.example && git commit -m 'chore: env example'"
  exit 1
fi

# --- Step 1: the repository's script -----------------------------------------
if [[ -n "$script" && -n "$pm" ]]; then
  dim "$NAME: $pm run $script  (max ${TIMEOUT:-240}s)"
  # </dev/null: without it, the slightest question from the script waits for an
  #   answer that will never come — and since the output goes to a file, you do
  #   not even see the question. Closing stdin makes it fail straight away.
  # timeout: a safety net for anything that blocks without asking, typically a
  #   CLI attempting browser authentication.
  if (cd "$WD" && timeout "${TIMEOUT:-240}" "$pm" run "$script" \
        </dev/null >/tmp/dev-env.$$.log 2>&1) && [[ -f "$TARGET" ]]; then
    apply_public_url "$TARGET" "$NAME"
    ok "$NAME: .env.local generated by $script"
    rm -f /tmp/dev-env.$$.log
    exit 0
  fi
  rc=$?
  if (( rc == 124 )); then
    bad "$NAME: \"$script\" does not hand control back (stopped after ${TIMEOUT:-240}s)"
    dim "it was probably waiting for input. To see what, in the open:"
    dim "    cd $WD && $pm run $script"
  else
    warn "$NAME: \"$script\" did not complete"
  fi
  tail -n 15 /tmp/dev-env.$$.log 2>/dev/null | sed 's/^/      /'
  # The failures that keep coming back, with their real cause rather than the
  # repository's message, which often blames the wrong part.
  if grep -q "Install neonctl" /tmp/dev-env.$$.log 2>/dev/null; then
    if command -v neonctl >/dev/null 2>&1; then
      dim "neonctl IS installed ($(command -v neonctl)) — the blocker is authentication"
      dim "test:  neonctl projects list      (NEON_API_KEY must be exported)"
    else
      dim "neonctl not on the PATH → bun add -g neonctl"
    fi
  fi
  grep -q "1Password" /tmp/dev-env.$$.log 2>/dev/null \
    && dim "1Password did answer — the blocker is elsewhere in the script"
  rm -f /tmp/dev-env.$$.log
fi

# --- Step 2: direct injection of the template --------------------------------
if [[ -f "$TPL" ]]; then
  if ! command -v op >/dev/null 2>&1; then
    # The template comes from the repository, not from the machine: a repository
    # that keeps its secrets in 1Password can perfectly well be cloned onto a
    # server that has none. We then fall back on the versioned example rather
    # than stopping — the values are to be filled in by hand, and we say so.
    if [[ -f "$EXAMPLE" ]]; then
      cp "$EXAMPLE" "$TARGET"
      chmod 600 "$TARGET"
      apply_public_url "$TARGET" "$NAME"
      warn "$NAME: no secret manager here — .env.local copied from .env.example, values to fill in"
      exit 0
    fi
    bad "$NAME: 1Password template present, but neither op nor .env.example on this machine"
    exit 1
  fi
  vault="$(jq -r '.vault // empty' "$ROOT/op.config.json" 2>/dev/null)"
  item="$(jq -r  '.item  // empty' "$ROOT/op.config.json" 2>/dev/null)"
  # The template carries {{OP_VAULT}} / {{OP_ITEM}} placeholders, which the
  # repository's script replaces before calling op. `op inject` does not
  # understand them and stops on "only secret references or quoted strings can be
  # enclosed in unescaped {{ }}s". So we substitute them ourselves, in a copy.
  tmp_tpl="$(mktemp)"
  sed -e "s|{{OP_VAULT}}|${vault}|g" -e "s|{{OP_ITEM}}|${item}|g" "$TPL" >"$tmp_tpl"
  if (cd "$ENV_HOME" && timeout 60 op inject -i "$tmp_tpl" -o .env.local -f \
        </dev/null >/tmp/dev-env.$$.log 2>&1) \
     && [[ -s "$TARGET" ]]; then
    rm -f "$tmp_tpl"
    chmod 600 "$TARGET"
    apply_public_url "$TARGET" "$NAME"
    ok "$NAME: .env.local injected from 1Password — vault \"$vault\", item \"$item\""
    rm -f /tmp/dev-env.$$.log
    exit 0
  fi
  rm -f "$tmp_tpl"
  bad "$NAME: op inject failed"
  sed -n '1,6p' /tmp/dev-env.$$.log 2>/dev/null | sed 's/^/      /'
  dim "check that the service account can see the vault \"$vault\""
  dim "and that the item \"$item\" has one field per template key"
  rm -f /tmp/dev-env.$$.log
  exit 1
fi

# --- Nothing to do -----------------------------------------------------------
if [[ -f "$EXAMPLE" ]]; then
  cp "$EXAMPLE" "$TARGET"
  warn "$NAME: .env.local copied from .env.example — values to fill in by hand"
  exit 0
fi
dim "$NAME: no environment template, nothing to generate"
exit 0
