#!/usr/bin/env python3
"""Serves the screenshot folder read-only, newest first.

Configured by two environment variables, set by the systemd service:
    SHOTS_DIR   folder to serve      (default ~/shots)
    SHOTS_PORT  local listen port    (default 8099)

Standard library only: nothing to install, nothing to maintain.
"""

import html
import http.server
import os
import socketserver
import urllib.parse
from datetime import datetime

ROOT = os.environ.get("SHOTS_DIR", os.path.expanduser("~/shots"))
PORT = int(os.environ.get("SHOTS_PORT", "8099"))
IMAGE_EXT = (".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".avif")

PAGE = """<!doctype html><meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1">
<title>shots · {crumb}</title>
<style>
:root{{--bg:#f5f7f5;--fg:#131e1b;--dim:#5b6b66;--line:#d5ddd9;--card:#fff;--ac:#0c6e62}}
@media(prefers-color-scheme:dark){{
  :root{{--bg:#0d1412;--fg:#e3ebe7;--dim:#93a49e;--line:#25332e;--card:#141d1a;--ac:#54c9b6}}}}
*{{box-sizing:border-box}}
body{{margin:0;padding:24px;background:var(--bg);color:var(--fg);
  font:15px/1.5 ui-sans-serif,-apple-system,"Segoe UI",sans-serif}}
h1{{font:500 14px/1.4 ui-monospace,monospace;margin:0 0 20px;color:var(--dim)}}
h1 a{{color:var(--ac);text-decoration:none}}
.g{{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(240px,1fr))}}
.c{{display:block;background:var(--card);border:1px solid var(--line);
  text-decoration:none;color:inherit}}
.c:hover{{border-color:var(--ac)}}
.t{{aspect-ratio:16/10;display:flex;align-items:center;justify-content:center;
  overflow:hidden;background:var(--bg)}}
.t img{{width:100%;height:100%;object-fit:contain}}
.m{{padding:10px 12px;display:flex;flex-direction:column;gap:2px}}
.m b{{font-weight:500;font-size:13px;word-break:break-all}}
.m span{{color:var(--dim);font-size:11px;font-family:ui-monospace,monospace}}
.empty{{color:var(--dim)}}
</style>
<h1><a href="/">shots</a>{crumb_html}</h1>
<div class=g>{cards}</div>
"""


class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *a, **k):
        super().__init__(*a, directory=ROOT, **k)

    def do_POST(self):          # strictly read-only
        self.send_error(405)

    do_PUT = do_DELETE = do_POST

    def list_directory(self, path):
        try:
            names = os.listdir(path)
        except OSError:
            self.send_error(404)
            return None

        names.sort(key=lambda n: os.path.getmtime(os.path.join(path, n)), reverse=True)
        rel = os.path.relpath(path, ROOT)
        rel = "" if rel == "." else rel

        cards = []
        for n in names:
            full = os.path.join(path, n)
            is_dir = os.path.isdir(full)
            href = urllib.parse.quote(n) + ("/" if is_dir else "")
            when = datetime.fromtimestamp(os.path.getmtime(full)).strftime("%d/%m %H:%M")
            size = "folder" if is_dir else f"{os.path.getsize(full) // 1024} kB"
            thumb = f'<img src="{href}" loading="lazy">' if n.lower().endswith(IMAGE_EXT) else ""
            cards.append(
                f'<a class="c" href="{href}"><div class="t">{thumb}</div>'
                f'<div class="m"><b>{html.escape(n)}</b><span>{when} · {size}</span>'
                f"</div></a>"
            )

        body = PAGE.format(
            crumb=html.escape(rel) or "/",
            crumb_html=f" / {html.escape(rel)}" if rel else "",
            cards="".join(cards) or '<p class="empty">Nothing yet.</p>',
        ).encode()

        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)
        return None

    def log_message(self, *a):
        pass


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


if __name__ == "__main__":
    os.makedirs(ROOT, exist_ok=True)
    Server(("127.0.0.1", PORT), Handler).serve_forever()
