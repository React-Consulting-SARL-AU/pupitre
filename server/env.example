# =============================================================================
#  dev-stack — server configuration
#
#  Copied to /etc/dev-stack.env (chmod 600) the first time bootstrap.sh runs.
#  This file contains secrets: it must NEVER be committed.
#  An empty variable is not an error — the script simply reports that the
#  matching step is skipped, and you can come back to it later.
# =============================================================================

# --- What this machine runs --------------------------------------------------
# Nothing is mandatory. "auto" derives each service from what is filled in
# below: a Cloudflare key and the tunnel gets set up, none and it is skipped.
# Setting "none" disables it outright, even if the variables are filled in.
#
#   DATABASE_ENGINE   mysql | mariadb | none | auto
#   TUNNEL_PROVIDER   cloudflare | none | auto
#   SECRETS_PROVIDER  1password | none | auto
#   GIT_PROVIDER      github | git | auto      ("git" = clone with no account)
#   NEON_ENABLED      yes | no | auto
DATABASE_ENGINE=auto
TUNNEL_PROVIDER=auto
SECRETS_PROVIDER=auto
GIT_PROVIDER=auto
NEON_ENABLED=auto

# The services Pupitre will display, as "key:label:systemd-unit".
# Empty = derived from the above. Fill it in for a machine that runs something
# else — a Redis, a Postgres, a queue:
#   STACK_SERVICES="tunnel:Tunnel:cloudflared database:Database:postgresql queue:Queue:redis"
STACK_SERVICES=""

# Extra keys to track in `dev secrets`, if this machine has any.
STACK_SECRETS_KEYS=""

# --- Identity and locations --------------------------------------------------
# The name the machine goes by — in `dev status`, in the tmux bar. Empty: its
# hostname, which at most providers is a string of digits nobody recognises.
STACK_NAME=""

DEV_USER=dev
PROJECTS_DIR=/home/dev/projects
# The domain of the public addresses. Empty: projects are reached on their port,
# through the SSH tunnel — which is enough for a development machine.
DEV_DOMAIN=""
TZ=UTC

GIT_USER_NAME=""
GIT_USER_EMAIL=""

# --- Access from your own machine --------------------------------------------
# The contents of your public key (a single line, "ssh-ed25519 …").
# With 1Password: SSH item → "Copy public key".
SSH_PUBLIC_KEY=""

# --- Repository host ---------------------------------------------------------
# Optional, and specific to GitHub: it is used to install `gh`, to clone private
# repositories over HTTPS and to register the server's key on the account.
#
# Elsewhere — GitLab, Gitea, Forgejo, a bare git server — leave it empty: the
# server's SSH key (created at step 5) is to be added to your account, and the
# "git@your-host:…" URLs in the registry then work with nothing else.
# GIT_HOST names the host whose signature must be known; empty, it is derived
# from the registry's URLs.
#
# GitHub personal access token (classic) with scopes: repo, read:org,
# admin:public_key — https://github.com/settings/tokens
GITHUB_TOKEN=""
GIT_HOST=""

# --- Tunnel (Cloudflare) -----------------------------------------------------
# Optional: without it, projects stay reachable on their port through the SSH
# tunnel, and the registry's "subdomain" column is ignored.
# API token with: Zone → DNS → Edit  AND  Account → Cloudflare Tunnel → Edit
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ZONE_ID=""          # the zone of DEV_DOMAIN
CLOUDFLARE_ZONE_NAME=""
CLOUDFLARE_TUNNEL_NAME="dev-stack"

# Cloudflare Access on the screenshot gallery: only this address will be able to
# open it (one-time code by email). Empty = public gallery.
# The API token must then also carry: Account → Access: Apps and Policies → Edit
CLOUDFLARE_ACCESS_EMAIL=""

# --- Secret manager (1Password) ----------------------------------------------
# Optional: it is used to produce the .env.local of repositories that version a
# .env.1password.tpl template. Without it, those repositories fall back on their
# .env.example, to be completed by hand.
#
# A service account (NOT a user account) with read access to the vault:
# https://my.1password.com → Developer Tools
OP_SERVICE_ACCOUNT_TOKEN=""
OP_VAULT=""

# --- Remote database (Neon) --------------------------------------------------
# Optional: only for repositories that provision a Neon branch.
# https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=""

# --- AI agents ---------------------------------------------------------------
# Claude Code, on your subscription (Pro or Max) rather than usage billing. The
# token is made ONCE, on a machine where a browser can open the authorisation
# page:
#
#     claude setup-token
#
# It is long-lived: the server never needs a browser, and filling it in here is
# enough for `dev claude <project>` to start already signed in (the `user` step
# of the provisioning puts it in the dev user's environment).
CLAUDE_CODE_OAUTH_TOKEN=""

# Alternative to CLAUDE_CODE_OAUTH_TOKEN: a Console API key, billed by usage and
# independent of the subscription. Fill in only one of the two.
ANTHROPIC_API_KEY=""

# Codex. Empty: running `codex` once interactively is enough to sign in.
OPENAI_API_KEY=""

# --- Local database ----------------------------------------------------------
# Optional: leave MYSQL_APP_PASSWORD empty (or DATABASE_ENGINE=none) and no
# engine is installed. Projects then point at their own database — remote,
# containerised, or on another server.
#
# APP: the password of root@127.0.0.1, the one applications read. It has to match
#      the one in their configuration, otherwise they will not start.
# REMOTE: the named account for your own workstation. It is only reachable
#         through the SSH tunnel — the firewall only opens port 22.
MYSQL_APP_PASSWORD=""
MYSQL_REMOTE_USER=""
MYSQL_REMOTE_PASSWORD=""
# The databases to create, space separated. The first is the default for
# "dev db". Empty: no database is created.
MYSQL_DATABASES=""
MYSQL_BUFFER_POOL="2G"

# Dumps placed in the stack's db/ folder are imported automatically, one database
# per file, the database name derived from the file name:
#     db/fulldump_shop_202608121250.sql  →  database shop
#     db/dump_intranet_202603181730.sql  →  database intranet
# .sql.gz files are accepted. A dump already imported is never replayed.
DUMPS_DIR=""      # empty = <script folder>/db

# --- JVM debugging -----------------------------------------------------------
# The projects `dev debug` can restart with the JVM debug agent, and the port
# each one listens on. Fixed ports, so a saved IDE run configuration stays
# valid. The port only listens on the loopback and comes back through the SSH
# tunnel — nothing is opened on the firewall.
#   DEBUG_PORTS="api:5005 other-api:5006"
DEBUG_PORTS=""

# --- Screenshot gallery ------------------------------------------------------
# Folder served over HTTPS at https://shots.$DEV_DOMAIN, fed by `shot`.
SHOTS_DIR="/home/dev/shots"
SHOTS_PORT=8099

# --- Runtimes ----------------------------------------------------------------
NODE_VERSION=22
# Java is installed by mise, like node/bun/pnpm. Some older JVM frameworks
# require a JDK ≤ 19 — check yours before going higher.
JAVA_VERSION=temurin-21
