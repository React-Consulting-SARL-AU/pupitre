{
  "$schema": "https://v2-10-5.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "biome.jsonc",
    "bunfig.toml",
    "tsconfig.base.json",
    "tsconfig.worker.json"
  ],
  "globalEnv": ["CI"],
  // envMode is strict: a variable missing here reaches no task at all.
  "globalPassThroughEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_URL",
    "MIGRATE_DATABASE_URL",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "EMAIL_FROM"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_*"],
      "outputs": [".wrangler/dry-run/**", "dist/**", ".output/**", "out/**"]
    },
    "build:cloudflare": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["DATABASE_URL"],
      "outputs": ["dist/**", ".wrangler/dry-run/**"]
    },
    "@pupitre/db#build": {
      "outputs": ["src/generated/**"]
    },
    "check:types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@pupitre/db#check:types": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "db:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["PUPITRE_ALLOW_MIGRATE_ON"]
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:migrate:reset": {
      "cache": false,
      "passThroughEnv": ["PUPITRE_ALLOW_MIGRATE_ON"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
