---
import { ANNUAL_FREE_MONTHS, BILLING_INTERVALS } from "@pupitre/shared/plans"
import { pricingContent } from "../content/site/pricing"
import { fill, localeFromPath } from "../lib/i18n"

const locale = localeFromPath(Astro.url.pathname)
const { billing } = pricingContent(locale)
---

<fieldset class="inline-flex rounded-full border border-line bg-surface p-0.5">
  <legend class="sr-only">{billing.legend}</legend>
  {
    BILLING_INTERVALS.map((interval) => (
      <label class="group label flex cursor-pointer items-baseline gap-2 rounded-full px-3.5 py-2 text-ink-3 hover:text-ink has-checked:bg-inverse has-checked:text-inverse-ink has-focus-visible:outline-2 has-focus-visible:outline-ink has-focus-visible:outline-offset-2">
        <input
          type="radio"
          name="billing"
          id={`billing-${interval}`}
          value={interval}
          checked={interval === "month"}
          class="sr-only"
        />
        <span>{billing[interval]}</span>
        {interval === "year" && (
          <span class="text-ink-3 group-has-checked:text-inverse-ink/70">
            {fill(billing.yearNote, { months: ANNUAL_FREE_MONTHS })}
          </span>
        )}
      </label>
    ))
  }
</fieldset>
