---
import { localeFromPath, localizePath, translator } from "../lib/i18n"

const locale = localeFromPath(Astro.url.pathname)
const t = translator(locale)
const enabled = Boolean(import.meta.env.PUBLIC_POSTHOG_KEY)
---

{
  enabled && (
    <div
      data-consent-banner
      hidden
      role="dialog"
      aria-label={t("consent.title")}
      class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-md rounded-xl border border-line bg-base p-5 shadow-overlay"
    >
      <p class="heading-4">{t("consent.title")}</p>
      <p class="mt-2 text-ink-2">{t("consent.body")}</p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <button
          type="button"
          data-consent="granted"
          data-emphasis="main"
          class="btn btn-primary"
        >
          {t("consent.accept")}
        </button>
        <button
          type="button"
          data-consent="denied"
          data-emphasis="secondary"
          class="btn btn-secondary"
        >
          {t("consent.decline")}
        </button>
        <a
          href={localizePath("/legal/cookies/", locale)}
          class="ms-auto py-2 text-ink-3 hover:text-ink"
        >
          {t("consent.link")}
        </a>
      </div>
    </div>
  )
}

<script>
  import {
    CONSENT_KEY,
    DEFAULT_POSTHOG_HOST,
    parseConsent,
    posthogOptions,
    readConsent,
  } from "../lib/analytics"

  const key = import.meta.env.PUBLIC_POSTHOG_KEY
  const host = import.meta.env.PUBLIC_POSTHOG_HOST ?? DEFAULT_POSTHOG_HOST
  const banner = document.querySelector<HTMLElement>("[data-consent-banner]")

  async function start(key: string): Promise<void> {
    const { default: posthog } = await import("posthog-js")

    posthog.init(key, posthogOptions(host))
  }

  function storedConsent(): ReturnType<typeof readConsent> {
    try {
      return readConsent(localStorage)
    } catch {
      return null
    }
  }

  function remember(consent: string): void {
    try {
      localStorage.setItem(CONSENT_KEY, consent)
    } catch {
      // A browser that refuses storage simply asks again on the next visit.
    }
  }

  if (key) {
    let decided = storedConsent()

    if (decided === "granted") {
      await start(key)
    }

    if (decided === null && banner) {
      banner.hidden = false
    }

    for (const button of document.querySelectorAll<HTMLButtonElement>(
      "[data-consent-reopen]"
    )) {
      button.addEventListener("click", () => {
        if (banner) {
          banner.hidden = false
        }
      })
    }

    for (const button of banner?.querySelectorAll<HTMLButtonElement>(
      "[data-consent]"
    ) ?? []) {
      button.addEventListener("click", async () => {
        const consent = parseConsent(button.dataset.consent)

        if (!consent || !banner) {
          return
        }

        const withdrawn = decided === "granted" && consent === "denied"

        remember(consent)
        banner.hidden = true

        if (withdrawn) {
          // PostHog keeps no state outside this page: reloading without it is the whole opt-out.
          location.reload()
          return
        }

        if (consent === "granted" && decided !== "granted") {
          await start(key)
        }

        decided = consent
      })
    }
  }
</script>
