---
import {
  localeFromPath,
  localizePath,
  stripLocale,
  translator,
} from "../lib/i18n"
import { SIGNUP_URL, SOURCE_REPOSITORY_URL } from "../lib/urls"
import Brand from "./Brand.astro"
import BrandLogo from "./BrandLogo.astro"
import LocaleSwitch from "./LocaleSwitch.astro"
import ThemeToggle from "./ThemeToggle.astro"

interface Props {
  translation?: string
}

const { translation } = Astro.props
const pathname = Astro.url.pathname
const locale = localeFromPath(pathname)
const t = translator(locale)
const current = stripLocale(pathname)

const links = [
  { href: "/docs/", label: t("nav.docs") },
  { href: "/pricing/", label: t("nav.pricing") },
  { href: "/integrations/", label: t("nav.integrations") },
  { href: "/security/", label: t("nav.security") },
  { href: "/blog/", label: t("nav.blog") },
]

const isCurrent = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href)
---

<header class="nav-veil sticky top-0 z-50 px-3 pt-3 md:px-6 md:pt-4">
  <div class="nav-bar gap-6">
    <Brand />

    <nav
      aria-label={t("nav.label")}
      class="ms-2 hidden items-center gap-1 md:flex"
    >
      {
        links.map((link) => (
          <a
            href={localizePath(link.href, locale)}
            aria-current={isCurrent(link.href) ? "page" : undefined}
            class="nav-link"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ms-auto flex items-center gap-2">
      <div class="hidden items-center gap-2 lg:flex">
        <ThemeToggle />
        <LocaleSwitch href={translation} />
      </div>
      <a
        href={SOURCE_REPOSITORY_URL}
        aria-label={t("nav.source")}
        title={t("nav.source")}
        class="grid size-8 place-items-center rounded-full border border-line text-ink-2 hover:bg-raised hover:text-ink"
        data-nav-source
      >
        <BrandLogo name="GitHub" module="tool.github" size="xs" />
      </a>
      <a
        data-emphasis="main"
        href={SIGNUP_URL}
        class="btn btn-primary hidden sm:inline-flex"
        >{t("nav.cta")}</a
      >

      <details class="group relative md:hidden" data-nav-menu>
        <summary
          data-emphasis="secondary"
          class="btn btn-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden"
        >
          <span class="group-open:hidden">{t("nav.menu")}</span>
          <span class="hidden group-open:inline">{t("nav.menuClose")}</span>
        </summary>
        <div
          class="absolute end-0 mt-3 w-[17.5rem] rounded-xl bg-base p-2 shadow-overlay"
        >
          <nav aria-label={t("nav.label")} class="grid">
            {
              [...links, { href: "/download/", label: t("nav.download") }].map(
                (link) => (
                  <a
                    href={localizePath(link.href, locale)}
                    aria-current={isCurrent(link.href) ? "page" : undefined}
                    class="rounded-full px-3 py-2.5 text-ink-2 hover:bg-raised hover:text-ink aria-[current=page]:bg-raised aria-[current=page]:text-ink"
                  >
                    {link.label}
                  </a>
                )
              )
            }
          </nav>
          <a
            data-emphasis="main"
            href={SIGNUP_URL}
            class="btn btn-primary mt-2 w-full"
            >{t("nav.cta")}</a
          >
          <div
            class="mt-2 flex flex-wrap items-center justify-between gap-2 border-line border-t pt-2"
          >
            <ThemeToggle />
            <LocaleSwitch href={translation} />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  import { closeMenusOnDismiss } from "../lib/menu"

  closeMenusOnDismiss("[data-nav-menu]")
</script>
