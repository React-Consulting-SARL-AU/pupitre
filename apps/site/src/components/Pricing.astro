---
import { MODULE_IDS } from "@pupitre/shared/catalog"
import { LEGAL_CONTACTS } from "@pupitre/shared/legal"
import { FREE_SERVERS } from "@pupitre/shared/plans"
import { pricingContent } from "../content/site/pricing"
import Base from "../layouts/Base.astro"
import { fill, localeFromPath, localizePath, translator } from "../lib/i18n"
import { jsonLd, product } from "../lib/structured-data"
import { SIGNUP_URL, SOURCE_REPOSITORY_URL } from "../lib/urls"
import CatalogSummary from "./CatalogSummary.astro"
import DownloadButton from "./DownloadButton.astro"
import Feature from "./Feature.astro"
import Section from "./Section.astro"

const locale = localeFromPath(Astro.url.pathname)
const t = translator(locale)
const content = pricingContent(locale)
const servers = { count: FREE_SERVERS }

const description = fill(content.meta.description, servers)
const offers = jsonLd(
  product({
    locale,
    name: t("site.name"),
    description,
    offer: fill(content.offer, servers),
  })
)
---

<Base title={content.meta.title} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={offers} />
  </Fragment>

  <section class="border-line border-b">
    <div class="shell py-20 text-center md:py-28">
      <p class="pill">{content.hero.label}</p>
      <h1 class="heading-1 mx-auto mt-7 max-w-3xl">
        {fill(content.hero.headline, servers)}
      </h1>
      <p class="lead mx-auto mt-7 max-w-2xl text-ink-2">
        {fill(content.hero.lead, servers)}
      </p>
      <p class="card-soft mx-auto mt-12 inline-block px-12 py-9">
        <span class="figure figure-xl block">{content.hero.figure}</span>
        <span class="label mt-4 block text-ink-3"
          >{fill(content.hero.unit, servers)}</span
        >
      </p>
    </div>
  </section>

  <Section
    align="center"
    id="free"
    label={content.free.label}
    title={fill(content.free.title, servers)}
    lead={content.free.lead}
  >
    <div class="grid gap-6 md:grid-cols-2">
      <Feature
        title={content.free.included.title}
        lines={content.free.included.lines}
      />
      <Feature title={content.free.asked.title} lines={content.free.asked.lines} />
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-center gap-3">
      <a data-emphasis="main" href={SIGNUP_URL} class="btn btn-primary">
        {content.free.signUp}
      </a>
      <DownloadButton
        href={localizePath("/download/", locale)}
        label={content.free.download}
        tone="secondary"
      />
    </div>
  </Section>

  <Section
    align="center"
    id="beyond"
    tone="surface"
    label={fill(content.beyond.label, servers)}
    title={content.beyond.title}
    lead={fill(content.beyond.lead, servers)}
  >
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-ink-2">{content.beyond.note}</p>
      <a
        data-emphasis="secondary"
        href={`mailto:${LEGAL_CONTACTS.support}`}
        class="btn btn-secondary mt-8"
      >
        {content.beyond.contact}
      </a>
      <p class="data mt-4 text-ink-3">{LEGAL_CONTACTS.support}</p>
    </div>
  </Section>

  <Section
    align="center"
    id="source"
    label={content.source.label}
    title={content.source.title}
    lead={content.source.lead}
  >
    <div class="grid gap-6 md:grid-cols-2">
      <Feature
        title={content.source.allowed.title}
        lines={content.source.allowed.lines}
      />
      <Feature
        title={content.source.forbidden.title}
        lines={content.source.forbidden.lines}
      />
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-2">
      <a
        href={localizePath("/legal/licence/", locale)}
        class="link-underline inline-block py-2"
      >
        {content.source.licence}
      </a>
      <a
        href={SOURCE_REPOSITORY_URL}
        rel="noreferrer"
        class="link-underline inline-block py-2"
      >
        {content.source.repository}
      </a>
    </div>
  </Section>

  <Section
    align="center"
    id="stop"
    tone="surface"
    label={content.stop.label}
    title={content.stop.title}
    lead={content.stop.lead}
  >
    <div class="grid gap-6 md:grid-cols-2">
      <Feature title={content.stop.keep.title} lines={content.stop.keep.lines} />
      <Feature title={content.stop.lose.title} lines={content.stop.lose.lines} />
    </div>
    <p class="mt-12 max-w-2xl text-ink-2">{content.stop.note}</p>
  </Section>

  <Section
    align="center"
    id="diy"
    label={content.diy.label}
    title={content.diy.title}
    lead={content.diy.lead}
  >
    <div class="grid gap-6 md:grid-cols-2">
      <Feature
        title={content.diy.replaces.title}
        lines={content.diy.replaces.lines}
      />
      <Feature title={content.diy.keeps.title} lines={content.diy.keeps.lines} />
    </div>
  </Section>

  <Section
    align="center"
    id="catalog"
    tone="surface"
    label={content.catalog.label}
    title={content.catalog.title}
    lead={fill(content.catalog.lead, { count: MODULE_IDS.length })}
  >
    <CatalogSummary />
  </Section>
</Base>
