---
import { homeContent } from "../content/site/home"
import { localeFromPath, localizePath } from "../lib/i18n"
import { SIGNUP_URL } from "../lib/urls"
import StackWall from "./StackWall.astro"

const locale = localeFromPath(Astro.url.pathname)
const { hero } = homeContent(locale)
---

<section class="shell pt-16 pb-20 text-center md:pt-24 md:pb-28">
  <p class="pill">{hero.eyebrow}</p>
  <h1 class="display-1 mx-auto mt-8 max-w-4xl">{hero.headline}</h1>
  <p class="lead mx-auto mt-8 max-w-2xl text-ink-2">{hero.lead}</p>

  <div class="mt-10 flex flex-wrap justify-center gap-3">
    <a data-emphasis="main" href={SIGNUP_URL} class="btn btn-lg btn-primary">
      {hero.signUp}
    </a>
    <a
      data-emphasis="secondary"
      href={localizePath("/download/", locale)}
      class="btn btn-lg btn-secondary"
    >
      {hero.download}
    </a>
  </div>

  <p class="mx-auto mt-6 max-w-md text-ink-3">{hero.note}</p>

  <div class="mt-20 md:mt-24"><StackWall /></div>
</section>
