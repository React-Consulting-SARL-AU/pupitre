---
import { homeContent } from "../content/site/home"
import { localeFromPath, localizePath } from "../lib/i18n"
import { SIGNUP_URL } from "../lib/urls"
import CtaPair from "./CtaPair.astro"
import LogoDrift from "./LogoDrift.astro"
import StackWall from "./StackWall.astro"

const locale = localeFromPath(Astro.url.pathname)
const { hero } = homeContent(locale)
const cooledAt = hero.headline.lastIndexOf(hero.cooled)
const headlineBefore = hero.headline.slice(0, cooledAt)
const headlineAfter = hero.headline.slice(cooledAt + hero.cooled.length)
---

<section class="pt-16 pb-20 text-center md:pt-24 md:pb-28">
  <div class="relative">
    <LogoDrift place="hero" />

    <div class="shell enter-group relative">
      <p class="pill">{hero.eyebrow}</p>
      <h1 class="display-1 mx-auto mt-8 max-w-4xl">
        {headlineBefore}<span class="frost">{hero.cooled}</span>{headlineAfter}
      </h1>
      <p class="lead mx-auto mt-8 max-w-2xl text-ink-2">{hero.lead}</p>

      <CtaPair
        main={{ href: SIGNUP_URL, label: hero.signUp }}
        secondary={{
          href: localizePath("/download/", locale),
          label: hero.download,
        }}
      />

      <p class="mx-auto mt-6 max-w-md text-ink-3">{hero.note}</p>
    </div>
  </div>

  <div class="shell mt-20 md:mt-24"><StackWall /></div>
</section>
