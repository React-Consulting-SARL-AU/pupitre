---
interface Props {
  id: string
  label: string
  title: string
  lead?: string
  index?: string
  tone?: "base" | "surface"
  align?: "start" | "center"
}

const {
  id,
  label,
  title,
  lead,
  index,
  tone = "base",
  align = "start",
} = Astro.props
const titleId = `${id}-title`
const centered = align === "center"
---

<section
  id={id}
  aria-labelledby={titleId}
  class:list={[
    "border-line border-t py-24 md:py-32",
    tone === "surface" && "bg-surface",
  ]}
>
  <div class="shell">
    <header class:list={[centered ? "mx-auto max-w-3xl text-center" : "max-w-2xl"]}>
      {
        centered ? (
          <p class="pill">{label}</p>
        ) : (
          <p class="eyebrow">
            {index && <span class="index-mark">{index}</span>}
            <span>{label}</span>
          </p>
        )
      }
      <h2 id={titleId} class="heading-2 mt-6">{title}</h2>
      {
        lead && (
          <p
            class:list={["lead mt-6 text-ink-2", centered && "mx-auto max-w-2xl"]}
          >
            {lead}
          </p>
        )
      }
    </header>
    <div class="mt-14 md:mt-20">
      <slot />
    </div>
  </div>
</section>
