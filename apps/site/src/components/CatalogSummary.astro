---
import { CATALOG } from "../content/site/catalog"
import { pricingContent } from "../content/site/pricing"
import { fill, localeFromPath, localizePath } from "../lib/i18n"

const locale = localeFromPath(Astro.url.pathname)
const { catalog } = pricingContent(locale)

const groups = CATALOG.map((group) => ({
  id: group.id,
  label: group.label[locale],
  names: group.entries.map((entry) => entry.name[locale]).join(", "),
  available: fill(catalog.available, { count: group.entries.length }),
}))
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {
    groups.map((group) => (
      <li data-category={group.id} class="card p-5">
        <h3 class="heading-4">{group.label}</h3>
        <p class="data mt-2 text-ink-3">{group.available}</p>
        <p class="mt-3 text-ink-2">{group.names}</p>
      </li>
    ))
  }
</ul>
<a
  href={`${localizePath("/", locale)}#catalog`}
  class="link-underline mt-10 inline-block py-2"
>
  {catalog.link}
</a>
