---
import { localeFromPath, localizePath } from "../lib/i18n"

interface Props {
  title: string
  lead: string
  download: string
  docs: string
}

const { title, lead, download, docs } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
---

<section class="border-line border-t">
  <div class="shell py-20 md:py-28">
    <div class="card mx-auto max-w-3xl p-8 text-center md:p-12">
      <h2 class="heading-2">{title}</h2>
      <p class="lead mx-auto mt-5 max-w-xl text-ink-2">{lead}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a
          href={localizePath("/download/", locale)}
          class="btn btn-lg btn-primary">{download}</a
        >
        <a href={localizePath("/docs/", locale)} class="btn btn-lg btn-secondary"
          >{docs}</a
        >
      </div>
    </div>
  </div>
</section>
