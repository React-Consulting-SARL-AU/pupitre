---
import {
  alternateLocale,
  localeFromPath,
  localizePath,
  translator,
} from "../lib/i18n"

interface Props {
  href?: string
}

const pathname = Astro.url.pathname
const locale = localeFromPath(pathname)
const target = alternateLocale(locale)
const t = translator(locale)
const { href = localizePath(pathname, target) } = Astro.props
---

<a
  href={href}
  hreflang={target}
  lang={target}
  aria-label={t("locale.alternateName")}
  class="label rounded-full px-2.5 py-2 text-ink-3 hover:bg-raised hover:text-ink"
>
  {target.toUpperCase()}
</a>
