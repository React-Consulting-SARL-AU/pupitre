---
interface Props {
  items: Array<{ question: string; answer: string }>
}

const { items } = Astro.props
---

<div class="divide-y divide-line border-line border-y">
  {
    items.map((item) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-baseline justify-between gap-6 py-5 hover:text-ink [&::-webkit-details-marker]:hidden">
          <span class="heading-3">{item.question}</span>
          <span
            aria-hidden="true"
            class="data shrink-0 self-center rounded-full border border-line-strong px-2 py-0.5 text-ink-3"
          >
            <span class="group-open:hidden">+</span>
            <span class="hidden group-open:inline">−</span>
          </span>
        </summary>
        <p class="max-w-2xl pb-6 text-ink-2 body-lg">{item.answer}</p>
      </details>
    ))
  }
</div>
