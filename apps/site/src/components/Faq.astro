---
interface Props {
  items: Array<{ question: string; answer: string }>
}

const { items } = Astro.props
---

<div class="reveal-group mx-auto flex max-w-3xl flex-col gap-3">
  {
    items.map((item) => (
      <details class="card-soft disclosure px-6 md:px-8" data-faq>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
          <span class="heading-3">{item.question}</span>
          <span aria-hidden="true" class="faq-marker">
            +
          </span>
        </summary>
        <p class="body-lg pb-6 text-ink-2">{item.answer}</p>
      </details>
    ))
  }
</div>
