---
import { formatUsd, type Plan, yearlyPriceUsd } from "@pupitre/shared/plans"
import { pricingContent } from "../content/site/pricing"
import { fill, localeFromPath, planName } from "../lib/i18n"
import { isLaunchOpen } from "../lib/launch"
import { SIGNUP_URL } from "../lib/urls"

interface Props {
  plan: Plan
}

const { plan } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
const { plans, launch } = pricingContent(locale)
const copy = plans.items[plan.id]
const cta = copy.cta && isLaunchOpen() ? launch.cta : copy.cta
const later = plan.availability === "later"
const perServer = plan.billedPer === "server"
const servers =
  plan.maxServers === null
    ? plans.serversUnlimited
    : fill(plans.serversUpTo, { count: plan.maxServers })
const lines = perServer ? [servers, ...copy.includes] : copy.includes
---

<article
  data-plan={plan.id}
  data-availability={plan.availability}
  class:list={[
    "flex flex-col rounded-xl border p-6 md:p-7",
    later
      ? "border-line border-dashed bg-base"
      : "card border-line-strong bg-surface",
  ]}
>
  <div class="flex min-h-[3.5rem] items-start justify-between gap-4">
    <div>
      <h3 class="heading-3">{planName(plan, locale)}</h3>
      <p class="label mt-2 text-ink-3">{copy.audience}</p>
    </div>
    {later && <span class="tag">{plans.later}</span>}
  </div>

  <div class="mt-8 min-h-[4.75rem]">
    {
      perServer ? (
        <>
          <p
            data-interval="month"
            class="group-has-[#billing-year:checked]/plans:hidden"
          >
            <span class="figure figure-lg">
              {formatUsd(plan.monthlyPriceUsd)}
            </span>
            <span class="mt-2 block text-ink-3">{plans.perServerMonth}</span>
          </p>
          <p
            data-interval="year"
            class="hidden group-has-[#billing-year:checked]/plans:block"
          >
            <span class="figure figure-lg">
              {formatUsd(yearlyPriceUsd(plan))}
            </span>
            <span class="mt-2 block text-ink-3">{plans.perServerYear}</span>
          </p>
        </>
      ) : (
        <p>
          {plan.startingAt && (
            <span class="label mb-2 block text-ink-3">{plans.from}</span>
          )}
          <span class="figure figure-lg text-ink-2">
            {formatUsd(plan.monthlyPriceUsd)}
          </span>
          <span class="mt-2 block text-ink-3">{plans.perMonth}</span>
        </p>
      )
    }
  </div>

  <ul class="mt-8 flex-1 divide-y divide-line border-line border-t">
    {lines.map((line) => <li class="py-3.5 text-ink-2">{line}</li>)}
  </ul>

  {
    cta && (
      <div class="mt-8">
        <a data-emphasis="main" href={SIGNUP_URL} class="btn btn-primary w-full">
          {cta}
        </a>
      </div>
    )
  }
</article>
