---
import { FREE_SERVERS } from "@pupitre/shared/plans"
import { homeContent } from "../content/site/home"
import Base from "../layouts/Base.astro"
import { fill, localeFromPath, translator } from "../lib/i18n"
import {
  faqPage,
  jsonLd,
  organization,
  softwareApplication,
} from "../lib/structured-data"
import CatalogList from "./CatalogList.astro"
import Claim from "./Claim.astro"
import ClosingCta from "./ClosingCta.astro"
import Faq from "./Faq.astro"
import Feature from "./Feature.astro"
import FreeNote from "./FreeNote.astro"
import Hero from "./Hero.astro"
import NameNote from "./NameNote.astro"
import Section from "./Section.astro"
import Steps from "./Steps.astro"

const locale = localeFromPath(Astro.url.pathname)
const t = translator(locale)
const content = homeContent(locale)
const servers = { count: FREE_SERVERS }

const steps = content.steps.items.map((item) => ({
  title: item.title,
  detail: fill(item.detail, servers),
}))
const faq = content.faq.items.map((item) => ({
  question: item.question,
  answer: fill(item.answer, servers),
}))

const application = jsonLd(
  softwareApplication({
    locale,
    name: t("site.name"),
    description: content.meta.description,
  })
)
const company = jsonLd(organization({ name: t("site.name"), locale }))
const questions = jsonLd(faqPage(faq))
---

<Base title={content.meta.title} description={content.meta.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={application} />
    <script is:inline type="application/ld+json" set:html={company} />
    <script is:inline type="application/ld+json" set:html={questions} />
  </Fragment>

  <Hero />

  <Section
    id="steps"
    align="center"
    label={content.steps.label}
    title={content.steps.title}
    lead={content.steps.lead}
    tone="surface"
  >
    <Steps items={steps} />
  </Section>

  <Section
    id="features"
    align="center"
    label={content.features.label}
    title={content.features.title}
  >
    <div class="reveal-group grid gap-6 md:grid-cols-3">
      {
        content.features.items.map((item) => (
          <Feature title={item.title} lines={item.lines} />
        ))
      }
    </div>
  </Section>

  <Section
    id="clients"
    align="center"
    label={content.clients.label}
    title={content.clients.title}
    lead={content.clients.lead}
    tone="surface"
  >
    <div class="reveal-group grid gap-6 md:grid-cols-3">
      {
        content.clients.items.map((item) => (
          <Feature title={item.title} lines={item.lines} />
        ))
      }
    </div>
    <p class="reveal mx-auto mt-14 max-w-2xl text-center text-ink-3">
      {content.clients.note}
    </p>
  </Section>

  <Section
    id="promise"
    align="center"
    label={content.promise.label}
    title={content.promise.title}
  >
    <div class="reveal-group mx-auto grid max-w-4xl gap-x-12 gap-y-14 sm:grid-cols-2">
      {
        content.promise.items.map((item) => (
          <Claim statement={item.statement} proof={item.proof} />
        ))
      }
    </div>
  </Section>

  <Section
    id="catalog"
    align="center"
    label={content.catalog.label}
    title={content.catalog.title}
    lead={content.catalog.lead}
    tone="surface"
  >
    <CatalogList />
  </Section>

  <Section
    id="pricing"
    align="center"
    label={content.pricing.label}
    title={fill(content.pricing.title, servers)}
  >
    <FreeNote />
  </Section>

  <Section
    id="faq"
    align="center"
    label={content.faq.label}
    title={content.faq.title}
    tone="surface"
  >
    <Faq items={faq} />
  </Section>

  <NameNote />

  <ClosingCta
    title={content.cta.title}
    lead={content.cta.lead}
    signUp={content.cta.signUp}
    docs={content.cta.docs}
  />
</Base>
