---
interface Props {
  label: string
  title: string
  lead?: string
}

const { label, title, lead } = Astro.props
---

<header class="border-line border-b">
  <div class="shell py-16 md:py-24">
    <p class="eyebrow max-w-lg">{label}</p>
    <h1 class="heading-1 mt-6 max-w-3xl">{title}</h1>
    {lead && <p class="lead mt-6 max-w-2xl text-ink-2">{lead}</p>}
    <div class="mt-8 empty:hidden">
      <slot />
    </div>
  </div>
</header>
