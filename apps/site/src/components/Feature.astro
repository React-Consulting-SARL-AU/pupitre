---
interface Props {
  title: string
  lines: string[]
  index?: string
}

const { title, lines, index } = Astro.props
---

<article class="card flex h-full flex-col p-6 md:p-7">
  {index && <p class="index-mark">{index}</p>}
  <h3 class="heading-3 mt-3">{title}</h3>
  <ul class="mt-5 flex-1 divide-y divide-line">
    {lines.map((line) => <li class="py-3.5 text-ink-2">{line}</li>)}
  </ul>
</article>
