---
interface Props {
  title: string
  lines: string[]
}

const { title, lines } = Astro.props
---

<article class="card-soft flex h-full flex-col p-8 md:p-10">
  <h3 class="heading-3">{title}</h3>
  <ul class="mt-6 flex flex-1 flex-col gap-4">
    {lines.map((line) => <li class="body-lg text-ink-2">{line}</li>)}
  </ul>
</article>
