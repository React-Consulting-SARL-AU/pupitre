---
interface Props {
  title: string
  lines: string[]
}

const { title, lines } = Astro.props
---

<article class="border-line-strong border-t pt-5">
  <h3 class="heading-3">{title}</h3>
  <ul class="mt-4 divide-y divide-line">
    {lines.map((line) => <li class="py-3 text-ink-2">{line}</li>)}
  </ul>
</article>
