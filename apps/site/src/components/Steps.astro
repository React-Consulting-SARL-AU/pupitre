---
import type { StepItem } from "../content/site/home"

interface Props {
  items: StepItem[]
}

const { items } = Astro.props
---

<ol class="reveal-group grid gap-6 md:grid-cols-3">
  {
    items.map((item, position) => (
      <li class="card-soft p-8 md:p-10">
        <p class="step-number">{position + 1}</p>
        <h3 class="heading-3 mt-6">{item.title}</h3>
        <p class="body-lg mt-4 text-ink-2">{item.detail}</p>
      </li>
    ))
  }
</ol>
