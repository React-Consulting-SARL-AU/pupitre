---
import { CATALOG } from "../content/site/catalog"
import { MODULE_LABELS, servicesOverviewLead } from "../content/site/docs"
import Docs from "../layouts/Docs.astro"
import { docPath, moduleSlug, SERVICES_SLUG } from "../lib/docs"
import { docsSections } from "../lib/docs-entries"
import { localeFromPath } from "../lib/i18n"

const locale = localeFromPath(Astro.url.pathname)
const sections = await docsSections(locale)
---

<Docs
  title={MODULE_LABELS.overviewTitle[locale]}
  description={servicesOverviewLead(locale)}
  section={MODULE_LABELS.overviewTitle[locale]}
  slug={SERVICES_SLUG}
  sections={sections}
>
  {
    CATALOG.map((group) => (
      <>
        <h2 id={group.id}>{group.label[locale]}</h2>
        <ul class="not-prose mt-5 grid gap-4 sm:grid-cols-2">
          {group.entries.map((entry) => (
            <li>
              <a
                href={docPath(moduleSlug(entry.id), locale)}
                class="card-link block h-full p-5"
              >
                <span class="flex items-baseline gap-3">
                  <span class="heading-4 text-ink">{entry.name[locale]}</span>
                </span>
                <span class="data mt-1.5 block text-ink-4">{entry.id}</span>
                <span class="mt-2 block text-ink-2">{entry.detail[locale]}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    ))
  }
</Docs>
