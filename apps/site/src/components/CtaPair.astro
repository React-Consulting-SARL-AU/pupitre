---
export interface CtaAction {
  href: string
  label: string
}

interface Props {
  main: CtaAction
  secondary: CtaAction
}

const { main, secondary } = Astro.props
---

<div class="mt-10 flex flex-wrap justify-center gap-3">
  <a data-emphasis="main" href={main.href} class="btn btn-lg btn-primary"
    >{main.label}</a
  >
  <a
    data-emphasis="secondary"
    href={secondary.href}
    class="btn btn-lg btn-secondary">{secondary.label}</a
  >
</div>
