---
import { localeFromPath, localizePath, translator } from "../lib/i18n"

interface Props {
  size?: "sm" | "lg"
}

const { size = "sm" } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
const t = translator(locale)
---

<a
  href={localizePath("/", locale)}
  class="group flex items-center gap-2.5 rounded-sm text-ink"
>
  <span
    aria-hidden="true"
    data-size={size}
    class:list={[
      "brand-glyph grid place-items-center rounded-lg bg-inverse font-medium text-inverse-ink shadow-raised",
      size === "lg" ? "size-9" : "size-7",
    ]}>&gt;_</span
  >
  <span data-size={size} class="brand-wordmark">{t("site.name")}</span>
</a>
