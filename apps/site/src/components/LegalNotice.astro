---
import { developmentNotice } from "@pupitre/shared/legal"
import { localeFromPath } from "../lib/i18n"

const notice = developmentNotice(localeFromPath(Astro.url.pathname))
---

<aside
  role="note"
  class="shell pt-10 md:pt-14"
  aria-label={notice.title}
>
  <div
    class="rounded-xl border-2 border-warn bg-surface px-6 py-6 md:px-8 md:py-8"
  >
    <p class="label text-ink-2">{notice.label}</p>
    <p class="heading-3 mt-3 text-ink">{notice.title}</p>
    <p class="body-lg mt-4 max-w-3xl text-ink-2">{notice.body}</p>
    <p class="mt-3 max-w-3xl text-ink-2">{notice.entity}</p>
  </div>
</aside>
