---
import { CATALOG } from "../content/site/catalog"
import { localeFromPath } from "../lib/i18n"
import BrandLogo from "./BrandLogo.astro"

const locale = localeFromPath(Astro.url.pathname)
---

<div class="reveal-group gap-6 md:columns-2 lg:columns-3">
  {
    CATALOG.map((group) => (
      <section
        data-category={group.id}
        aria-label={group.label[locale]}
        class="card-soft mb-6 break-inside-avoid p-7 md:p-8"
      >
        <header class="flex items-baseline gap-3">
          <h3 class="heading-3">{group.label[locale]}</h3>
          {group.note && (
            <span class="label text-ink-3">{group.note[locale]}</span>
          )}
        </header>

        <ul class="mt-5 flex flex-col gap-4">
          {group.entries.map((entry) => (
            <li data-module={entry.id} class="flex items-center gap-3">
              <BrandLogo name={entry.name[locale]} module={entry.id} />
              <p class="heading-4">{entry.name[locale]}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
