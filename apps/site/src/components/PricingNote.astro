---
import {
  ANNUAL_FREE_MONTHS,
  formatUsd,
  getPlan,
  TRIAL_DAYS,
  yearlyPriceUsd,
} from "@pupitre/shared/plans"
import { homeContent } from "../content/site/home"
import { fill, localeFromPath, localizePath, planName } from "../lib/i18n"

const locale = localeFromPath(Astro.url.pathname)
const { pricing } = homeContent(locale)
const solo = getPlan("solo")
const team = getPlan("team")
const hosted = getPlan("hosted")

const lines = [
  fill(pricing.annual, {
    months: ANNUAL_FREE_MONTHS,
    yearly: formatUsd(yearlyPriceUsd(solo)),
  }),
  fill(pricing.trial, { days: TRIAL_DAYS }),
  fill(pricing.hosted, {
    hosted: planName(hosted, locale),
    price: formatUsd(hosted.monthlyPriceUsd),
  }),
]
---

<div class="card grid gap-x-12 gap-y-8 p-8 md:grid-cols-[auto_1fr] md:p-12">
  <p class="figure text-[clamp(64px,44px+3.5vw,104px)]">
    {formatUsd(solo.monthlyPriceUsd)}
  </p>
  <div class="max-w-xl">
    <p class="lead">
      {
        fill(pricing.perServer, {
          price: formatUsd(solo.monthlyPriceUsd),
          solo: planName(solo, locale),
          team: planName(team, locale),
        })
      }
    </p>
    <ul class="mt-6 divide-y divide-line border-line border-y text-ink-2">
      {lines.map((line) => <li class="py-3.5">{line}</li>)}
    </ul>
    <a
      href={localizePath("/pricing/", locale)}
      class="link-underline mt-6 inline-block py-2"
    >
      {pricing.link}
    </a>
  </div>
</div>
