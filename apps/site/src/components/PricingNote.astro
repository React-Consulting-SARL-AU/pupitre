---
import {
  ANNUAL_FREE_MONTHS,
  getPlan,
  TRIAL_DAYS,
  yearlyPriceEur,
} from "@pupitre/shared/plans"
import { homeContent } from "../content/site/home"
import { fill, localeFromPath, localizePath, planName } from "../lib/i18n"

const locale = localeFromPath(Astro.url.pathname)
const { pricing } = homeContent(locale)
const solo = getPlan("solo")
const team = getPlan("team")
const hosted = getPlan("hosted")
---

<div class="grid gap-x-16 gap-y-8 md:grid-cols-[auto_1fr] md:items-start">
  <p class="font-display font-bold text-[clamp(56px,40px+3vw,88px)] tracking-tight tabular-nums leading-none">
    {solo.monthlyPriceEur} €
  </p>
  <div class="max-w-xl">
    <p class="lead">
      {
        fill(pricing.perServer, {
          price: solo.monthlyPriceEur,
          solo: planName(solo, locale),
          team: planName(team, locale),
        })
      }
    </p>
    <ul class="mt-6 divide-y divide-line border-line border-y text-ink-2">
      <li class="py-3">
        {
          fill(pricing.annual, {
            months: ANNUAL_FREE_MONTHS,
            yearly: yearlyPriceEur(solo),
          })
        }
      </li>
      <li class="py-3">{fill(pricing.trial, { days: TRIAL_DAYS })}</li>
      <li class="py-3 text-ink-3">
        {
          fill(pricing.hosted, {
            hosted: planName(hosted, locale),
            price: hosted.monthlyPriceEur,
          })
        }
      </li>
    </ul>
    <a
      href={localizePath("/pricing/", locale)}
      class="mt-6 inline-block py-2 font-medium text-ink underline underline-offset-4"
    >
      {pricing.link}
    </a>
  </div>
</div>
