---
import { LIGHT } from "@pupitre/design/tokens"
import Analytics from "../components/Analytics.astro"
import DevelopmentBanner from "../components/DevelopmentBanner.astro"
import Footer from "../components/Footer.astro"
import Nav from "../components/Nav.astro"
import "../styles/global.css"
import { AFFILIATE_BOOT_SCRIPT } from "../lib/affiliate"
import {
  alternateLocale,
  type Locale,
  localeFromPath,
  localizePath,
  translator,
} from "../lib/i18n"
import { alternateLinks, canonicalUrl, ogUrl } from "../lib/seo"
import { THEME_BOOT_SCRIPT } from "../lib/theme"

interface Props {
  title: string
  description: string
  noIndex?: boolean
}

const OG_LOCALES: Record<Locale, string> = { en: "en_US", fr: "fr_FR" }
const FONTS_HREF =
  "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&family=JetBrains+Mono:wght@400;500&display=swap"

const { title, description, noIndex = false } = Astro.props
const pathname = Astro.url.pathname
const locale = localeFromPath(pathname)
const t = translator(locale)
const canonical = canonicalUrl(pathname)
const image = ogUrl(pathname)
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={THEME_BOOT_SCRIPT} />
    <script is:inline set:html={AFFILIATE_BOOT_SCRIPT} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={LIGHT.base} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={LIGHT.ink} media="(prefers-color-scheme: dark)" />
    {noIndex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {
      alternateLinks(pathname).map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t("blog.label")}
      href={localizePath("/blog/rss.xml", locale)}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    <meta
      property="og:locale:alternate"
      content={OG_LOCALES[alternateLocale(locale)]}
    />
    <meta property="og:site_name" content={t("site.name")} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={FONTS_HREF}
      media="print"
      onload="this.media='all'"
    />
    <noscript><link rel="stylesheet" href={FONTS_HREF} /></noscript>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-base text-ink">
    <a href="#main" class="skip-link">{t("a11y.skip")}</a>
    <DevelopmentBanner />
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
