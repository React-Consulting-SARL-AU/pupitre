---
import "../styles/global.css"

interface Props {
  title: string
  lang?: "en" | "fr"
}

const { title, lang = "en" } = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-base text-ink">
    <slot />
  </body>
</html>
