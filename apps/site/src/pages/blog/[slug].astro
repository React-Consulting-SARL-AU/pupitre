---
import { getCollection, render } from "astro:content"
import Post from "../../layouts/Post.astro"
import { docSlug } from "../../lib/docs"
import { localizePath, translator } from "../../lib/i18n"

export async function getStaticPaths() {
  const posts = await getCollection(
    "blog",
    (entry) => entry.data.locale === "en"
  )

  return posts.map((entry) => ({
    params: { slug: docSlug(entry.id) },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const t = translator("en")
---

<Post
  title={entry.data.title}
  description={entry.data.description}
  label={t("blog.label")}
  index={String(entry.data.order).padStart(2, "0")}
  date={entry.data.date}
  meta={[entry.data.reading, `${t("blog.by")} ${entry.data.author}`]}
  backHref={localizePath("/blog/", "en")}
  backLabel={t("blog.back")}
>
  <Content />
</Post>
