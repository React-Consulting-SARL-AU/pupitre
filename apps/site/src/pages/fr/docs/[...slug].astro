---
import { getCollection, render } from "astro:content"
import { DOCS_SECTION_META } from "../../../content/site/docs"
import Docs from "../../../layouts/Docs.astro"
import { docSlug, sectionOf } from "../../../lib/docs"
import { docsSections } from "../../../lib/docs-entries"

export async function getStaticPaths() {
  const docs = await getCollection(
    "docs",
    (entry) => entry.data.locale === "fr"
  )

  return docs.map((entry) => ({
    params: { slug: docSlug(entry.id) },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const sections = await docsSections("fr")
const section = DOCS_SECTION_META[sectionOf(entry.data.section)].title.fr
---

<Docs
  title={entry.data.title}
  description={entry.data.description}
  section={section}
  slug={docSlug(entry.id)}
  sections={sections}
  headings={headings}
>
  <Content />
</Docs>
