---
import { getCollection, render } from "astro:content"
import Post from "../../../layouts/Post.astro"
import { docSlug } from "../../../lib/docs"
import { localizePath, translator } from "../../../lib/i18n"

export async function getStaticPaths() {
  const posts = await getCollection(
    "blog",
    (entry) => entry.data.locale === "fr"
  )

  return posts.map((entry) => ({
    params: { slug: docSlug(entry.id) },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const t = translator("fr")
---

<Post
  title={entry.data.title}
  description={entry.data.description}
  label={t("blog.label")}
  date={entry.data.date}
  meta={[entry.data.reading, `${t("blog.by")} ${entry.data.author}`]}
  backHref={localizePath("/blog/", "fr")}
  backLabel={t("blog.back")}
  translation={entry.data.translation}
>
  <Content />
</Post>
