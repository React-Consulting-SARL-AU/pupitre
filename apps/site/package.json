{
  "name": "@pupitre/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "build:production": "PUPITRE_ENV=production PUBLIC_RELEASES_URL=https://app.pupitre.studio/api/v1/releases/app astro build",
    "deploy:production": "wrangler deploy --env production",
    "preview": "astro preview --port 4321",
    "lint": "ultracite check && bun run check:content",
    "lint:fix": "ultracite fix",
    "check:types": "astro check",
    "check:content": "bun scripts/check-content.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/mdx": "^4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@pupitre/design": "workspace:*",
    "@pupitre/shared": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^5.18.2",
    "posthog-js": "^1.427.2",
    "satori": "^0.33.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "ultracite": "7.8.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.131.1"
  }
}
