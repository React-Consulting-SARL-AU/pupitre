# La ligne de secrets suit la requête sur l'entrée standard, jamais sur un descripteur séparé.
> {"id":1,"cmd":"hello","params":{"app_version":"0.2.0","protocol":2}}
> {"id":2,"cmd":"install","params":{"modules":["tool.github"],"config":{},"secrets_stdin":true}}
$ {"API_KEY":"s3cret-de-test"}
> {"id":3,"cmd":"install","params":{"modules":["tool.github"],"config":{},"secrets_stdin":true}}
$ not json
# Une ligne de secrets oubliée ne mange pas la requête suivante.
> {"id":4,"cmd":"install","params":{"modules":["tool.github"],"config":{},"secrets_stdin":true}}
> {"id":5,"cmd":"ping"}
