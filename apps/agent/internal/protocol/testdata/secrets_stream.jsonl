# La ligne de secrets suit la requête sur l'entrée standard, jamais sur un descripteur séparé.
> {"id":1,"cmd":"hello","params":{"app_version":"0.2.0","protocol":1}}
< {"id":1,"ok":true,"result":{"agent_version":"0.0.0-test","protocol":1,"entitlement":"dev","capabilities":["hello","ping","probe","project.logs","reboot","secrets.set"]}}
> {"id":2,"cmd":"secrets.set","params":{"key":"API_KEY","secrets_stdin":true}}
$ {"API_KEY":"s3cret-de-test"}
< {"id":2,"ok":true,"result":{"keys":["API_KEY"]}}
> {"id":3,"cmd":"secrets.set","params":{"key":"OTHER","secrets_stdin":true}}
$ not json
< {"id":3,"ok":false,"error":{"code":"bad_request","message":"ligne de secrets illisible : un objet JSON sur une ligne est attendu","fix":"Écris les secrets en JSON sur une seule ligne de l'entrée standard, juste après la requête : {\"<clé>\":\"<valeur>\"}."}}
# Une ligne de secrets oubliée ne mange pas la requête suivante.
> {"id":4,"cmd":"secrets.set","params":{"key":"FORGOTTEN","secrets_stdin":true}}
> {"id":5,"cmd":"ping"}
< {"id":4,"ok":false,"error":{"code":"bad_request","message":"ligne de secrets absente : la ligne suivante est une requête","fix":"Écris les secrets en JSON sur une seule ligne de l'entrée standard, juste après la requête : {\"<clé>\":\"<valeur>\"}."}}
< {"id":5,"ok":true,"result":{"ts":"2026-09-04T12:00:00Z"}}
