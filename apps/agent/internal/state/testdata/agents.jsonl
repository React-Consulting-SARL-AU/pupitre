# Ouvrir un agent dans un projet : la commande tmux, la racine du dépôt même quand le processus tourne dans un sous-dossier, et les refus quand l'agent ou le projet manque.
@file /etc/pupitre/projects.conf web|web|-|bun|127.0.0.1|3000|web|bun run dev --port 3000
@line /etc/pupitre/projects.conf api|api/server|-|bun|127.0.0.1|3001|api|bun run dev
@file /home/dev/.local/bin/mise mise
@file /home/dev/.local/bin/claude claude
@reply claude 2.1.263 (Claude Code)
@tool npm:@openai/codex latest
