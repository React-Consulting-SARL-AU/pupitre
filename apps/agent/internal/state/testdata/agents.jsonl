# Ouvrir un agent dans un projet : la commande tmux, le bon dossier, et les refus quand l'agent ou le projet manque.
@file /etc/pupitre/projects.conf web|web|-|bun|127.0.0.1|3000|web|bun run dev --port 3000
@line /etc/pupitre/projects.conf api|api/server|-|bun|127.0.0.1|3001|api|bun run dev
@file /home/dev/.local/bin/mise mise
@tool npm:@anthropic-ai/claude-code latest
@tool npm:@openai/codex latest
> {"id":1,"cmd":"hello","params":{"app_version":"0.2.0","protocol":1}}
> {"id":2,"cmd":"agent.open","params":{"kind":"claude","project":"web"}}
> {"id":3,"cmd":"agent.open","params":{"kind":"codex","project":"api"}}
> {"id":4,"cmd":"agent.open","params":{"kind":"hermes","project":"web"}}
> {"id":5,"cmd":"agent.open","params":{"kind":"claude","project":"absent"}}
> {"id":6,"cmd":"agent.open","params":{"kind":"cursor","project":"web"}}
< {"id":1,"ok":true,"result":{"agent_version":"0.0.0-test","protocol":1,"entitlement":"dev","capabilities":["agent.open","catalog","completions","diag","doctor","hello","install","install.check","module.config","ping","process.kill","processes.list","project.add","project.branches","project.checkout","project.detect","project.diff","project.down","project.git_status","project.install","project.list","project.logs","project.remove","project.restart","project.sync","project.up","project.url","project.working_tree","reboot","report","service.secret","service.status","sessions.clean","sessions.list","shots.clean","shots.list","shots.read","shots.url","snapshot","status","uninstall","upgrade"]}}
< {"id":2,"ok":true,"result":{"command":"tmux new-session -A -s claude-web -c /home/dev/projects/web claude","session":"claude-web"}}
< {"id":3,"ok":true,"result":{"command":"tmux new-session -A -s codex-api -c /home/dev/projects/api/server codex","session":"codex-api"}}
< {"id":4,"ok":false,"error":{"code":"service_not_found","message":"Hermes Agent is not installed on this server","fix":"Install ai.hermes from the app's catalogue."}}
< {"id":5,"ok":false,"error":{"code":"project_not_found","message":"unknown project: absent","fix":"Call project.list for the list of declared projects."}}
< {"id":6,"ok":false,"error":{"code":"bad_request","message":"invalid parameters: params/kind: must be one of claude, codex, hermes"}}
