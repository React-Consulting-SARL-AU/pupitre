# secrets.status ne renvoie que des clés, secrets.set lit la valeur sur le flux secret, project.env produit le .env.local du projet.
@package 1password-cli 2.32.0
@file /etc/pupitre/env OP_SERVICE_ACCOUNT_TOKEN=s3cret-de-test
@file /etc/pupitre/projects.conf web|flymate/apps/web|-|bun|web.localhost|3000|app|bun run dev
@file /home/dev/projects/flymate/apps/web/.env.1password.tpl DATABASE_URL={{ op://{{OP_VAULT}}/{{OP_ITEM}}/url }}
@file /home/dev/projects/flymate/op.config.json {"vault":"Dev","item":"flymate"}
@answer op inject :: DATABASE_URL=postgres://dev:motdepasse@127.0.0.1/flymate\nAUTH_SECRET=au-secret
> {"id":1,"cmd":"hello","params":{"app_version":"0.2.0","protocol":1}}
> {"id":2,"cmd":"secrets.status"}
> {"id":3,"cmd":"secrets.set","params":{"key":"OPENAI_API_KEY","secrets_stdin":true}}
$ {"OPENAI_API_KEY":"s3cret-de-test"}
> {"id":4,"cmd":"secrets.status"}
> {"id":5,"cmd":"project.env","params":{"name":"web"}}
> {"id":6,"cmd":"project.env","params":{"name":"web"}}
> {"id":7,"cmd":"secrets.sync","params":{"project":"web"}}
> {"id":8,"cmd":"project.env","params":{"name":"ghost"}}
< {"id":1,"ok":true,"result":{"agent_version":"0.0.0-test","protocol":1,"entitlement":"dev","capabilities":["catalog","hello","install","install.check","module.config","ping","project.env","report","secrets.set","secrets.status","secrets.sync","uninstall","upgrade"]}}
< {"id":2,"ok":true,"result":{"secrets":[{"key":"OP_SERVICE_ACCOUNT_TOKEN","set":true}]}}
< {"id":3,"ok":true,"result":{"done":true}}
< {"id":4,"ok":true,"result":{"secrets":[{"key":"OPENAI_API_KEY","set":true},{"key":"OP_SERVICE_ACCOUNT_TOKEN","set":true}]}}
< {"id":5,"ok":true,"result":{"path":"/home/dev/projects/flymate/apps/web/.env.local","written":true,"keys":["DATABASE_URL","AUTH_SECRET"]}}
< {"id":6,"ok":true,"result":{"path":"/home/dev/projects/flymate/apps/web/.env.local","written":false,"keys":["DATABASE_URL","AUTH_SECRET"]}}
< {"id":7,"ok":true,"result":{"path":"/home/dev/projects/flymate/apps/web/.env.local","written":true,"keys":["DATABASE_URL","AUTH_SECRET"]}}
< {"id":8,"ok":false,"error":{"code":"project_not_found","message":"unknown project: ghost","fix":"Call project.list for the list of declared projects."}}
