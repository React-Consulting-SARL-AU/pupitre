# db.query plays the statement through the engine's own client, as dev and with the app account, and refuses a database whose owner turned AI agents' access off.
@package postgresql-17 17.2-1.pgdg24.04+1
@package mysql-server 8.0.36-0ubuntu0.24.04.1
@package redis-server 5:7.0.15-1build2
@file /etc/pupitre/install.json {"modules":["db.postgres","db.mysql","db.redis"],"config":{"db.mysql":{"ai_access":false}},"secrets":{"db.postgres":{"app_password":"hunter2"},"db.redis":{"password":"hunter3"}}}
@answer --dbname=shop count\n-------\n3\n(1 row)
@failline --dbname=postgres ERROR:  relation "ordres" does not exist
@answer --no-raw (integer) 1\n(error) WRONGTYPE Operation against a key holding the wrong kind of value
