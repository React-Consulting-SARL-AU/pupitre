@answer mongosh pupitre-user-ready
@file /proc/meminfo MemTotal:       4015000 kB
@reply mysql 2
@answer pg_roles 2
@answer pg_extension 3
@file /etc/postgresql/17/main/pg_hba.conf local   all             postgres                                peer
