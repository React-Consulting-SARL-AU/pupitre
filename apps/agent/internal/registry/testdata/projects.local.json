{
  "projects": [
    {
      "name": "api",
      "dir": "api-server",
      "processes": [
        {
          "id": "api",
          "dir": "server",
          "pkgmgr": "gradle",
          "host": "127.0.0.1",
          "port": 8081,
          "routes": [
            { "label": "api", "port": 8081, "hostname": "api.flyleaf.dev" }
          ],
          "cmd": "SERVER_PORT=8081 ./gradlew bootRun --console=plain"
        }
      ]
    },
    {
      "name": "web",
      "dir": "web",
      "repo": "https://github.com/me/web",
      "processes": [
        {
          "id": "web",
          "dir": ".",
          "pkgmgr": "bun",
          "host": "127.0.0.1",
          "port": 3000,
          "routes": [
            { "label": "web", "port": 3000, "hostname": "web.flyleaf.dev" },
            {
              "label": "admin",
              "port": 3010,
              "hostname": "admin-web.flyleaf.dev"
            }
          ],
          "cmd": "bun run dev --host 127.0.0.1 --port 3000"
        },
        {
          "id": "mail",
          "dir": "apps/mail",
          "pkgmgr": "pnpm",
          "host": "127.0.0.1",
          "port": 5180,
          "routes": [
            { "label": "mail", "port": 5180, "hostname": "mail.flyleaf.dev" }
          ],
          "cmd": "pnpm run dev --port 5180"
        }
      ]
    },
    {
      "name": "scratch",
      "dir": "scratch",
      "processes": [
        {
          "id": "scratch",
          "pkgmgr": "none",
          "host": "127.0.0.1",
          "port": 4000,
          "routes": [],
          "cmd": "bun run dev --port 4000"
        }
      ]
    }
  ]
}
