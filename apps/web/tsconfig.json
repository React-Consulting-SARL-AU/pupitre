{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "types": ["node", "bun", "vite/client", "@cloudflare/workers-types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "cloudflare-env.d.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".output",
    ".tanstack",
    ".turbo",
    ".wrangler",
    "dist"
  ]
}
