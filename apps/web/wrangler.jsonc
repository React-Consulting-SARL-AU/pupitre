{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pupitre-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  "placement": {
    "mode": "targeted",
    "region": "aws:eu-central-1"
  },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "name": "pupitre-expire-enrollments",
      "binding": "EXPIRE_ENROLLMENTS",
      "class_name": "ExpireEnrollments"
    },
    {
      "name": "pupitre-decommission-server",
      "binding": "DECOMMISSION_SERVER",
      "class_name": "DecommissionServer"
    },
    {
      "name": "pupitre-reconcile-seats",
      "binding": "RECONCILE_SEATS",
      "class_name": "ReconcileSeats"
    },
    {
      "name": "pupitre-evaluate-alerts",
      "binding": "EVALUATE_ALERTS",
      "class_name": "EvaluateAlerts"
    },
    {
      "name": "pupitre-suspend-expired-grace",
      "binding": "SUSPEND_EXPIRED_GRACE",
      "class_name": "SuspendExpiredGrace"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *",
      "20 3 * * *",
      "40 3 * * *",
      "*/5 * * * *",
      "7 4 * * *"
    ]
  },
  // Valeurs locales du développement : staging et production les remplacent.
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:3000",
    "VITE_APP_URL": "http://localhost:3000",
    "EMAIL_FROM": "no-reply@pupitre.studio"
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "BETTER_AUTH_SECRET",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "STRIPE_PRICE_SERVER_MONTH",
      "STRIPE_PRICE_SERVER_YEAR",
      "INTERNAL_WORKFLOW_SECRET"
    ]
  }
}
