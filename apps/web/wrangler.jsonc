{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ppt-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  "placement": {
    "mode": "targeted",
    "region": "aws:us-east-1"
  },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "name": "ppt-expire-enrollments",
      "binding": "EXPIRE_ENROLLMENTS",
      "class_name": "ExpireEnrollments"
    },
    {
      "name": "ppt-decommission-server",
      "binding": "DECOMMISSION_SERVER",
      "class_name": "DecommissionServer"
    },
    {
      "name": "ppt-reconcile-seats",
      "binding": "RECONCILE_SEATS",
      "class_name": "ReconcileSeats"
    },
    {
      "name": "ppt-evaluate-alerts",
      "binding": "EVALUATE_ALERTS",
      "class_name": "EvaluateAlerts"
    },
    {
      "name": "ppt-suspend-expired-grace",
      "binding": "SUSPEND_EXPIRED_GRACE",
      "class_name": "SuspendExpiredGrace"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *",
      "20 3 * * *",
      "40 3 * * *",
      "*/5 * * * *",
      "7 4 * * *"
    ]
  },
  // Valeurs locales du développement : staging et production les remplacent.
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:3000",
    "VITE_APP_URL": "http://localhost:3000",
    "EMAIL_FROM": "no-reply@pupitre.studio"
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "BETTER_AUTH_SECRET",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "STRIPE_PRICE_SERVER_MONTH",
      "STRIPE_PRICE_SERVER_YEAR",
      "INTERNAL_WORKFLOW_SECRET",
      "TUNNEL_API_TOKEN",
      "TUNNEL_ACCOUNT_ID",
      "TUNNEL_ZONE_ID",
      "TUNNEL_ZONE_NAME",
      "TUNNEL_SIGNING_KEY",
      // Les quatre suivantes ne vivent qu'ici, jamais dans les listes de
      // staging ni de production : `secrets.required` est la seule liste que
      // Cloudflare lit, et elle fait deux choses à la fois — charger la
      // variable en développement local, et l'exiger au déploiement. La
      // connexion sociale, elle, est facultative : sans ses variables le lien
      // magique et la clé d'accès restent les chemins. Les déclarer ici les
      // fait atteindre le Worker local ; les taire là-bas laisse un
      // déploiement réussir sans elles.
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  },
  "env": {
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "upload_source_maps": true,
      "placement": {
        "mode": "targeted",
        "region": "aws:us-east-1"
      },
      "routes": [
        {
          "pattern": "staging-app.pupitre.studio",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": ".output/public",
        "binding": "ASSETS"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      },
      "workflows": [
        {
          "name": "ppt-expire-enrollments-staging",
          "binding": "EXPIRE_ENROLLMENTS",
          "class_name": "ExpireEnrollments"
        },
        {
          "name": "ppt-decommission-server-staging",
          "binding": "DECOMMISSION_SERVER",
          "class_name": "DecommissionServer"
        },
        {
          "name": "ppt-reconcile-seats-staging",
          "binding": "RECONCILE_SEATS",
          "class_name": "ReconcileSeats"
        },
        {
          "name": "ppt-evaluate-alerts-staging",
          "binding": "EVALUATE_ALERTS",
          "class_name": "EvaluateAlerts"
        },
        {
          "name": "ppt-suspend-expired-grace-staging",
          "binding": "SUSPEND_EXPIRED_GRACE",
          "class_name": "SuspendExpiredGrace"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "triggers": {
        "crons": [
          "0 * * * *",
          "20 3 * * *",
          "40 3 * * *",
          "*/5 * * * *",
          "7 4 * * *"
        ]
      },
      "vars": {
        "PUPITRE_ENVIRONMENT": "staging",
        "VITE_APP_URL": "https://staging-app.pupitre.studio",
        "BETTER_AUTH_URL": "https://staging-app.pupitre.studio",
        "EMAIL_FROM": "no-reply@pupitre.studio"
      },
      "secrets": {
        "required": [
          "DATABASE_URL",
          "BETTER_AUTH_SECRET",
          "INTERNAL_WORKFLOW_SECRET",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "STRIPE_PRICE_SERVER_MONTH",
          "STRIPE_PRICE_SERVER_YEAR",
          "R2_ACCOUNT_ID",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY",
          "TUNNEL_API_TOKEN",
          "TUNNEL_ACCOUNT_ID",
          "TUNNEL_ZONE_ID",
          "TUNNEL_ZONE_NAME",
          "TUNNEL_SIGNING_KEY",
          "R2_BUCKET_NAME"
        ]
      }
    },
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "upload_source_maps": true,
      "placement": {
        "mode": "targeted",
        "region": "aws:us-east-1"
      },
      "routes": [
        {
          "pattern": "app.pupitre.studio",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": ".output/public",
        "binding": "ASSETS"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      },
      "workflows": [
        {
          "name": "ppt-expire-enrollments",
          "binding": "EXPIRE_ENROLLMENTS",
          "class_name": "ExpireEnrollments"
        },
        {
          "name": "ppt-decommission-server",
          "binding": "DECOMMISSION_SERVER",
          "class_name": "DecommissionServer"
        },
        {
          "name": "ppt-reconcile-seats",
          "binding": "RECONCILE_SEATS",
          "class_name": "ReconcileSeats"
        },
        {
          "name": "ppt-evaluate-alerts",
          "binding": "EVALUATE_ALERTS",
          "class_name": "EvaluateAlerts"
        },
        {
          "name": "ppt-suspend-expired-grace",
          "binding": "SUSPEND_EXPIRED_GRACE",
          "class_name": "SuspendExpiredGrace"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "triggers": {
        "crons": [
          "0 * * * *",
          "20 3 * * *",
          "40 3 * * *",
          "*/5 * * * *",
          "7 4 * * *"
        ]
      },
      "vars": {
        "PUPITRE_ENVIRONMENT": "production",
        "VITE_APP_URL": "https://app.pupitre.studio",
        "BETTER_AUTH_URL": "https://app.pupitre.studio",
        "EMAIL_FROM": "no-reply@pupitre.studio"
      },
      "secrets": {
        "required": [
          "DATABASE_URL",
          "BETTER_AUTH_SECRET",
          "INTERNAL_WORKFLOW_SECRET",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "STRIPE_PRICE_SERVER_MONTH",
          "STRIPE_PRICE_SERVER_YEAR",
          "R2_ACCOUNT_ID",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY",
          "TUNNEL_API_TOKEN",
          "TUNNEL_ACCOUNT_ID",
          "TUNNEL_ZONE_ID",
          "TUNNEL_ZONE_NAME",
          "TUNNEL_SIGNING_KEY",
          "R2_BUCKET_NAME"
        ]
      }
    }
  }
}
