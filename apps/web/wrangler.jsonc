{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ppt-web",
  "account_id": "455fb79f0597ba46bed6a877563540e0",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  // The database and the buckets live in Eastern North America (ENAM): smart
  // placement runs the Worker beside them, instead of at the edge nearest the
  // caller and an ocean away from every query.
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  // One D1 per environment, and the local one miniflare keeps under
  // .wrangler/state. The migrations are the db package's: `bun run db:migrate
  // <local|production>` applies them through wrangler.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ppt-db-local",
      "database_id": "ppt-db-local",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Everything a mail carries beyond its text: the raw message, its HTML body
  // and its attachments. D1 keeps the thread, the bucket keeps the bytes.
  "r2_buckets": [
    {
      "binding": "MAIL",
      "bucket_name": "ppt-mail"
    }
  ],
  // The inbox's realtime room: one object for the whole platform, which keeps
  // nothing and only broadcasts what a write just did. The console's socket is
  // GET /api/v1/admin/inbox/events.
  "durable_objects": {
    "bindings": [
      { "name": "INBOX_REALTIME", "class_name": "InboxRealtime" },
      { "name": "RATE_LIMIT", "class_name": "RateLimit" }
    ]
  },
  // The budgets every isolate shares: eight shards, keys spread by hash, the
  // API's fixed windows and the auth routes' rolling rules in one object.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["InboxRealtime"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimit"] }
  ],
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "name": "ppt-expire-enrollments",
      "binding": "EXPIRE_ENROLLMENTS",
      "class_name": "ExpireEnrollments"
    },
    {
      "name": "ppt-decommission-server",
      "binding": "DECOMMISSION_SERVER",
      "class_name": "DecommissionServer"
    },
    {
      "name": "ppt-reconcile-seats",
      "binding": "RECONCILE_SEATS",
      "class_name": "ReconcileSeats"
    },
    {
      "name": "ppt-evaluate-alerts",
      "binding": "EVALUATE_ALERTS",
      "class_name": "EvaluateAlerts"
    },
    {
      "name": "ppt-suspend-expired-grace",
      "binding": "SUSPEND_EXPIRED_GRACE",
      "class_name": "SuspendExpiredGrace"
    },
    {
      "name": "ppt-purge-deletions",
      "binding": "PURGE_DELETIONS",
      "class_name": "PurgeDeletions"
    }
  ],
  // Two wakes, not five: the hourly workflows start together and the daily ones
  // together, so the database sleeps between two passes instead of being woken
  // every quarter of an hour. Which workflows each cron starts is in
  // src/workflows/registry.ts.
  "triggers": {
    "crons": ["0 * * * *", "20 3 * * *"]
  },
  // Local development values: the production environment replaces them.
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:3000",
    "VITE_APP_URL": "http://localhost:3000",
    "EMAIL_FROM": "no-reply@pupitre.studio",
    "PUPITRE_DOWNLOADS_URL": "https://dl.pupitre.studio",
    "R2_MAIL_BUCKET_NAME": "ppt-mail",
    "BILLING_MODE": "off"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "INTERNAL_WORKFLOW_SECRET",
      "PUPITRE_PUBLISH_TOKEN",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  },
  "env": {
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "upload_source_maps": true,
      "placement": {
        "mode": "smart"
      },
      "routes": [
        {
          "pattern": "app.pupitre.studio",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": ".output/public",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ppt-db-enam",
          "database_id": "89b05eda-2e19-4643-a383-935836b4bbd8",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MAIL",
          "bucket_name": "ppt-mail"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "INBOX_REALTIME", "class_name": "InboxRealtime" },
          { "name": "RATE_LIMIT", "class_name": "RateLimit" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["InboxRealtime"] },
        { "tag": "v2", "new_sqlite_classes": ["RateLimit"] }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      },
      "workflows": [
        {
          "name": "ppt-expire-enrollments",
          "binding": "EXPIRE_ENROLLMENTS",
          "class_name": "ExpireEnrollments"
        },
        {
          "name": "ppt-decommission-server",
          "binding": "DECOMMISSION_SERVER",
          "class_name": "DecommissionServer"
        },
        {
          "name": "ppt-reconcile-seats",
          "binding": "RECONCILE_SEATS",
          "class_name": "ReconcileSeats"
        },
        {
          "name": "ppt-evaluate-alerts",
          "binding": "EVALUATE_ALERTS",
          "class_name": "EvaluateAlerts"
        },
        {
          "name": "ppt-suspend-expired-grace",
          "binding": "SUSPEND_EXPIRED_GRACE",
          "class_name": "SuspendExpiredGrace"
        },
        {
          "name": "ppt-purge-deletions",
          "binding": "PURGE_DELETIONS",
          "class_name": "PurgeDeletions"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "triggers": {
        "crons": ["0 * * * *", "20 3 * * *"]
      },
      "vars": {
        "PUPITRE_ENVIRONMENT": "production",
        "VITE_APP_URL": "https://app.pupitre.studio",
        "BETTER_AUTH_URL": "https://app.pupitre.studio",
        "EMAIL_FROM": "no-reply@pupitre.studio",
        "PUPITRE_DOWNLOADS_URL": "https://dl.pupitre.studio",
        "R2_MAIL_BUCKET_NAME": "ppt-mail",
        "BILLING_MODE": "off"
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "INTERNAL_WORKFLOW_SECRET",
          "R2_ACCOUNT_ID",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY",
          "R2_BUCKET_NAME",
          "PUPITRE_PUBLISH_TOKEN",
          "GITHUB_CLIENT_ID",
          "GITHUB_CLIENT_SECRET",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET"
        ]
      }
    }
  }
}
