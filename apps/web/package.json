{
  "name": "@pupitre/web",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "MINIFLARE_WORKERD_V8_FLAGS=--max-old-space-size=4096 NODE_OPTIONS=--max-old-space-size=6144 vite dev --port 3000",
    "dev:tunnel": "bun ../../scripts/dev-tunnel.ts",
    "dev:stripe": "bun ../../scripts/dev-stripe.ts",
    "build": "vite build",
    "build:cloudflare": "bun --cwd=../../packages/db run db:generate && bun run build",
    "build:production": "PUPITRE_ALLOW_MIGRATE_ON=production bun --cwd=../../packages/db run db:migrate production && CLOUDFLARE_ENV=production bun run build:cloudflare",
    "check:secrets": "bun ../../scripts/check-worker-secrets.ts",
    "deploy:production": "bun run check:secrets production && wrangler deploy --config dist/server/wrangler.json --keep-vars",
    "preview": "vite preview --port 3000",
    "cf-typegen": "wrangler types",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "check:types": "tsgo --noEmit --pretty false",
    "test": "bun test --timeout=60000 src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui-components/react": "catalog:",
    "@hookform/resolvers": "^5.9.1",
    "@pupitre/api": "workspace:*",
    "@pupitre/auth": "workspace:*",
    "@pupitre/db": "workspace:*",
    "@pupitre/design": "workspace:*",
    "@pupitre/shared": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "clsx": "^2.1.1",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.87.0",
    "react-markdown": "catalog:",
    "tailwind-merge": "^3.6.0",
    "uqr": "0.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "catalog:",
    "@happy-dom/global-registrator": "catalog:",
    "@playwright/test": "catalog:",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "^8.2.2",
    "wrangler": "catalog:"
  }
}
