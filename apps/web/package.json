{
  "name": "@pupitre/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "MINIFLARE_V8_FLAGS=--max-old-space-size=4096 NODE_OPTIONS=--max-old-space-size=6144 vite dev --port 3000",
    "dev:tunnel": "bun ../../scripts/dev-tunnel.ts",
    "dev:stripe": "stripe listen --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.payment_failed --forward-to http://localhost:3000/api/v1/webhooks/stripe",
    "build": "vite build",
    "build:cloudflare": "bun --cwd=../../packages/db run db:generate && bun run build",
    "build:production": "PUPITRE_ALLOW_MIGRATE_ON=production bun --cwd=../../packages/db run db:migrate production && CLOUDFLARE_ENV=production bun run build:cloudflare",
    "check:secrets": "bun ../../scripts/check-worker-secrets.ts",
    "deploy:production": "bun run check:secrets production && wrangler deploy --config dist/server/wrangler.json --keep-vars",
    "preview": "vite preview --port 3000",
    "cf-typegen": "wrangler types",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "check:types": "tsgo --noEmit --pretty false",
    "test": "bun test --timeout=60000 src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@hookform/resolvers": "^5.9.1",
    "@pupitre/api": "workspace:*",
    "@pupitre/auth": "workspace:*",
    "@pupitre/db": "workspace:*",
    "@pupitre/design": "workspace:*",
    "@pupitre/shared": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-start": "^1.168.50",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "uqr": "0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260908.1",
    "@happy-dom/global-registrator": "^20.14.0",
    "@playwright/test": "^1.63.0",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "7.11.1",
    "vite": "^8.2.2",
    "wrangler": "^4.131.1"
  }
}
