{
  "name": "@pupitre/desktop",
  "version": "0.3.0",
  "description": "Pupitre desktop app: drives a remote development server over SSH",
  "homepage": "https://pupitre.studio",
  "desktopName": "pupitre.desktop",
  "author": "Jordan Monier <no-reply@pupitre.studio>",
  "main": "out/main/index.cjs",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "bun run check:types && electron-vite build",
    "preview": "electron-vite preview",
    "icons": "bun scripts/icons.ts",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "lint": "ultracite check && bun run check:i18n",
    "lint:fix": "ultracite fix",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:types": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "bun test --timeout=60000 src",
    "test:e2e": "bun run build && playwright test",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@pupitre/auth": "workspace:*",
    "@pupitre/design": "workspace:*",
    "@pupitre/shared": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.38.0",
    "node-pty": "^1.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/plugin-transform-arrow-functions": "^8.0.1",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@pupitre/api": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "ultracite": "7.8.3",
    "vite": "^7.3.5"
  }
}
