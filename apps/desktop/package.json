{
  "name": "@pupitre/desktop",
  "version": "2.0.0",
  "description": "Pupitre desktop app: drives a remote development server over SSH",
  "homepage": "https://pupitre.studio",
  "desktopName": "pupitre.desktop",
  "author": "Jordan Monier <no-reply@pupitre.studio>",
  "main": "out/main/index.cjs",
  "type": "module",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "bun run check:types && electron-vite build",
    "preview": "electron-vite preview",
    "icons": "bun scripts/icons.ts",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "lint": "ultracite check && bun run check:i18n",
    "lint:fix": "ultracite fix",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:types": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "bun test --timeout=60000 src",
    "test:e2e": "bun run build && playwright test",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-arrow-functions": "^8.0.1",
    "@base-ui-components/react": "catalog:",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@electron/rebuild": "^4.2.0",
    "@happy-dom/global-registrator": "catalog:",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "catalog:",
    "@pupitre/api": "workspace:*",
    "@pupitre/auth": "workspace:*",
    "@pupitre/design": "workspace:*",
    "@pupitre/shared": "workspace:*",
    "@resvg/resvg-js": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "axe-core": "^4.13.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "^7.3.5",
    "zustand": "^5.0.14"
  }
}
