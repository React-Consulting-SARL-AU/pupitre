{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**", "!.agents", "!.impeccable", "!build", "!out"]
  },
  "javascript": {
    "formatter": {
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["src/**/__tests__/**"],
      "linter": {
        "rules": {
          "performance": {
            // An assertion's regex is written where it is read, and runs once.
            "useTopLevelRegex": "off"
          },
          "suspicious": {
            // A file mode is read with a mask: "&" is the only way to check 0600.
            "noBitwiseOperators": "off"
          }
        }
      }
    },
    {
      // node-pty has no named export; `spyOn` needs the module object to watch `fs`.
      "includes": [
        "src/main/terminals.ts",
        "src/main/__tests__/services-secret.test.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    }
  ]
}
