# service.status ne rend que le nom des variables ; la valeur sort sur un événement dédié.
> {"id":1,"cmd":"hello","params":{"app_version":"0.1.0","locale":"en","protocol":2}}
< {"id":1,"ok":true,"result":{"agent_version":"0.0.0-test","protocol":2,"entitlement":"dev","capabilities":["hello","service.status","service.secret"]}}
> {"id":2,"cmd":"service.status","params":{"id":"db.mysql"}}
< {"id":2,"ok":true,"result":{"id":"db.mysql","name":"MySQL 8.4","state":"running","port":3306,"unit":"mysql.service","version":"8.4.3","credentials":{"Mot de passe applicatif":"MYSQL_APP_PASSWORD","Mot de passe root":"MYSQL_ROOT_PASSWORD"}}}
@repeat
> {"id":3,"cmd":"service.secret","params":{"id":"db.mysql","key":"MYSQL_APP_PASSWORD"}}
< {"id":3,"event":"secret","key":"MYSQL_APP_PASSWORD","value":"Tr0p-secret-pour-un-journal"}
< {"id":3,"ok":true,"result":{"key":"MYSQL_APP_PASSWORD"}}
