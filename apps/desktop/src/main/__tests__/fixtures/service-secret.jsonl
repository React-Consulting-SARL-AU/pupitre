# service.status ne rend que le nom des variables, sur la session sans mot de passe ; la valeur sort sur la session privilégiée (service-secret-only.jsonl).
> {"id":1,"cmd":"hello","params":{"app_version":"0.1.0","locale":"en","protocol":3}}
< {"id":1,"ok":true,"result":{"agent_version":"0.0.0-test","protocol":3,"license":"dev","capabilities":["hello","service.status","service.secret"]}}
@repeat
> {"id":2,"cmd":"service.status","params":{"id":"db.mysql"}}
< {"id":2,"ok":true,"result":{"id":"db.mysql","name":"MySQL 8.4","state":"running","port":3306,"unit":"mysql.service","version":"8.4.3","credentials":{"Mot de passe applicatif":"MYSQL_APP_PASSWORD","Mot de passe root":"MYSQL_ROOT_PASSWORD"}}}
