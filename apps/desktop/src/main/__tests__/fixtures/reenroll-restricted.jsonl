# Un serveur enrôlé dont le jeton a été révoqué : il se laisse lire, refuse
# d'agir, et se répare par un ré-enrôlement, sur la session privilégiée
# (reenroll-enroll.jsonl). Le refus n'est pas écrit ici — la directive le rend,
# exactement comme l'agent le rend avant de dispatcher, et le droit que
# l'enrôlement rétablit vaut pour toutes les sessions.
# Modèle : apps/agent/internal/protocol/testdata/restricted.jsonl
@entitlement restricted
> {"id":1,"cmd":"hello","params":{"app_version":"0.1.0","locale":"en","protocol":2}}
< {"id":1,"ok":true,"result":{"agent_version":"0.0.0-test","protocol":2,"entitlement":"restricted","capabilities":["hello","ping","snapshot","status","diag","agent.upgrade","enroll","project.down"]}}
> {"id":2,"cmd":"snapshot"}
< {"id":2,"ok":true,"result":{"machine":{"hostname":"staging","os":"ubuntu","version":"24.04","arch":"arm64","cores":4,"uptime_s":86400,"load":[0.1,0.2,0.3],"ram_total_mb":4096,"ram_used_mb":1200,"swap_mb":0,"disk_total_gb":80,"disk_free_gb":38,"agent_version":"0.0.0-test"},"services":[],"projects":[{"name":"api","dir":"api","path":"/home/dev/projects/api","processes":[{"id":"api","dir":".","path":"/home/dev/projects/api","pkgmgr":"bun","host":"api.test","port":3000,"routes":[],"cmd":"bun dev","state":"online"}],"state":"online"}],"sessions":[],"entitlement":"restricted"}}
> {"id":3,"cmd":"snapshot"}
< {"id":3,"ok":true,"result":{"machine":{"hostname":"staging","os":"ubuntu","version":"24.04","arch":"arm64","cores":4,"uptime_s":86400,"load":[0.1,0.2,0.3],"ram_total_mb":4096,"ram_used_mb":1200,"swap_mb":0,"disk_total_gb":80,"disk_free_gb":38,"agent_version":"0.0.0-test"},"services":[],"projects":[{"name":"api","dir":"api","path":"/home/dev/projects/api","processes":[{"id":"api","dir":".","path":"/home/dev/projects/api","pkgmgr":"bun","host":"api.test","port":3000,"routes":[],"cmd":"bun dev","state":"online"}],"state":"online"}],"sessions":[],"entitlement":"valid"}}
# Ce que le serveur refusait avant l'échange, il l'accepte après : le droit est réparé.
> {"id":4,"cmd":"project.down","params":{"name":"api"}}
< {"id":4,"ok":true,"result":{"state":"stopped"}}
